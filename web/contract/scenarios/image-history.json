		{"call": "ImageRevert", "args": {"image_id": "img_0000000001", "checkpoint": "two layers"}},
		{"call": "ImageRevert", "args": {"image_id": "img_0000000001", "checkpoint": "two layers"}},
		{"call": "ImageUndo", "args": {"image_id": "img_0000000001"}},
