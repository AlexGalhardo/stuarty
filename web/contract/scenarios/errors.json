{
	"name": "errors",
	"actor": "contract",
	"fixtures": {"big": "more bytes than the import ceiling of the errors scenario allows: 0123456789012345678901234567890123456789"},
	"steps": [
		{"call": "ProjectGet", "args": {"project_id": "prj_0000000000"}, "expect_error": {"code": "E_NOT_FOUND"}},
		{"call": "ProjectCreate", "args": {"id": "prj_7k2m9x4q1b", "name": "Errors"}},
		{"call": "ProjectCreate", "args": {"id": "prj_7k2m9x4q1b", "name": "Again"}, "expect_error": {"code": "E_ID_EXISTS"}},
		{"call": "Undo", "args": {"project_id": "prj_7k2m9x4q1b"}, "expect_error": {"code": "E_NOTHING_TO_UNDO"}},
		{"call": "Edit", "args": {"project_id": "prj_7k2m9x4q1b", "base_revision": 0, "operations": [
			{"op": "no.such_op", "args": {}}]}, "expect_error": {"code": "E_UNKNOWN_COMMAND"}},
		{"call": "Edit", "args": {"project_id": "prj_7k2m9x4q1b", "base_revision": 0, "operations": [
			{"op": "track.add", "args": {"kind": "visual", "name": "V", "id": "trk_f6g7h8j9k0"}},
			{"op": "text.add", "args": {"track_id": "trk_f6g7h8j9k0", "start": "1", "duration": "1s", "text": "x"}}]},
			"expect_error": {"code": "E_INVALID_TIME"}},
		{"call": "JobStart", "args": {"project_id": "prj_7k2m9x4q1b", "kind": "export", "wait_ms": 20000}, "expect_error": {"code": "E_LINT_BLOCKING"}},
		{"call": "MediaImport", "args": {"project_id": "prj_7k2m9x4q1b", "files": [{"path": "$big"}], "wait_ms": 20000}, "expect_error": {"code": "E_LIMIT_EXCEEDED"}},
		{"call": "Edit", "args": {"project_id": "prj_7k2m9x4q1b", "base_revision": 0, "operations": [
			{"op": "track.add", "args": {"kind": "visual", "name": "V", "id": "trk_f6g7h8j9k0"}},
			{"op": "text.add", "args": {"track_id": "trk_f6g7h8j9k0", "start": "0s", "duration": "1s", "text": "x", "id": "itm_t1t2t3t4t5"}}]}},
		{"call": "JobStart", "args": {"project_id": "prj_7k2m9x4q1b", "kind": "export"}},
		{"call": "JobStart", "args": {"project_id": "prj_7k2m9x4q1b", "kind": "export"}, "expect_error": {"code": "E_QUEUE_FULL"}}
	]
}
