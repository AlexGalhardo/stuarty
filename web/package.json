{
  "name": "stuarty",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:ssr": "vite build --ssr",
    "build:e2e": "vite build --mode e2e",
    "check:hooks": "bun scripts/check-hooks.ts",
    "typecheck": "tsc --noEmit",
    "codegen:ts": "bun scripts/codegen-ts.mjs",
    "lint": "biome ci resources/js e2e",
    "test": "vitest run",
    "check:thin-client": "bun scripts/check-thin-client.ts",
    "format": "biome format --write resources/js e2e",
    "check:i18n": "node scripts/check-i18n.ts",
    "check:contrast": "bun scripts/check-contrast.ts",
    "e2e": "vite build --mode e2e && playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@inertiajs/react": "3.9.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.68.0",
    "pixi.js": "8.23.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.6",
    "@inertiajs/vite": "3.9.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "json-schema-to-typescript": "16.0.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.1.0"
  }
}
