{
	"title": "Recover from a conflict",
	"steps": [
		{
			"cmd": "project:create --name \"Shared\" --id prj_7k2m9x4q1b"
		},
		{
			"cmd": "edit --project prj_7k2m9x4q1b --ops -",
			"stdin": "[{\"op\":\"track.add\",\"args\":{\"kind\":\"visual\",\"name\":\"Video\",\"id\":\"trk_f6g7h8j9k0\"}}]"
		},
		{
			"cmd": "edit --project prj_7k2m9x4q1b --actor other track.update track_id=trk_f6g7h8j9k0 name=Theirs",
			"note": "another actor changes the track first"
		},
		{
			"cmd": "edit --project prj_7k2m9x4q1b --base 1 track.update track_id=trk_f6g7h8j9k0 name=Mine",
			"exit": 2,
			"note": "a stale --base is a conflict, exit 2; read details.diff"
		},
		{
			"cmd": "project:show prj_7k2m9x4q1b"
		},
		{
			"cmd": "edit --project prj_7k2m9x4q1b --base 2 track.update track_id=trk_f6g7h8j9k0 name=Mine",
			"note": "send again from the new revision"
		}
	]
}
