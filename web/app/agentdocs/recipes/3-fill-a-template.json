{
	"title": "Fill a template",
	"scenario": "template",
	"steps": [
		{
			"cmd": "project:create --name \"Base\" --description \"A short vertical video for tests, with a script, footage and captions for the channel.\" --specific \"Publish one video now\" --measurable \"100 views in a week\" --achievable \"The footage exists\" --relevant \"Grows the channel\" --time-bound \"Done by next Tuesday\" --due 2999-12-31 --id prj_7k2m9x4q1b",
			"hidden": true
		},
		{
			"cmd": "item:add --project prj_7k2m9x4q1b --kind timeline --title \"Base\"",
			"hidden": true
		},
		{
			"cmd": "edit --project prj_7k2m9x4q1b --ops -",
			"hidden": true,
			"stdin": "[{\"op\":\"track.add\",\"args\":{\"kind\":\"visual\",\"name\":\"Text\",\"id\":\"trk_f6g7h8j9k0\"}},\n {\"op\":\"text.add\",\"args\":{\"track_id\":\"trk_f6g7h8j9k0\",\"start\":\"0s\",\"duration\":\"1s\",\"text\":\"Headline\",\"id\":\"itm_t1t2t3t4t5\"}}]"
		},
		{
			"cmd": "edit --project prj_7k2m9x4q1b --base 1 slot.mark item_id=itm_t1t2t3t4t5 name=headline",
			"hidden": true
		},
		{
			"cmd": "template:save --project prj_7k2m9x4q1b --name \"Spring sale\"",
			"note": "headline is a slot"
		},
		{
			"cmd": "template:new <template id> --name \"Spring sale\" --id prj_6t4y2w8j1m --fill -",
			"run": "template:new tpl_0000000001 --name \"Spring sale\" --id prj_6t4y2w8j1m --fill -",
			"stdin": "{\"headline\":{\"text\":\"Spring sale\"}}"
		},
		{
			"cmd": "export --project prj_6t4y2w8j1m"
		}
	]
}
