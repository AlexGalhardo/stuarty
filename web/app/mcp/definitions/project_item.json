{
 "name": "project_item",
 "description": "Project items. add: timeline (its id is timeline_id), text or output (export job_id); move, rename, trash, restore: item_id; brief: read, or write text (empty clears); briefing: questions, or answers {id: text} to write the brief.",
 "inputSchema": {
  "type": "object",
  "properties": {
   "action": {
    "enum": [
     "add",
     "move",
     "rename",
     "trash",
     "restore",
     "brief",
     "briefing"
    ]
   },
   "project_id": {
    "type": "string",
    "pattern": "^prj_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "item_id": {
    "type": "string",
    "pattern": "^pit_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "kind": {
    "enum": [
     "text",
     "timeline",
     "output"
    ]
   },
   "title": {
    "type": "string"
   },
   "position": {
    "type": "integer"
   },
   "text": {
    "type": "string"
   },
   "answers": {
    "type": "object"
   },
   "preset": {
    "type": "string"
   },
   "fps": {
    "type": "string"
   },
   "job_id": {
    "type": "string",
    "pattern": "^job_[0-9a-hjkmnp-tv-z]{10}$"
   }
  },
  "required": [
   "action",
   "project_id"
  ],
  "additionalProperties": false
 },
 "annotations": {
  "title": "Items",
  "readOnlyHint": false,
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false
 },
 "outputSchema": {
  "type": "object",
  "properties": {
   "project_id": {
    "type": "string"
   }
  },
  "required": [
   "project_id"
  ]
 }
}
