{
 "name": "project_item",
 "description": "Project items. add: timeline (id is timeline_id), text or output (export job_id); move, rename, trash, restore: item_id; brief: read, or write text (empty clears); briefing: questions, or answers {id: text}; production_kind short (default), commercial, long. Texts: text lists, reads (item_id) or writes (text; title, text_kind); revisions (revision, until); revert (revision); check: caption (network), script (wpm) or post. update: title=name, text=description, goal.",
 "inputSchema": {
  "type": "object",
  "properties": {
   "action": {
    "enum": [
     "add",
     "move",
     "rename",
     "trash",
     "restore",
     "brief",
     "briefing",
     "text",
     "revisions",
     "revert",
     "check",
     "update"
    ]
   },
   "project_id": {
    "type": "string",
    "pattern": "^prj_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "item_id": {
    "type": "string",
    "pattern": "^pit_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "kind": {
    "enum": [
     "text",
     "timeline",
     "output"
    ]
   },
   "title": {
    "type": "string"
   },
   "position": {
    "type": "integer"
   },
   "text": {
    "type": "string"
   },
   "answers": {
    "type": "object"
   },
   "preset": {
    "type": "string"
   },
   "fps": {
    "type": "string"
   },
   "job_id": {
    "type": "string",
    "pattern": "^job_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "text_kind": {
    "type": "string"
   },
   "revision": {
    "type": "integer"
   },
   "network": {
    "type": "string"
   },
   "wpm": {
    "type": "integer"
   },
   "until": {
    "type": "integer"
   },
   "production_kind": {
    "enum": [
     "short",
     "commercial",
     "long"
    ]
   },
   "goal": {
    "type": "object"
   }
  },
  "required": [
   "action",
   "project_id"
  ],
  "additionalProperties": false
 },
 "annotations": {
  "title": "Items",
  "readOnlyHint": false,
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false
 },
 "outputSchema": {
  "type": "object",
  "properties": {
   "project_id": {
    "type": "string"
   },
   "body": {
    "type": "string",
    "x-untrusted": true
   },
   "texts": {
    "type": "array",
    "x-untrusted": true
   }
  },
  "required": [
   "project_id"
  ]
 }
}
