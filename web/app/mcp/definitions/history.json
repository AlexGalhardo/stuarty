{
 "name": "history",
 "description": "Change log (action=list, newest first, with actor; actor, cursor, limit: list only); undo/redo your own latest step (one per call); revert to a revision or checkpoint as a new step (dry_run previews); diff two revisions; checkpoints, checkpoint, rename_checkpoint, remove_checkpoint name revisions. Undo skips (and reports) others' later changes. domain=image (image_id): undo, redo only.",
 "inputSchema": {
  "type": "object",
  "properties": {
   "domain": {
    "enum": [
     "video",
     "image"
    ],
    "default": "video"
   },
   "image_id": {
    "type": "string",
    "pattern": "^img_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "project_id": {
    "type": "string",
    "pattern": "^prj_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "timeline_id": {
    "type": "string",
    "pattern": "^prj_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "action": {
    "enum": [
     "list",
     "undo",
     "redo",
     "revert",
     "diff",
     "checkpoints",
     "checkpoint",
     "rename_checkpoint",
     "remove_checkpoint"
    ],
    "default": "list"
   },
   "actor": {
    "type": "string"
   },
   "cursor": {
    "type": "string"
   },
   "limit": {
    "type": "integer",
    "minimum": 1,
    "maximum": 100,
    "default": 20
   },
   "revision": {
    "type": "integer",
    "minimum": 1
   },
   "until": {
    "type": "integer",
    "minimum": 1
   },
   "name": {
    "type": "string"
   },
   "new_name": {
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "dry_run": {
    "type": "boolean"
   }
  },
  "additionalProperties": false
 },
 "outputSchema": {
  "type": "object",
  "properties": {
   "revision": {
    "type": "integer"
   },
   "kind": {
    "enum": [
     "undo",
     "redo",
     "revert"
    ]
   },
   "entries": {
    "type": "array",
    "items": {
     "type": "object"
    }
   },
   "skipped": {
    "type": "array",
    "items": {
     "type": "object"
    }
   },
   "next_cursor": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "revision"
  ]
 },
 "annotations": {
  "title": "History, undo and redo",
  "readOnlyHint": false,
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false
 }
}
