{
 "name": "command_help",
 "description": "Discover operations. No arguments: video operations, a line each, then the domains. domain=<name>: its operations; domain=export: presets, codecs. name (e.g. item.split): description, args JSON Schema, example, error codes; read before using a new operation.",
 "inputSchema": {
  "type": "object",
  "properties": {
   "name": {
    "type": "string"
   },
   "domain": {
    "enum": [
     "project",
     "video",
     "image",
     "writing",
     "asset",
     "publish",
     "provider",
     "memory",
     "workspace",
     "export"
    ]
   }
  },
  "additionalProperties": false
 },
 "outputSchema": {
  "type": "object",
  "properties": {
   "commands": {
    "type": "array",
    "items": {
     "type": "object"
    }
   },
   "command": {
    "type": "object"
   },
   "domains": {
    "type": "array",
    "items": {
     "type": "object"
    }
   }
  }
 },
 "annotations": {
  "title": "Operation help",
  "readOnlyHint": true,
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false
 }
}
