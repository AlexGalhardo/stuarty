{
 "name": "command_help",
 "description": "Describe edit operations. Without name: one line each. With name (e.g. item.split): description, args schema, example, error codes. Read it before using an unfamiliar operation. domain=export: presets and codecs.",
 "inputSchema": {
  "type": "object",
  "properties": {
   "name": {
    "type": "string"
   },
   "domain": {
    "enum": [
     "video",
     "image",
     "export"
    ]
   }
  },
  "additionalProperties": false
 },
 "outputSchema": {
  "type": "object",
  "properties": {
   "commands": {
    "type": "array",
    "items": {
     "type": "object"
    }
   },
   "command": {
    "type": "object"
   }
  }
 },
 "annotations": {
  "title": "Operation help",
  "readOnlyHint": true,
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false
 }
}
