{
 "name": "command_help",
 "description": "Discover operations. No arguments: the video operations, one line each, then every domain. domain=<name>: the operations of that domain. name (for example item.split): description, args JSON Schema, example and error codes; read it before using an operation you have not used.",
 "inputSchema": {
  "type": "object",
  "properties": {
   "name": {
    "type": "string"
   },
   "domain": {
    "enum": [
     "project",
     "video",
     "image",
     "writing",
     "asset",
     "publish",
     "provider",
     "memory",
     "workspace"
    ]
   }
  },
  "additionalProperties": false
 },
 "outputSchema": {
  "type": "object",
  "properties": {
   "commands": {
    "type": "array",
    "items": {
     "type": "object"
    }
   },
   "command": {
    "type": "object"
   },
   "domains": {
    "type": "array",
    "items": {
     "type": "object"
    }
   }
  }
 },
 "annotations": {
  "title": "Operation help",
  "readOnlyHint": true,
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false
 }
}
