{
 "name": "command_help",
 "description": "Describe edit operations. Without name: one line per operation. With name (for example item.split): returns its description, args JSON Schema, an example and error codes.",
 "inputSchema": {
  "type": "object",
  "properties": {
   "name": {
    "type": "string"
   },
   "domain": {
    "enum": [
     "video",
     "image"
    ]
   }
  },
  "additionalProperties": false
 },
 "outputSchema": {
  "type": "object",
  "properties": {
   "commands": {
    "type": "array",
    "items": {
     "type": "object"
    }
   },
   "command": {
    "type": "object"
   }
  }
 },
 "annotations": {
  "title": "Operation help",
  "readOnlyHint": true,
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false
 }
}
