{
 "name": "job_start",
 "description": "Start long work; fields go in args. export: schema props (at: png frame); export_batch: items; transcribe {asset_id, language?, model?}; publish.upload {connection_id, export (job_id), title, made_for_kids, thumbnail?, description?, tags?, visibility?, ai_disclosure?}; generations add connection_id, model: text.generate {prompt}; image.generate {prompt, size?, count?}; voice.generate {text, voice, format?}; image.edit {image_id, operation, layer_id?, prompt?}; text.draft {item_id, instruction}; video.generate {prompt, seconds?, aspect?, first_frame?}. A person approves; poll job_get.",
 "inputSchema": {
  "type": "object",
  "properties": {
   "project_id": {
    "type": "string",
    "pattern": "^prj_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "timeline_id": {
    "type": "string",
    "pattern": "^prj_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "kind": {
    "enum": [
     "export",
     "export_batch",
     "transcribe",
     "text.generate",
     "image.generate",
     "voice.generate",
     "text.draft",
     "image.edit",
     "video.generate",
     "publish.upload"
    ]
   },
   "args": {
    "type": "object",
    "properties": {
     "start": {
      "type": "string"
     },
     "end": {
      "type": "string"
     },
     "format": {
      "enum": [
       "mp4",
       "gif",
       "wav",
       "aac",
       "png"
      ]
     },
     "at": {
      "type": "string"
     },
     "preset": {
      "type": "string"
     },
     "codec": {
      "enum": [
       "h264",
       "hevc",
       "av1"
      ]
     },
     "items": {
      "type": "array"
     }
    }
   },
   "wait_ms": {
    "type": "integer",
    "minimum": 0,
    "maximum": 25000,
    "default": 0
   }
  },
  "required": [
   "project_id",
   "kind"
  ],
  "additionalProperties": false
 },
 "outputSchema": {
  "type": "object",
  "properties": {
   "job_id": {
    "type": "string"
   },
   "kind": {
    "type": "string"
   },
   "state": {
    "type": "string"
   },
   "progress": {
    "type": "number"
   }
  },
  "required": [
   "job_id",
   "kind",
   "state",
   "progress"
  ]
 },
 "annotations": {
  "title": "Start job",
  "readOnlyHint": false,
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false
 }
}
