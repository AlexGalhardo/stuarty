{
 "name": "job_start",
 "description": "Start long work; args by kind. export renders a workspace file: {start?, end?, format?, at? (the png frame), preset?, codec?}; export_batch: items (export args) in turn; transcribe: {asset_id, language?, model?}; text.generate: {connection_id, model, prompt}; image.generate: {connection_id, model, prompt, size?, count?}; voice.generate: {connection_id, model, text, voice, format?}; image.edit: {image_id, operation, connection_id, model, layer_id?, prompt?}; text.draft: {item_id, connection_id, model, instruction}; a person approves. Poll job_get.",
 "inputSchema": {
  "type": "object",
  "properties": {
   "project_id": {
    "type": "string",
    "pattern": "^prj_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "timeline_id": {
    "type": "string",
    "pattern": "^prj_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "kind": {
    "enum": [
     "export",
     "export_batch",
     "transcribe",
     "text.generate",
     "image.generate",
     "voice.generate",
     "text.draft",
     "image.edit"
    ]
   },
   "args": {
    "type": "object",
    "properties": {
     "start": {
      "type": "string"
     },
     "end": {
      "type": "string"
     },
     "format": {
      "enum": [
       "mp4",
       "gif",
       "wav",
       "aac",
       "png"
      ]
     },
     "at": {
      "type": "string"
     },
     "preset": {
      "type": "string"
     },
     "codec": {
      "enum": [
       "h264",
       "hevc",
       "av1"
      ]
     },
     "items": {
      "type": "array"
     }
    }
   },
   "wait_ms": {
    "type": "integer",
    "minimum": 0,
    "maximum": 25000,
    "default": 0
   }
  },
  "required": [
   "project_id",
   "kind"
  ],
  "additionalProperties": false
 },
 "outputSchema": {
  "type": "object",
  "properties": {
   "job_id": {
    "type": "string"
   },
   "kind": {
    "type": "string"
   },
   "state": {
    "type": "string"
   },
   "progress": {
    "type": "number"
   }
  },
  "required": [
   "job_id",
   "kind",
   "state",
   "progress"
  ]
 },
 "annotations": {
  "title": "Start job",
  "readOnlyHint": false,
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false
 }
}
