{
 "name": "job_start",
 "description": "Start long work. kind=export renders the project to an MP4 in the workspace: args {start?, end?}. kind=transcribe transcribes an asset's speech: args {asset_id, language?}. Export is refused while lint has errors. Waits up to wait_ms, then returns the job; poll with job_get.",
 "inputSchema": {
  "type": "object",
  "properties": {
   "project_id": {
    "type": "string",
    "pattern": "^prj_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "kind": {
    "enum": [
     "export",
     "transcribe"
    ]
   },
   "args": {
    "type": "object"
   },
   "wait_ms": {
    "type": "integer",
    "minimum": 0,
    "maximum": 25000,
    "default": 0
   }
  },
  "required": [
   "project_id",
   "kind"
  ],
  "additionalProperties": false
 },
 "outputSchema": {
  "type": "object",
  "properties": {
   "job_id": {
    "type": "string"
   },
   "kind": {
    "type": "string"
   },
   "state": {
    "enum": [
     "queued",
     "running",
     "succeeded",
     "failed",
     "cancelled"
    ]
   },
   "progress": {
    "type": "number"
   },
   "message": {
    "type": "string"
   },
   "result": {
    "type": "object"
   },
   "error": {
    "type": "object"
   }
  },
  "required": [
   "job_id",
   "kind",
   "state",
   "progress"
  ]
 },
 "annotations": {
  "title": "Start job",
  "readOnlyHint": false,
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false
 }
}
