{
 "name": "job_start",
 "description": "Start long work. kind=export renders to a workspace file: args {start?, end?, format?, at?}, format mp4 (default), gif, wav, aac or png (the frame at `at`). kind=transcribe makes a transcript: args {asset_id, language?, model?}. Lint errors block export. Returns after wait_ms at most; poll job_get.",
 "inputSchema": {
  "type": "object",
  "properties": {
   "project_id": {
    "type": "string",
    "pattern": "^prj_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "timeline_id": {
    "type": "string",
    "pattern": "^prj_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "kind": {
    "enum": [
     "export",
     "transcribe"
    ]
   },
   "args": {
    "type": "object",
    "properties": {
     "start": {
      "type": "string"
     },
     "end": {
      "type": "string"
     },
     "format": {
      "enum": [
       "mp4",
       "gif",
       "wav",
       "aac",
       "png"
      ]
     },
     "at": {
      "type": "string"
     }
    }
   },
   "wait_ms": {
    "type": "integer",
    "minimum": 0,
    "maximum": 25000,
    "default": 0
   }
  },
  "required": [
   "project_id",
   "kind"
  ],
  "additionalProperties": false
 },
 "outputSchema": {
  "type": "object",
  "properties": {
   "job_id": {
    "type": "string"
   },
   "kind": {
    "type": "string"
   },
   "state": {
    "enum": [
     "queued",
     "waiting_approval",
     "running",
     "succeeded",
     "failed",
     "cancelled"
    ]
   },
   "progress": {
    "type": "number"
   },
   "message": {
    "type": "string"
   },
   "result": {
    "type": "object"
   },
   "error": {
    "type": "object"
   }
  },
  "required": [
   "job_id",
   "kind",
   "state",
   "progress"
  ]
 },
 "annotations": {
  "title": "Start job",
  "readOnlyHint": false,
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false
 }
}
