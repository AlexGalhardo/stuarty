{
 "name": "project_list",
 "description": "List projects newest first (standalone=true for standalone video edits).",
 "inputSchema": {
  "type": "object",
  "properties": {
   "state": {
    "enum": [
     "active",
     "trashed",
     "all"
    ],
    "default": "active"
   },
   "standalone": {
    "type": "boolean"
   },
   "cursor": {
    "type": "string"
   },
   "limit": {
    "type": "integer",
    "minimum": 1,
    "maximum": 100,
    "default": 20
   }
  },
  "additionalProperties": false
 },
 "outputSchema": {
  "type": "object",
  "properties": {
   "projects": {
    "type": "array",
    "items": {
     "type": "object",
     "properties": {
      "name": {
       "type": "string",
       "x-untrusted": true
      }
     }
    }
   },
   "next_cursor": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "projects",
   "next_cursor"
  ]
 },
 "annotations": {
  "title": "List projects",
  "readOnlyHint": true,
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false
 }
}
