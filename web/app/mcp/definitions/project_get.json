{
 "name": "project_get",
 "description": "A project as text: revision, settings, tracks top to bottom (top draws over the rest), items per track, times in seconds and frames. Use first, for edit's revision. detail=concise: a line per item; full: every non-default field; document: whole JSON, unpaged, unbounded (many tokens if long: prefer concise/full); overview: whole project (brief, items, workflow, what is missing). Long: next_cursor.",
 "inputSchema": {
  "type": "object",
  "properties": {
   "project_id": {
    "type": "string",
    "pattern": "^prj_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "timeline_id": {
    "type": "string",
    "pattern": "^prj_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "detail": {
    "enum": [
     "concise",
     "full",
     "document",
     "overview"
    ],
    "default": "concise"
   },
   "cursor": {
    "type": "string"
   },
   "limit": {
    "type": "integer",
    "minimum": 1,
    "maximum": 500
   }
  },
  "required": [
   "project_id"
  ],
  "additionalProperties": false
 },
 "outputSchema": {
  "type": "object",
  "properties": {
   "project_id": {
    "type": "string"
   },
   "name": {
    "type": "string",
    "x-untrusted": true
   },
   "revision": {
    "type": "integer"
   },
   "duration_frames": {
    "type": "integer"
   },
   "counts": {
    "type": "object"
   },
   "next_cursor": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "project_id"
  ]
 },
 "annotations": {
  "title": "Read project",
  "readOnlyHint": true,
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false
 }
}
