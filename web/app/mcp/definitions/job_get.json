{
 "name": "job_get",
 "description": "A job's state, progress, result (job_id). wait_ms: wait up to that many ms for succeeded, failed or cancelled. A succeeded export is verified; its result has the file path. project_id instead of job_id lists its queued, running and recent jobs. approval_id reads a request (job.approval_id), approvals (state) lists them; read only, a person decides.",
 "inputSchema": {
  "type": "object",
  "properties": {
   "job_id": {
    "type": "string",
    "pattern": "^job_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "project_id": {
    "type": "string",
    "pattern": "^prj_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "approval_id": {
    "type": "string",
    "pattern": "^apr_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "approvals": {
    "enum": [
     "pending",
     "approved",
     "rejected",
     "expired",
     "all"
    ]
   },
   "state": {
    "enum": [
     "queued",
     "running",
     "succeeded",
     "failed",
     "cancelled",
     "active",
     "all"
    ]
   },
   "wait_ms": {
    "type": "integer",
    "minimum": 0,
    "maximum": 25000,
    "default": 0
   }
  },
  "additionalProperties": false
 },
 "outputSchema": {
  "type": "object",
  "properties": {
   "job_id": {
    "type": "string"
   },
   "kind": {
    "type": "string"
   },
   "state": {
    "type": "string"
   },
   "progress": {
    "type": "number"
   },
   "message": {
    "type": "string"
   },
   "result": {
    "type": "object"
   },
   "error": {
    "type": "object"
   },
   "jobs": {
    "type": "array",
    "items": {
     "type": "object"
    }
   }
  }
 },
 "annotations": {
  "title": "Get job",
  "readOnlyHint": true,
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false
 }
}
