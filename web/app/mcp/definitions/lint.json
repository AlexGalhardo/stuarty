{
 "name": "lint",
 "description": "Check a project for problems and get them as text: code, severity, item, message, hint. Errors block export. Run it after edits, before export. Runs every rule, unlike the lint block of an edit result (lint_scope fast). Rules include gaps, missing media, text outside the safe area, audio clipping, unfilled slots.",
 "inputSchema": {
  "type": "object",
  "properties": {
   "project_id": {
    "type": "string",
    "pattern": "^prj_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "severity": {
    "enum": [
     "error",
     "warning"
    ],
    "default": "warning"
   },
   "cursor": {
    "type": "string"
   },
   "limit": {
    "type": "integer",
    "minimum": 1,
    "maximum": 100,
    "default": 25
   }
  },
  "required": [
   "project_id"
  ],
  "additionalProperties": false
 },
 "outputSchema": {
  "type": "object",
  "properties": {
   "revision": {
    "type": "integer"
   },
   "errors": {
    "type": "integer"
   },
   "warnings": {
    "type": "integer"
   },
   "findings": {
    "type": "array",
    "items": {
     "type": "object"
    }
   },
   "next_cursor": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "revision",
   "errors",
   "warnings",
   "findings"
  ]
 },
 "annotations": {
  "title": "Lint project",
  "readOnlyHint": true,
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false
 }
}
