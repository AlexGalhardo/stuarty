{
 "name": "media_import",
 "description": "Import local files into a project. paths: absolute paths of video, audio or image files, or sha256:... hashes of library files to reuse (no copy). Waits up to wait_ms; use an asset in edit only when ready. origin={kind: imported|generated|fetched_by_agent|rendered_externally, source,provider,model,prompt,rights_note}: generated needs provider and model; fetched_by_agent needs source and rights_note. info={tags,reusable,description}. hash without paths: info edits that library entry.",
 "inputSchema": {
  "type": "object",
  "properties": {
   "project_id": {
    "type": "string",
    "pattern": "^prj_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "timeline_id": {
    "type": "string",
    "pattern": "^prj_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "paths": {
    "type": "array",
    "maxItems": 50,
    "items": {
     "type": "string"
    }
   },
   "asset_ids": {
    "type": "array",
    "maxItems": 50,
    "items": {
     "type": "string",
     "pattern": "^ast_[0-9a-hjkmnp-tv-z]{10}$"
    }
   },
   "wait_ms": {
    "type": "integer",
    "minimum": 0,
    "maximum": 25000,
    "default": 10000
   },
   "hash": {
    "type": "string"
   },
   "origin": {
    "type": "object"
   },
   "info": {
    "type": "object"
   }
  },
  "additionalProperties": false
 },
 "outputSchema": {
  "type": "object",
  "properties": {
   "revision": {
    "type": "integer"
   },
   "assets": {
    "type": "array",
    "items": {
     "type": "object",
     "properties": {
      "asset_id": {
       "type": "string"
      },
      "name": {
       "type": "string",
       "x-untrusted": true
      },
      "state": {
       "enum": [
        "pending",
        "ingesting",
        "ready",
        "failed"
       ]
      },
      "job_id": {
       "type": "string"
      },
      "deduplicated": {
       "type": "boolean"
      },
      "error": {
       "type": "object"
      }
     }
    }
   },
   "failed": {
    "type": "integer"
   }
  }
 },
 "annotations": {
  "title": "Import media",
  "readOnlyHint": false,
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false
 }
}
