{
 "name": "view",
 "description": "See the result. mode=frame returns one image of the timeline at time at; mode=sheet returns a grid of frames, each with its time printed (count evenly spaced between from and until, or explicit times). Costs image tokens: read project_get and lint first. frame needs at; sheet takes times, or from, to and count (not both). mode=audio measures the sound, no image: loudness, true peak and noise floor before and after the audio processors, of item_id or of from to until.",
 "inputSchema": {
  "type": "object",
  "properties": {
   "project_id": {
    "type": "string",
    "pattern": "^prj_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "timeline_id": {
    "type": "string",
    "pattern": "^prj_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "mode": {
    "enum": [
     "frame",
     "sheet",
     "audio"
    ],
    "default": "frame"
   },
   "item_id": {
    "type": "string",
    "pattern": "^itm_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "at": {
    "type": "string",
    "description": "Time: 12.5s or 375f. Required in mode frame."
   },
   "times": {
    "type": "array",
    "minItems": 2,
    "maxItems": 16,
    "items": {
     "type": "string"
    }
   },
   "from": {
    "type": "string"
   },
   "until": {
    "type": "string"
   },
   "count": {
    "type": "integer",
    "minimum": 2,
    "maximum": 16,
    "default": 9
   },
   "max_tokens": {
    "type": "integer",
    "minimum": 100,
    "maximum": 1568
   }
  },
  "required": [
   "project_id"
  ],
  "additionalProperties": false
 },
 "outputSchema": {
  "type": "object",
  "properties": {
   "revision": {
    "type": "integer"
   },
   "width": {
    "type": "integer"
   },
   "height": {
    "type": "integer"
   },
   "image_tokens": {
    "type": "integer"
   },
   "cells": {
    "type": "array",
    "items": {
     "type": "object"
    }
   },
   "path": {
    "type": "string"
   }
  },
  "required": [
   "revision"
  ]
 },
 "annotations": {
  "title": "View frame, sheet or sound",
  "readOnlyHint": true,
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false
 }
}
