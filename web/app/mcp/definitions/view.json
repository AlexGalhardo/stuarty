{
 "name": "view",
 "description": "See the result. mode=frame: one image at time at; sheet: a grid of frames with their times (count frames from..until, or times); motion: what an external render of from..until must fit (size, rate, safe area, brand kit, captions, frames). Images cost tokens: read project_get and lint first.",
 "inputSchema": {
  "type": "object",
  "properties": {
   "project_id": {
    "type": "string",
    "pattern": "^prj_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "timeline_id": {
    "type": "string",
    "pattern": "^prj_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "mode": {
    "enum": [
     "frame",
     "sheet",
     "motion"
    ],
    "default": "frame"
   },
   "at": {
    "type": "string",
    "description": "Time: 12.5s or 375f. Required in mode frame."
   },
   "times": {
    "type": "array",
    "minItems": 2,
    "maxItems": 16,
    "items": {
     "type": "string"
    }
   },
   "from": {
    "type": "string"
   },
   "until": {
    "type": "string"
   },
   "count": {
    "type": "integer",
    "minimum": 2,
    "maximum": 16,
    "default": 9
   },
   "max_tokens": {
    "type": "integer",
    "minimum": 100,
    "maximum": 1568
   }
  },
  "required": [
   "project_id"
  ],
  "additionalProperties": false
 },
 "outputSchema": {
  "type": "object",
  "properties": {
   "revision": {
    "type": "integer"
   },
   "width": {
    "type": "integer"
   },
   "height": {
    "type": "integer"
   },
   "image_tokens": {
    "type": "integer"
   },
   "cells": {
    "type": "array",
    "items": {
     "type": "object"
    }
   },
   "path": {
    "type": "string"
   }
  },
  "required": [
   "revision",
   "width",
   "height",
   "image_tokens"
  ]
 },
 "annotations": {
  "title": "View frame or sheet",
  "readOnlyHint": true,
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false
 }
}
