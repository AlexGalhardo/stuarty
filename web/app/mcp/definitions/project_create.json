{
 "name": "project_create",
 "description": "An empty project (no tracks; add with edit); returns its id, revision 0. preset is the frame size: 9:16 is 1080x1920 (default), 1:1, 16:9, 4:5. from (a project id) copies that project.",
 "inputSchema": {
  "type": "object",
  "properties": {
   "name": {
    "type": "string",
    "minLength": 1,
    "maxLength": 120
   },
   "preset": {
    "enum": [
     "9:16",
     "1:1",
     "16:9",
     "4:5"
    ],
    "default": "9:16"
   },
   "fps": {
    "type": [
     "string",
     "integer"
    ],
    "pattern": "^[0-9]+(/1001)?$",
    "minimum": 1,
    "default": "30"
   },
   "id": {
    "type": "string",
    "pattern": "^prj_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "from": {
    "type": "string"
   }
  },
  "required": [],
  "additionalProperties": false
 },
 "outputSchema": {
  "type": "object",
  "properties": {
   "project_id": {
    "type": "string"
   },
   "name": {
    "type": "string",
    "x-untrusted": true
   },
   "revision": {
    "type": "integer"
   },
   "width": {
    "type": "integer"
   },
   "height": {
    "type": "integer"
   },
   "fps": {
    "type": "string"
   }
  },
  "required": [
   "project_id",
   "revision"
  ]
 },
 "annotations": {
  "title": "Create project",
  "readOnlyHint": false,
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false
 }
}
