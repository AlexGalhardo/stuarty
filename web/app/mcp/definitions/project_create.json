{
 "name": "project_create",
 "description": "Create project (name 4-32, description 64-1024, SMART goal 16-280 + due YYYY-MM-DD). from copies one. standalone=true opens a standalone video (optional path/asset_hash/preset/fps).",
 "inputSchema": {
  "type": "object",
  "properties": {
   "name": {
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "goal": {
    "type": "object"
   },
   "kind": {
    "enum": [
     "text",
     "video",
     "image"
    ]
   },
   "standalone": {
    "type": "boolean"
   },
   "path": {
    "type": "string"
   },
   "asset_hash": {
    "type": "string"
   },
   "preset": {},
   "fps": {},
   "id": {
    "type": "string",
    "pattern": "^prj_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "from": {
    "type": "string"
   }
  },
  "required": [],
  "additionalProperties": false
 },
 "outputSchema": {
  "type": "object",
  "properties": {
   "project_id": {
    "type": "string"
   },
   "name": {
    "type": "string",
    "x-untrusted": true
   },
   "revision": {
    "type": "integer"
   }
  },
  "required": [
   "project_id",
   "revision"
  ]
 },
 "annotations": {
  "title": "Create project",
  "readOnlyHint": false,
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false
 }
}
