{
 "name": "edit",
 "description": "Change a project (project_id) or image (domain=image, image_id). Atomic batch, one undo step. base_revision: last revision read. Times need a unit. Operation names, args: command_help. dry_run: check only. idempotency_key: safe retries.",
 "inputSchema": {
  "type": "object",
  "properties": {
   "domain": {
    "enum": [
     "video",
     "image"
    ],
    "default": "video"
   },
   "project_id": {
    "type": "string",
    "pattern": "^prj_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "timeline_id": {
    "type": "string",
    "pattern": "^prj_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "image_id": {
    "type": "string",
    "pattern": "^img_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "base_revision": {
    "type": "integer",
    "minimum": 0
   },
   "operations": {
    "type": "array",
    "minItems": 1,
    "maxItems": 200,
    "items": {
     "type": "object",
     "properties": {
      "op": {
       "type": "string"
      },
      "args": {
       "type": "object"
      }
     },
     "required": [
      "op",
      "args"
     ],
     "additionalProperties": false
    }
   },
   "idempotency_key": {
    "type": "string",
    "pattern": "^[A-Za-z0-9._~-]{8,64}$"
   },
   "dry_run": {
    "type": "boolean",
    "default": false
   }
  },
  "required": [
   "base_revision",
   "operations"
  ],
  "additionalProperties": false
 },
 "outputSchema": {
  "type": "object",
  "properties": {
   "revision": {
    "type": "integer"
   },
   "applied": {
    "type": "boolean"
   },
   "replayed": {
    "type": "boolean"
   },
   "created": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "effective": {
    "type": "array",
    "items": {
     "type": "object"
    }
   },
   "diff": {
    "type": "array",
    "items": {
     "type": "object"
    },
    "x-untrusted": true
   },
   "findings": {
    "type": "array",
    "items": {
     "type": "object"
    }
   },
   "description": {
    "type": "string"
   }
  },
  "required": [
   "revision",
   "applied"
  ]
 },
 "annotations": {
  "title": "Edit project",
  "readOnlyHint": false,
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false
 }
}
