{
 "name": "edit",
 "description": "Change a project. Send a batch of operations; it is applied all or nothing as one undo step. base_revision is the revision you read last. Times are strings with a unit. Use command_help for an operation's arguments. Returns the new revision, a diff of what changed and any new lint findings. dry_run=true checks the batch without saving it. idempotency_key makes a retry safe.",
 "inputSchema": {
  "type": "object",
  "properties": {
   "project_id": {
    "type": "string",
    "pattern": "^prj_[0-9a-hjkmnp-tv-z]{10}$"
   },
   "base_revision": {
    "type": "integer",
    "minimum": 0
   },
   "operations": {
    "type": "array",
    "minItems": 1,
    "maxItems": 200,
    "items": {
     "type": "object",
     "properties": {
      "op": {
       "enum": [
        "project.rename",
        "settings.set",
        "settings.set_fps",
        "asset.remove",
        "track.add",
        "track.update",
        "track.move",
        "track.remove",
        "track.set_caption_style",
        "item.move",
        "item.trim",
        "item.split",
        "item.delete",
        "item.duplicate",
        "item.rename",
        "item.set_transform",
        "item.set_transition",
        "item.set_audio",
        "item.crossfade",
        "timeline.close_gap",
        "clip.add",
        "audio.add",
        "audio.duck",
        "audio.mark_beats",
        "clip.set_framing",
        "clip.set_speed",
        "clip.set_color",
        "clip.set_blur",
        "clip.set_chroma_key",
        "marker.add",
        "marker.set",
        "marker.remove",
        "clip.set_filter",
        "clip.remove_silences",
        "text.add",
        "text.set",
        "text.apply_preset",
        "shape.add",
        "shape.set",
        "caption.add",
        "caption.set_words",
        "caption.edit_word",
        "caption.split",
        "caption.merge",
        "caption.set_breaks",
        "caption.set_style",
        "caption.from_transcript",
        "caption.retime_from_clip",
        "keyframe.set",
        "keyframe.remove",
        "keyframe.clear",
        "slot.mark",
        "slot.unmark",
        "slot.fill",
        "template.set_info",
        "font.add",
        "font.remove"
       ]
      },
      "args": {
       "type": "object"
      }
     },
     "required": [
      "op",
      "args"
     ],
     "additionalProperties": false
    }
   },
   "idempotency_key": {
    "type": "string",
    "pattern": "^[A-Za-z0-9._~-]{8,64}$"
   },
   "dry_run": {
    "type": "boolean",
    "default": false
   }
  },
  "required": [
   "project_id",
   "base_revision",
   "operations"
  ],
  "additionalProperties": false
 },
 "outputSchema": {
  "type": "object",
  "properties": {
   "revision": {
    "type": "integer"
   },
   "applied": {
    "type": "boolean"
   },
   "replayed": {
    "type": "boolean"
   },
   "created": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "effective": {
    "type": "array",
    "items": {
     "type": "object"
    }
   },
   "diff": {
    "type": "array",
    "items": {
     "type": "object"
    },
    "x-untrusted": true
   },
   "findings": {
    "type": "array",
    "items": {
     "type": "object"
    }
   },
   "description": {
    "type": "string"
   }
  },
  "required": [
   "revision",
   "applied"
  ]
 },
 "annotations": {
  "title": "Edit project",
  "readOnlyHint": false,
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false
 }
}
