# The variables of deploy/compose.yml. deploy/install.sh writes the real
# deploy/.env (mode 0600) from the answers you give; this file shows every
# variable. There is no secret here: the keys and the first password are files
# in deploy/secrets/ (never committed, never in a backup).

# The domain people type. Its DNS A/AAAA record must point to this server.
STUARTY_DOMAIN=stuarty.example.com

# The e-mail of the first administrator, and of the account Caddy registers
# with the certificate authority (the only outbound request the package makes).
STUARTY_ADMIN_EMAIL=you@example.com
STUARTY_ACME_EMAIL=you@example.com

# The version of the checked out tag, without the v. The image is built on this
# host and tagged stuarty:<version>.
STUARTY_VERSION=0.30.0

# Empty for a public domain. `tls internal` makes Caddy sign with its own
# authority: for a test on a local machine only.
STUARTY_TLS_DIRECTIVE=

# The internal network and the fixed address of Caddy on it. Change them only
# when 172.31.88.0/24 collides with another network of the host. The server
# trusts X-Forwarded-Proto only from the Caddy address.
STUARTY_SUBNET=172.31.88.0/24
STUARTY_CADDY_IP=172.31.88.2

# The largest request body Caddy accepts: the same as STUARTY_MAX_IMPORT_BYTES, 8 GiB. Write GiB, not
# GB: for Caddy 8GB is 8,000,000,000 bytes, less than what the application accepts.
STUARTY_MAX_BODY=8GiB
