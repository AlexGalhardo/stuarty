# Caddy in front of Stuarty (SDD-009 section 21). The values come from the
# environment of the caddy service (deploy/compose.yml, deploy/.env).
{
	# The one address Caddy tells the certificate authority: the account e-mail.
	email {$STUARTY_ACME_EMAIL}
}

{$STUARTY_DOMAIN} {
	# Empty for a public domain (automatic certificates). `tls internal` for a
	# name that is not public, such as a test on a local machine.
	{$STUARTY_TLS_DIRECTIVE}

	encode zstd gzip

	# Large uploads: the application limits an import (STUARTY_MAX_IMPORT_BYTES,
	# 8 GiB by default); the proxy accepts the same.
	request_body {
		max_size {$STUARTY_MAX_BODY}
	}

	reverse_proxy stuarty:7878 {
		# The event stream (SSE) must reach the browser at once, never buffered.
		flush_interval -1
		# Caddy sends X-Forwarded-Proto, X-Forwarded-For and the original Host by
		# default; the application trusts them from this container only (TRUSTED_PROXIES).
	}
}
