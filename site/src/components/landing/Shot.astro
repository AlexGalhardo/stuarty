---
// A real screenshot of the product, AVIF with a WebP fallback, at 960 and 1600 px.
import type { Shot as ShotData } from "@/lib/landing-pages";
import { withBase } from "@/lib/site";

interface Props {
	shot: ShotData;
	sizes?: string;
	eager?: boolean;
	class?: string;
}

const { shot, sizes = "(min-width: 72rem) 72rem, 100vw", eager = false, class: className } = Astro.props;
const src = (w: number, ext: string) => withBase(`${shot.src}${w === 1600 ? "" : "-960"}.${ext}`);
---

<picture class={className}>
	<source type="image/avif" srcset={`${src(960, "avif")} 960w, ${src(1600, "avif")} 1600w`} sizes={sizes} />
	<img
		src={src(1600, "webp")}
		srcset={`${src(960, "webp")} 960w, ${src(1600, "webp")} 1600w`}
		sizes={sizes}
		alt={shot.alt}
		width={shot.width}
		height={shot.height}
		loading={eager ? "eager" : "lazy"}
		fetchpriority={eager ? "high" : "auto"}
		decoding="async"
	/>
</picture>
