---
// The actions of the landing: Getting Started, the two Docker guides and a download button per system, with the
// latest release read at build time (lib/releases.ts). The backups show the beta notice above the downloads; the
// home shows them in the second row of its navbar (compact), where narrow windows use the short labels.
import { latestRelease, type Os } from "@/lib/releases";
import { withBase } from "@/lib/site";

interface Props {
	/** Distinguishes the ids of each copy on a page. */
	idPrefix: string;
	align?: "start" | "center";
	/** Shows the beta notice above the downloads. */
	beta?: boolean;
	/** The small buttons of the home navbar row. */
	compact?: boolean;
	class?: string;
}

const { idPrefix, align = "start", beta = true, compact = false, class: className } = Astro.props;
const release = await latestRelease();
const version = `v${release.version}`;
const SHORT: Record<Os, string> = { windows: "Windows", macos: "macOS", linux: "Linux" };

// Simple single-colour marks; the text of each button names the system.
const icons: Record<Os, string> = {
	windows: "M3 5.5 10.5 4.4v7.2H3zM11.5 4.3 21 3v8.6h-9.5zM3 12.4h7.5v7.2L3 18.5zM11.5 12.4H21V21l-9.5-1.3z",
	macos:
		"M16.4 12.6c0-2.4 2-3.5 2.1-3.6-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9-.8 0-1.9-.9-3.2-.8-1.6 0-3.1 1-4 2.4-1.7 3-.4 7.3 1.2 9.7.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8 1.5 0 1.9.8 3.2.8 1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8-.1 0-2.5-1-2.5-3.9zM14 5.5c.7-.8 1.1-1.9 1-3-1 0-2.1.7-2.8 1.5-.6.7-1.2 1.8-1 2.9 1 .1 2.1-.6 2.8-1.4z",
	linux:
		"M12 2c-2.2 0-3.6 1.9-3.6 4.4 0 1.3.3 2.3-.4 3.6-.9 1.6-2.9 3.9-2.9 6.6 0 .9.3 1.7.8 2.3-.6.4-1.9.8-1.9 1.7 0 1 1.5 1.1 3.1 1.2 1.2 0 2-.5 2.6-.9.4.1.8.1 1.3.1s.9 0 1.3-.1c.6.4 1.4.9 2.6.9 1.6-.1 3.1-.2 3.1-1.2 0-.9-1.3-1.3-1.9-1.7.5-.6.8-1.4.8-2.3 0-2.7-2-5-2.9-6.6-.7-1.3-.4-2.3-.4-3.6C15.6 3.9 14.2 2 12 2zm-1.4 3.6c.4 0 .7.5.7 1.1s-.3 1.1-.7 1.1-.7-.5-.7-1.1.3-1.1.7-1.1zm2.8 0c.4 0 .7.5.7 1.1s-.3 1.1-.7 1.1-.7-.5-.7-1.1.3-1.1.7-1.1zM12 8.6c.8 0 1.8.5 1.8.9s-1 .9-1.8.9-1.8-.5-1.8-.9 1-.9 1.8-.9zm0 3.4c1.9 0 3.2 2 3.2 4.3S13.9 20 12 20s-3.2-1.4-3.2-3.7S10.1 12 12 12z",
};
// Two stacked server units with their lights cut out: a generic server, no trademark.
const serverIcon =
	"M3 4.5A1.5 1.5 0 0 1 4.5 3h15A1.5 1.5 0 0 1 21 4.5v5a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 9.5zM3 14.5A1.5 1.5 0 0 1 4.5 13h15a1.5 1.5 0 0 1 1.5 1.5v5a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 19.5zM6 6.25h1.5v1.5H6zM9 6.25h1.5v1.5H9zM6 16.25h1.5v1.5H6zM9 16.25h1.5v1.5H9z";
// A shipping container with its ribs cut out: the Docker guide for your own machine, no trademark.
const containerIcon =
	"M3 6.5A1.5 1.5 0 0 1 4.5 5h15A1.5 1.5 0 0 1 21 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5zM6 8h1.5v8H6zM9.5 8H11v8H9.5zM13 8h1.5v8H13zM16.5 8H18v8h-1.5z";
// An open book with lines of text cut out of its pages, filled like the marks of the systems.
const docsIcon =
	"M2 5c3.5-.6 6.6 0 9 1.6V20c-2.4-1.5-5.5-2.1-9-1.5zM13 6.6C15.4 5 18.5 4.4 22 5v13.5c-3.5-.6-6.6 0-9 1.5zM4 8.4c1.9-.2 3.6.1 5 .9v1.1c-1.4-.8-3.1-1.1-5-.9zM4 11.6c1.9-.2 3.6.1 5 .9v1.1c-1.4-.8-3.1-1.1-5-.9zM15 9.3c1.4-.8 3.1-1.1 5-.9v1.1c-1.9-.2-3.6.1-5 .9zM15 12.5c1.4-.8 3.1-1.1 5-.9v1.1c-1.9-.2-3.6.1-5 .9z";
const guides = [
	{ kind: "docs", href: "/docs/introduction/", label: "Getting Started", short: "Get Started", sub: "Read Documentation", icon: docsIcon },
	{ kind: "local", href: "/docs/self-hosting/docker/", label: "Setup Docker Local", short: "Docker Local", sub: `BETA Release ${version}`, icon: containerIcon },
	{ kind: "vps", href: "/docs/self-hosting/vps/", label: "Setup Docker VPS", short: "Docker VPS", sub: `BETA Release ${version}`, icon: serverIcon },
];
---

<div class:list={["landing-actions", align === "center" && "landing-actions-center", !beta && "landing-actions-flat", compact && "landing-actions-compact", className]}>
	{guides.map((g) => (
		<a class="btn btn-glow btn-download" data-kind={g.kind === "docs" ? undefined : g.kind} href={withBase(g.href)} aria-label={compact ? `${g.label}, ${g.sub}` : undefined}>
			<svg viewBox="0 0 24 24" class="size-5 shrink-0" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d={g.icon}></path></svg>
			<span class="flex flex-col items-start leading-tight">
				<span class="btn-label"><span class="lbl-full">{g.label}</span>{compact ? <span class="lbl-short">{g.short}</span> : null}</span>
				<span class="btn-sub text-xs font-normal text-muted">{g.sub}</span>
			</span>
		</a>
	))}
	<div
		class="landing-downloads"
		role="group"
		aria-labelledby={beta ? `${idPrefix}-downloads` : undefined}
		aria-label={beta ? undefined : "Downloads (beta)"}
	>
		{beta ? (
			<p id={`${idPrefix}-downloads`} class="landing-beta">
				<span class="landing-beta-badge">Beta</span>
				<span>Stuarty is in beta: expect rough edges.</span>
			</p>
		) : null}
		<ul class="landing-download-list">
			{release.downloads.map((d) => (
				<li>
					<a class="btn btn-glow btn-download" data-os={d.os} href={d.href} rel="noreferrer" aria-label={compact ? `${d.label}, BETA Release ${version}` : undefined}>
						<svg viewBox="0 0 24 24" class="size-5 shrink-0" fill="currentColor" aria-hidden="true"><path d={icons[d.os]}></path></svg>
						<span class="flex flex-col items-start leading-tight">
							<span class="btn-label"><span class="lbl-full">{d.label}</span>{compact ? <span class="lbl-short">{SHORT[d.os]}</span> : null}</span>
							<span class="btn-sub text-xs font-normal text-muted">BETA Release {version}</span>
						</span>
					</a>
				</li>
			))}
		</ul>
	</div>
</div>
