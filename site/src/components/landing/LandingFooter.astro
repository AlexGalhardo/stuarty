---
// The footer of the landing pages: the same four actions as the hero (the author's choice), and the attribution
// the CC BY footage in the screenshots requires.
import LandingActions from "./LandingActions.astro";
import { credits } from "@/lib/landing-pages";

interface Props {
	/** Shows the release-stage notice (alpha) above the downloads. */
	beta?: boolean;
}

const { beta = true } = Astro.props;
---

<footer class="landing-footer relative border-t border-fg/10 bg-bg">
	<div class="site-container py-14">
		<LandingActions idPrefix="footer" align="center" beta={beta} />
		<p class="mt-10 px-12 text-center text-xs text-muted">{credits}</p>
	</div>
</footer>
