---
// A display title whose letters come in one by one with CSS alone, from the first paint: no script has to load
// before the largest text of the page is drawn. The heading keeps its text as its accessible name; the letters are
// presentation. Under reduced motion the global rule of globals.css makes the animation instant.
interface Props {
	text: string;
	as?: "h1" | "h2";
	id?: string;
	class?: string;
	tabindex?: string;
	/** Seconds before the first letter. */
	delay?: number;
}

const { text, as: Tag = "h1", id, class: className, tabindex, delay = 0.1 } = Astro.props;
let i = 0;
const words = text.split(" ").map((word) => [...word].map((ch) => ({ ch, i: i++ })));
---

<Tag id={id} class:list={["split-title", className]} tabindex={tabindex} aria-label={text} style={`--split-delay: ${delay}s`}>
	{words.map((letters, w) => (
		<>
			<span class="split-word" aria-hidden="true">{letters.map((l) => <span class="ch" style={`--i: ${l.i}`}>{l.ch}</span>)}</span>{w < words.length - 1 ? " " : ""}
		</>
	))}
</Tag>
