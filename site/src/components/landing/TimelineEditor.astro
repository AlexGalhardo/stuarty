---
// The timeline editor of the landing pages (brainstorming section 5.3): a preview, the MCP log of the agent and the
// tracks with the playhead. src/landing/timeline.ts draws it from one progress value. Without the class
// .timeline-on on an ancestor (a small screen, reduced motion in the creative page, no script) the clips are a plain
// list of sections.
import Placeholder from "./Placeholder.astro";
import Shot from "./Shot.astro";
import { features, shots, type Shot as ShotData } from "@/lib/landing-pages";
import { withBase } from "@/lib/site";

type Clip = {
	id: string;
	tc?: string;
	label: string;
	title: string;
	text: string;
	shot?: ShotData;
	clip?: string;
	features?: string[];
	fx?: string;
};
type LogEntry = { at: number; text: string };

interface Props {
	/** The heading level of each clip: h2 on a page, h3 inside a section that has its own h2. */
	headingLevel?: "h2" | "h3";
	/** The clips, in order; the default is the story of the creative version. */
	clips?: Clip[];
	/** The MCP log of the agent; null hides the panel. */
	log?: LogEntry[] | null;
	/** Shows the time code and the file name above each clip title. */
	labels?: boolean;
	/** The clip the agent captions and the clip it trims. */
	captionClip?: string;
	trimClip?: string;
	/** Ends with the export screen ("That was the whole studio."). */
	outro?: boolean;
	/** Each picture crossfades between its light and dark capture (`<src>-light`), like the home hero. */
	themeSwap?: boolean;
	/** A flat timeline like a desktop editor's: track codes, a ruler with ticks, numbered clips, a thin playhead. */
	flat?: boolean;
}

const byId = Object.fromEntries(features.map((f) => [f.id, f]));
const creativeClips: Clip[] = [
	{ id: "brief", tc: "00:00", label: "brief.md", title: "It starts with a brief.", text: "Answer a few questions; the answers become the brief of the production, and your agent reads them.", clip: "The guided briefing, 6 s" },
	{ id: "script", tc: "00:10", label: "script.md", title: byId.create.title + ".", text: byId.create.text, shot: shots.writing },
	{ id: "cut", tc: "00:20", label: "launch-teaser.mp4", title: byId.edit.title + ".", text: byId.edit.text, shot: shots.videoEditor },
	{ id: "thumb", tc: "00:30", label: "thumbnail.png", title: "The thumbnail, next door.", text: "Layers, text, masks and templates, in the same project. An agent moves a layer and the history signs it local:claude.", shot: shots.imageEditor },
	{ id: "agent", tc: "00:40", label: "agent", title: "Your agent, on the same timeline.", text: "Connect the agent you already use. Its calls are the same commands you run, and every change is attributed and undoable.", shot: shots.agentChat },
	{ id: "publish", tc: "00:50", label: "publish", title: byId.publish.title + ".", text: byId.publish.text, shot: shots.calendar },
];
const creativeLog: LogEntry[] = [
	{ at: 0.18, text: "project_get  prj_6jzec0m2nn  rev 4" },
	{ at: 0.36, text: "edit  caption.add  rev 5" },
	{ at: 0.52, text: "edit  item.trim  rev 6" },
	{ at: 0.66, text: "lint  0 errors" },
	{ at: 0.8, text: "job_start  kind=export" },
	{ at: 0.94, text: "job_get  succeeded  1080x1920" },
];

const {
	headingLevel: H = "h2",
	clips = creativeClips,
	log = creativeLog,
	labels = true,
	captionClip = "cut",
	trimClip = "cut",
	outro = true,
	themeSwap = false,
	flat = false,
} = Astro.props;
const step = (i: number): string => String(i + 1).padStart(2, "0");
const stepName = (c: Clip): string => c.title.replace(/[.]$/, "");
const light = (s: ShotData): ShotData => ({ ...s, src: `${s.src}-light` });
const n = clips.length;
const w = 100 / n;
const captionIndex = Math.max(0, clips.findIndex((c) => c.id === captionClip));
const trimIndex = Math.max(0, clips.findIndex((c) => c.id === trimClip));
// About 430 px of lane per clip.
const laneWidth = `${n * 430}px`;
---

<div class:list={["editor-frame", flat && "editor-flat"]} data-editor-pin>
	<div class:list={["editor-top site-container", log === null && "editor-top-solo"]}>
		<div class="editor-preview" data-preview>
			{clips.map((c, i) => (
				<article class="preview-item" data-preview-item={i} data-fx={c.fx} aria-labelledby={`clip-${c.id}`}>
					<div class="preview-text">
						{labels ? <p class="font-mono text-xs text-brand-text">{c.tc} &middot; {c.label}</p> : null}
						<H id={`clip-${c.id}`} class="display-title mt-3 text-fg">{c.title}</H>
						<p class="lead mt-4">{c.text}</p>
						{c.features?.length ? (
							<ul class="preview-features">
								{c.features.map((f) => <li>{f}</li>)}
							</ul>
						) : null}
					</div>
					<div class="preview-media">
						{c.shot ? (
							(themeSwap ? (
								<figure class="showcase theme-swap m-0">
									<Shot shot={light(c.shot)} sizes="(min-width: 64rem) 46rem, 100vw" class="shot-light" />
									<Shot shot={{ ...c.shot, alt: "" }} sizes="(min-width: 64rem) 46rem, 100vw" class="shot-dark" />
								</figure>
							) : (
								<div class="showcase"><Shot shot={c.shot} sizes="(min-width: 64rem) 36rem, 100vw" /></div>
							))
						) : (
							<Placeholder label={c.clip ?? c.title} aspect="16 / 10" class="showcase rounded-3xl" />
						)}
					</div>
				</article>
			))}
		</div>
		{log === null ? null : (<div class="editor-log" aria-hidden="true">
			<p class="flex items-center gap-2 border-b border-white/10 px-3 py-2 font-sans text-[0.6875rem] font-medium tracking-wider text-white/70 uppercase">
				<img src={withBase("/logo.png")} alt="" width="16" height="16" class="size-4" /> local:claude &middot; MCP
			</p>
			<ol class="px-3 py-2">
				{(log ?? []).map((l) => (
					<li data-log-at={l.at}><span class="text-white/40">&rsaquo;</span> {l.text}</li>
				))}
			</ol>
		</div>)}
	</div>

	<div class="editor-bottom" aria-hidden="true">
		<div class="editor-toolbar site-container">
			<span class="font-mono text-sm text-fg" data-timecode>00:00:00</span>
			<span class="text-xs text-muted">Launch teaser &middot; 1080&times;1920 &middot; 30 fps</span>
			<span class="ml-auto rounded-md bg-brand px-2.5 py-1 text-xs font-semibold text-brand-foreground" data-export>Export</span>
		</div>
		<div class="editor-lanes">
			{flat ? (
				<div class="track-heads">
					<span class="head-ruler"></span>
					<span class="head-cc"><b>CC</b> Captions</span>
					<span class="head-video"><b>V1</b> Steps</span>
					<span class="head-audio"><b>A1</b> Music</span>
				</div>
			) : null}
			<div class="editor-playhead" data-playhead><span></span>{flat ? <em class="playhead-tc" data-timecode>00:00:00</em> : null}</div>
			<div class="editor-lane-3d">
				<div class="editor-lane" data-lane style={`width: ${laneWidth}`}>
					<div class="ruler">
						{Array.from({ length: 13 }, (_, i) => <span>{`00:${String(i * 5).padStart(2, "0")}`}</span>)}
					</div>
					<div class="track track-cc"><span class="track-name">Captions</span>
						<span class="clip clip-caption" style={`left: ${captionIndex * w}%; width: ${w * 0.8}%`} data-caption-clip data-at={captionIndex / n}>One studio for everything you make</span>
					</div>
					<div class="track track-video"><span class="track-name">Video</span>
						{clips.map((c, i) => (
							<span class="clip clip-video" style={`left: ${i * w}%; width: calc(${w}% - 6px)`} data-clip={i} data-trim={i === trimIndex ? "" : undefined} data-at={i === trimIndex ? (i + 0.5) / n : undefined}>{flat ? <><span class="clip-step">{step(i)}</span><span class="clip-title">{stepName(c)}</span></> : c.label}</span>
						))}
					</div>
					<div class="track track-audio"><span class="track-name">Music</span>
						<span class="clip clip-audio" style="left: 0; width: 100%"><svg viewBox="0 0 400 24" preserveAspectRatio="none" class="h-full w-full"><path d="M0 12 Q5 2 10 12 T20 12 T30 12 T40 12 T50 12 T60 12 T70 12 T80 12 T90 12 T100 12 T110 12 T120 12 T130 12 T140 12 T150 12 T160 12 T170 12 T180 12 T190 12 T200 12 T210 12 T220 12 T230 12 T240 12 T250 12 T260 12 T270 12 T280 12 T290 12 T300 12 T310 12 T320 12 T330 12 T340 12 T350 12 T360 12 T370 12 T380 12 T390 12 T400 12" fill="none" stroke="currentColor" stroke-width="1"></path></svg></span>
					</div>
				</div>
			</div>
			<div class="agent-cursor" data-agent-cursor>
				<img src={withBase("/logo.png")} alt="" width="28" height="28" />
				<span>local:claude</span>
			</div>
		</div>
	</div>

	{outro ? (<div class="editor-outro" data-outro>
		<p class="eyebrow">Exported &middot; 1080&times;1920 &middot; 22 s</p>
		<p class="display-title mt-3 text-fg">That was the whole studio.</p>
	</div>) : null}
</div>

<style is:global>
	/* Without timeline mode the editor is a plain list of the clips (small screens, reduced motion, no script). */
	.editor-frame {
		position: relative;
		display: flex;
		flex-direction: column;
	}
	.editor-preview {
		display: grid;
		gap: 4rem;
		padding-block: 2rem;
	}
	.preview-item {
		display: grid;
		gap: 2rem;
		align-items: center;
	}
	@media (min-width: 48rem) {
		.preview-item {
grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
		}
	}
	.editor-log,
	.editor-bottom,
	.editor-outro {
		display: none;
	}

	/* Timeline mode: a pinned editor filling the viewport. */
	html.timeline-on .editor-frame {
		height: 100svh;
		padding-top: var(--header-h);
	}
	html.timeline-on .editor-top {
		position: relative;
		flex: 1 1 auto;
		min-height: 0;
		display: grid;
		grid-template-columns: minmax(0, 1fr) 17rem;
		gap: 1.5rem;
		padding-block: 1.5rem 1rem;
	}
	html.timeline-on .editor-top-solo {
		grid-template-columns: minmax(0, 1fr);
	}
	html.timeline-on .editor-preview {
		position: relative;
		display: block;
		padding: 0;
		max-width: none;
		margin: 0;
	}
	html.timeline-on .preview-item {
		position: absolute;
		inset: 0;
		visibility: hidden;
		opacity: 0;
	}
	html.timeline-on .preview-item[data-active] {
		visibility: visible;
		opacity: 1;
	}
	html.timeline-on .preview-media .showcase {
		max-height: calc(100svh - var(--header-h) - 22rem);
	}
	html.timeline-on .preview-media img {
		object-fit: cover;
		object-position: top left;
		max-height: calc(100svh - var(--header-h) - 22rem);
	}
	html.timeline-on .editor-log {
		display: block;
		align-self: start;
		margin-top: 0.5rem;
		border-radius: 0.875rem;
		background: oklch(0.145 0 0 / 88%);
		border: 1px solid oklch(1 0 0 / 10%);
		color: oklch(0.9 0 0);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		line-height: 1.9;
		backdrop-filter: blur(10px);
	}
	html.timeline-on .editor-log li {
		opacity: 0;
		transform: translateY(4px);
		transition:
opacity 300ms,
transform 300ms var(--ease-out-expo);
	}
	html.timeline-on .editor-log li[data-on] {
		opacity: 1;
		transform: none;
	}
	html.timeline-on .editor-bottom {
		display: block;
		flex: 0 0 auto;
		height: 15.5rem;
		border-top: 1px solid color-mix(in oklab, var(--fg) 10%, transparent);
		background: color-mix(in oklab, var(--bg) 82%, transparent);
		backdrop-filter: blur(14px);
	}
	.editor-toolbar {
		display: flex;
		align-items: center;
		gap: 1rem;
		height: 2.75rem;
		border-bottom: 1px solid color-mix(in oklab, var(--fg) 8%, transparent);
	}
	.editor-lanes {
		position: relative;
		height: calc(100% - 2.75rem);
		overflow: hidden;
		perspective: 1100px;
		perspective-origin: 30% -40%;
	}
	.editor-lane-3d {
		position: absolute;
		inset: 0;
		transform: rotateX(24deg);
		transform-origin: 50% 0;
	}
	.editor-lane {
		position: absolute;
		top: 0.5rem;
		left: 30vw;
		will-change: transform;
	}
	.ruler {
		display: flex;
		justify-content: space-between;
		height: 1.5rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		color: var(--muted);
		border-bottom: 1px solid color-mix(in oklab, var(--fg) 12%, transparent);
	}
	.track {
		position: relative;
		height: 3.25rem;
		margin-top: 0.5rem;
	}
	.track-audio {
		height: 2.25rem;
	}
	.track-name {
		position: absolute;
		left: -6.5rem;
		top: 50%;
		transform: translateY(-50%);
		font-size: 0.6875rem;
		color: var(--muted);
	}
	.clip {
		position: absolute;
		top: 0;
		bottom: 0;
		display: flex;
		align-items: center;
		padding-inline: 0.75rem;
		border-radius: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		white-space: nowrap;
		overflow: hidden;
		transform-origin: left center;
	}
	.clip-video {
		color: oklch(0.994 0 0);
		background: linear-gradient(135deg in oklab, oklch(0.442 0.222 272.9), oklch(0.55 0.21 278));
		box-shadow: inset 0 0 0 1px oklch(1 0 0 / 14%);
	}
	.clip-video[data-active] {
		background: linear-gradient(135deg in oklab, oklch(0.55 0.21 278), oklch(0.645 0.189 282.5));
		box-shadow:
inset 0 0 0 2px oklch(0.88 0.08 280),
0 10px 30px -10px oklch(0.645 0.189 282.5 / 70%);
	}
	.clip-caption {
		color: oklch(0.21 0.09 272);
		background: oklch(0.88 0.08 280);
	}
	.clip-audio {
		color: oklch(0.72 0.17 282);
		background: color-mix(in oklab, oklch(0.645 0.189 282.5) 14%, transparent);
	}
	.editor-playhead {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 30vw;
		z-index: 5;
		width: 2px;
		background: var(--brand-text);
		pointer-events: none;
	}
	.editor-playhead span {
		position: absolute;
		top: 0;
		left: -6px;
		width: 14px;
		height: 10px;
		border-radius: 2px 2px 7px 7px;
		background: var(--brand-text);
	}
	.agent-cursor {
		position: absolute;
		top: 0;
		left: 0;
		z-index: 6;
		display: flex;
		align-items: center;
		gap: 0.375rem;
		padding: 0.25rem 0.5rem 0.25rem 0.25rem;
		border-radius: 999px;
		background: oklch(0.145 0 0 / 90%);
		color: oklch(0.9 0 0);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		box-shadow: 0 8px 24px -8px rgb(0 0 0 / 60%);
		pointer-events: none;
	}
	.agent-cursor img {
		width: 1.5rem;
		height: 1.5rem;
	}
	html.timeline-on .editor-outro {
		position: absolute;
		inset: auto 0 18vh 0;
		display: block;
		text-align: center;
		visibility: hidden;
		opacity: 0;
		pointer-events: none;
	}
	/* The flat variant (the home): a desktop editor's timeline, no tilt, no glow. */
	html.timeline-on .editor-flat .editor-bottom {
		height: 11.5rem;
		background: var(--bg);
		backdrop-filter: none;
	}
	.editor-flat .editor-toolbar [data-export] {
		display: none;
	}
	.editor-flat .editor-lanes {
		perspective: none;
	}
	.editor-flat .editor-lane-3d {
		transform: none;
	}
	.editor-flat .editor-lane {
		top: 0;
	}
	/* The ruler: a tick every second, a taller one every five, the time code over the tall ones. */
	.editor-flat .ruler {
		height: 1.75rem;
		align-items: flex-end;
		padding-bottom: 0.625rem;
		font-size: 0.625rem;
		color: var(--muted);
		background:
			repeating-linear-gradient(to right, color-mix(in oklab, var(--fg) 35%, transparent) 0 1px, transparent 1px calc(100% / 12))
				0 100% / 100% 0.5rem no-repeat,
			repeating-linear-gradient(to right, color-mix(in oklab, var(--fg) 18%, transparent) 0 1px, transparent 1px calc(100% / 60))
				0 100% / 100% 0.25rem no-repeat;
	}
	.editor-flat .ruler span {
		transform: translateX(0.25rem);
	}
	.editor-flat .track {
		height: 2.75rem;
		margin-top: 0;
		border-bottom: 1px solid color-mix(in oklab, var(--fg) 8%, transparent);
	}
	.editor-flat .track-cc {
		height: 1.75rem;
	}
	.editor-flat .track-audio {
		height: 2rem;
	}
	/* The track headers: a fixed column at the left edge; the lane slides under it. */
	.editor-flat .track-name {
		display: none;
	}
	.editor-flat .track-heads {
		position: absolute;
		inset: 0 auto 0 0;
		z-index: 4;
		display: flex;
		flex-direction: column;
		width: 8.5rem;
		background: var(--bg);
		border-inline-end: 1px solid color-mix(in oklab, var(--fg) 12%, transparent);
	}
	.editor-flat .track-heads span {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding-inline: 1rem;
		font-size: 0.6875rem;
		color: var(--muted);
		border-bottom: 1px solid color-mix(in oklab, var(--fg) 8%, transparent);
	}
	.editor-flat .track-heads b {
		min-width: 1.5rem;
		font-family: var(--font-mono);
		font-weight: 600;
		color: var(--fg);
	}
	.editor-flat .head-ruler {
		height: 1.75rem;
	}
	.editor-flat .head-cc {
		height: 1.75rem;
	}
	.editor-flat .head-video {
		height: 2.75rem;
	}
	.editor-flat .head-audio {
		height: 2rem;
	}
	.editor-flat .clip {
		top: 0.25rem;
		bottom: 0.25rem;
		gap: 0.5rem;
		padding-inline: 0.5rem;
		border-radius: 3px;
		font-family: inherit;
		font-size: 0.75rem;
		box-shadow: none;
		border-inline-start: 2px solid currentColor;
	}
	.editor-flat .clip-video {
		color: var(--brand-text);
		background: color-mix(in oklab, var(--brand-accent) 16%, var(--bg));
	}
	.editor-flat .clip-video .clip-title {
		color: var(--fg);
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.editor-flat .clip-video[data-active] {
		background: color-mix(in oklab, var(--brand-accent) 30%, var(--bg));
		box-shadow: inset 0 0 0 1px var(--brand-text);
	}
	.editor-flat .clip-step {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 600;
	}
	.editor-flat .clip-caption {
		color: oklch(0.55 0.13 75);
		background: color-mix(in oklab, oklch(0.84 0.15 85) 22%, var(--bg));
		font-size: 0.6875rem;
	}
	.editor-flat .clip-audio {
		color: oklch(0.55 0.12 160);
		background: color-mix(in oklab, oklch(0.75 0.14 160) 16%, var(--bg));
	}
	.dark .editor-flat .clip-caption {
		color: oklch(0.84 0.15 85);
	}
	.dark .editor-flat .clip-audio {
		color: oklch(0.78 0.13 160);
	}
	.editor-flat .editor-playhead {
		width: 1px;
		background: oklch(0.63 0.24 25);
	}
	.editor-flat .editor-playhead span {
		left: -5px;
		width: 11px;
		height: 8px;
		border-radius: 0 0 6px 6px;
		background: oklch(0.63 0.24 25);
	}
	.editor-flat .playhead-tc {
		position: absolute;
		top: 0;
		left: 9px;
		padding: 0.0625rem 0.3125rem;
		border-radius: 3px;
		background: oklch(0.63 0.24 25);
		color: oklch(1 0 0);
		font-family: var(--font-mono);
		font-size: 0.625rem;
		font-style: normal;
		line-height: 1.4;
		white-space: nowrap;
	}
	.editor-flat .agent-cursor {
		display: none;
	}
</style>
