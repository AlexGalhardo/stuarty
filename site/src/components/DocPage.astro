---
import Base from "../layouts/Base.astro";
import type { Doc } from "@/lib/content";
import { docMetadata } from "@/components/doc-article";
import { renderDoc } from "../prerender";

interface Props {
	doc: Doc;
}

const { doc } = Astro.props;
const meta = docMetadata(doc);
const html = await renderDoc(doc);
---

<Base title={meta.title} description={meta.description} canonical={doc.href} twin={`${doc.href}.md`} progress>
	<Fragment set:html={html} />
</Base>
