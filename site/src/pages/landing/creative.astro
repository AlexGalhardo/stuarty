---
// Candidate landing page C, "The page is a timeline" (brainstorming section 5.3): the landing is a video editor.
// The wheel moves a playhead over tracks of clips receding in perspective; the preview above shows the clip under
// it; an agent cursor edits the page live and its MCP calls scroll in a log; at the end the timeline collapses into
// the mascot. On a small screen or with reduced motion the clips are a plain list of sections.
import "@/src/landing/landing.css";
import Base from "../../layouts/Base.astro";
import { landing } from "@/lib/landing";
import FontPreload from "../../components/landing/FontPreload.astro";
import DriveTabs from "../../components/landing/DriveTabs.astro";
import LandingFooter from "../../components/landing/LandingFooter.astro";
import LandingActions from "../../components/landing/LandingActions.astro";
import Placeholder from "../../components/landing/Placeholder.astro";
import Shot from "../../components/landing/Shot.astro";
import SplitTitle from "../../components/landing/SplitTitle.astro";
import StageCanvas from "../../components/landing/StageCanvas.astro";
import { cta, features, shots, trust, type Shot as ShotData } from "@/lib/landing-pages";
import { dockerRunCommand } from "@/lib/latest-release";
import { withBase } from "@/lib/site";

type Clip = { id: string; tc: string; label: string; title: string; text: string; shot?: ShotData; clip?: string };

const byId = Object.fromEntries(features.map((f) => [f.id, f]));
const clips: Clip[] = [
	{ id: "brief", tc: "00:00", label: "brief.md", title: "It starts with a brief.", text: "Answer a few questions; the answers become the brief of the production, and your agent reads them.", clip: "The guided briefing, 6 s" },
	{ id: "script", tc: "00:10", label: "script.md", title: byId.create.title + ".", text: byId.create.text, shot: shots.writing },
	{ id: "cut", tc: "00:20", label: "launch-teaser.mp4", title: byId.edit.title + ".", text: byId.edit.text, shot: shots.videoEditor },
	{ id: "thumb", tc: "00:30", label: "thumbnail.png", title: "The thumbnail, next door.", text: "Layers, text, masks and templates, in the same project. An agent moves a layer and the history signs it local:claude.", shot: shots.imageEditor },
	{ id: "agent", tc: "00:40", label: "agent", title: "Your agent, on the same timeline.", text: "Connect the agent you already use. Its calls are the same commands you run, and every change is attributed and undoable.", shot: shots.agentChat },
	{ id: "publish", tc: "00:50", label: "publish", title: byId.publish.title + ".", text: byId.publish.text, shot: shots.calendar },
];

const log = [
	{ at: 0.18, text: "project_get  prj_6jzec0m2nn  rev 4" },
	{ at: 0.36, text: "edit  caption.add  rev 5" },
	{ at: 0.52, text: "edit  item.trim  rev 6" },
	{ at: 0.66, text: "lint  0 errors" },
	{ at: 0.8, text: "job_start  kind=export" },
	{ at: 0.94, text: "job_get  succeeded  1080x1920" },
];

const install = dockerRunCommand();
---

<Base title={landing.title} description={landing.description} noindex headerVariant="landing">
	<FontPreload slot="head" />
	<script is:inline>
		(function () {
			var big = matchMedia("(min-width: 64rem) and (min-height: 40rem)").matches;
			var calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
			if (big && !calm) document.documentElement.classList.add("timeline-on");
			if (!calm) document.documentElement.classList.add("motion-ok");
		})();
	</script>
	<main id="content" data-expressive data-page="creative" class="relative isolate overflow-x-clip">
		<div class="pointer-events-none fixed inset-0 -z-10">
			<StageCanvas id="creative-stage" still="left: 50%; top: 40%; width: min(20vw, 14rem);" />
		</div>

		<!-- Intro -->
		<section aria-labelledby="creative-title" class="site-container relative flex min-h-[88svh] flex-col justify-center pt-[calc(var(--header-h)+2rem)] pb-12">
			<p class="eyebrow" data-hero-item>Stuarty &middot; a creative cut</p>
			<SplitTitle text="This page is a timeline." id="creative-title" class="display-hero mt-5 max-w-4xl text-fg" />
			<p class="lead mt-6 max-w-2xl" data-hero-item>Scroll to move the playhead. Each clip is one part of the studio: create, edit, manage and publish your content in one place, with an agent editing beside you.</p>
			<div class="mt-9" data-hero-item>
				<LandingActions idPrefix="hero" />
			</div>
			<a href="#timeline" class="mt-8 inline-flex min-h-11 items-center gap-2 self-start text-sm font-medium text-brand-text underline-offset-4 hover:underline" data-hero-item>Play the timeline <span aria-hidden="true">&darr;</span></a>
		</section>

		<!-- The editor: preview, log, tracks -->
		<section id="timeline" aria-label="The studio, clip by clip" class="relative" data-editor>
			<div class="editor-frame" data-editor-pin>
				<div class="editor-top site-container">
					<div class="editor-preview" data-preview>
						{clips.map((c, i) => (
							<article class="preview-item" data-preview-item={i} aria-labelledby={`clip-${c.id}`}>
								<div class="preview-text">
									<p class="font-mono text-xs text-brand-text">{c.tc} &middot; {c.label}</p>
									<h2 id={`clip-${c.id}`} class="display-title mt-3 text-fg">{c.title}</h2>
									<p class="lead mt-4">{c.text}</p>
								</div>
								<div class="preview-media">
									{c.shot ? (
										<div class="showcase"><Shot shot={c.shot} sizes="(min-width: 64rem) 36rem, 100vw" /></div>
									) : (
										<Placeholder label={c.clip ?? c.title} aspect="16 / 10" class="showcase rounded-3xl" />
									)}
								</div>
							</article>
						))}
					</div>
					<div class="editor-log" aria-hidden="true">
						<p class="flex items-center gap-2 border-b border-white/10 px-3 py-2 font-sans text-[0.6875rem] font-medium tracking-wider text-white/70 uppercase">
							<img src={withBase("/logo.png")} alt="" width="16" height="16" class="size-4" /> local:claude &middot; MCP
						</p>
						<ol class="px-3 py-2">
							{log.map((l) => (
								<li data-log-at={l.at}><span class="text-white/40">&rsaquo;</span> {l.text}</li>
							))}
						</ol>
					</div>
				</div>

				<div class="editor-bottom" aria-hidden="true">
					<div class="editor-toolbar site-container">
						<span class="font-mono text-sm text-fg" data-timecode>00:00:00</span>
						<span class="text-xs text-muted">Launch teaser &middot; 1080&times;1920 &middot; 30 fps</span>
						<span class="ml-auto rounded-md bg-brand px-2.5 py-1 text-xs font-semibold text-brand-foreground" data-export>Export</span>
					</div>
					<div class="editor-lanes">
						<div class="editor-playhead" data-playhead><span></span></div>
						<div class="editor-lane-3d">
							<div class="editor-lane" data-lane>
								<div class="ruler">
									{Array.from({ length: 13 }, (_, i) => <span>{`00:${String(i * 5).padStart(2, "0")}`}</span>)}
								</div>
								<div class="track"><span class="track-name">Captions</span>
									<span class="clip clip-caption" style="left: 33%; width: 12%" data-caption-clip>One studio for everything you make</span>
								</div>
								<div class="track"><span class="track-name">Video</span>
									{clips.map((c, i) => (
										<span class="clip clip-video" style={`left: ${i * (100 / 6)}%; width: calc(${100 / 6}% - 6px)`} data-clip={i}>{c.label}</span>
									))}
								</div>
								<div class="track track-audio"><span class="track-name">Music</span>
									<span class="clip clip-audio" style="left: 0; width: 100%"><svg viewBox="0 0 400 24" preserveAspectRatio="none" class="h-full w-full"><path d="M0 12 Q5 2 10 12 T20 12 T30 12 T40 12 T50 12 T60 12 T70 12 T80 12 T90 12 T100 12 T110 12 T120 12 T130 12 T140 12 T150 12 T160 12 T170 12 T180 12 T190 12 T200 12 T210 12 T220 12 T230 12 T240 12 T250 12 T260 12 T270 12 T280 12 T290 12 T300 12 T310 12 T320 12 T330 12 T340 12 T350 12 T360 12 T370 12 T380 12 T390 12 T400 12" fill="none" stroke="currentColor" stroke-width="1"></path></svg></span>
								</div>
							</div>
						</div>
						<div class="agent-cursor" data-agent-cursor>
							<img src={withBase("/logo.png")} alt="" width="28" height="28" />
							<span>local:claude</span>
						</div>
					</div>
				</div>

				<div class="editor-outro" data-outro>
					<p class="eyebrow">Exported &middot; 1080&times;1920 &middot; 22 s</p>
					<p class="display-title mt-3 text-fg">That was the whole studio.</p>
				</div>
			</div>
		</section>

		<!-- After the cut -->
		<section aria-labelledby="drive-title" class="site-container relative py-20 lg:py-32">
			<div data-reveal>
				<p class="eyebrow" data-reveal-item>The same commands, four doors</p>
				<h2 id="drive-title" class="display-title mt-4 max-w-3xl text-fg" data-reveal-item>What the agent just did, you can do too.</h2>
			</div>
			<DriveTabs idPrefix="creative" class="mt-10" />
		</section>

		<section aria-labelledby="yours-title" class="site-container relative py-16 lg:py-24">
			<div data-reveal>
				<p class="eyebrow" data-reveal-item>{trust.eyebrow}</p>
				<h2 id="yours-title" class="display-title mt-4 max-w-3xl text-fg" data-reveal-item>{trust.title}</h2>
			</div>
			<dl class="mt-10 grid gap-x-10 gap-y-6 sm:grid-cols-2 lg:grid-cols-3" data-reveal>
				{trust.points.map((p) => (
					<div class="border-t border-fg/12 pt-4" data-reveal-item>
						<dt class="text-base font-semibold text-fg">{p.title}</dt>
						<dd class="mt-1 text-sm leading-relaxed text-muted">{p.text}</dd>
					</div>
				))}
			</dl>
		</section>

		<!-- The command line easter egg -->
		<section aria-labelledby="cli-title" class="site-container relative py-16 lg:py-24">
			<div class="mx-auto max-w-3xl">
			<h2 id="cli-title" class="display-title text-center text-fg">{cta.title}</h2>
			<form class="terminal mt-12 overflow-hidden" data-cli data-install={install} data-quick={withBase("/docs/getting-started/quick-start/")}>
				<div class="border-b border-white/10 px-4 py-2 font-sans text-xs text-white/70">Try a command: <code class="font-mono">help</code>, <code class="font-mono">features</code> or <code class="font-mono">install</code></div>
				<div class="max-h-72 overflow-y-auto px-4 py-3" data-cli-out role="log" aria-live="polite" aria-label="Command output"></div>
				<div class="flex items-center gap-2 border-t border-white/10 px-4 py-2">
					<label for="cli-input" class="t-prompt">stuarty&nbsp;$</label>
					<input id="cli-input" name="command" autocomplete="off" spellcheck="false" class="min-h-11 flex-1 bg-transparent font-mono text-sm text-white outline-none placeholder:text-white/40" placeholder="help" />
					<button type="submit" class="rounded-md border border-white/15 px-3 py-1.5 font-sans text-xs font-medium text-white/80 hover:bg-white/10">Run</button>
				</div>
			</form>
			</div>
		</section>
	</main>
	<LandingFooter />
</Base>

<style is:global>
	/* Without timeline mode the editor is a plain list of the clips (small screens, reduced motion, no script). */
	.editor-frame {
		position: relative;
		display: flex;
		flex-direction: column;
	}
	.editor-preview {
		display: grid;
		gap: 4rem;
		padding-block: 2rem;
	}
	.preview-item {
		display: grid;
		gap: 2rem;
		align-items: center;
	}
	@media (min-width: 48rem) {
		.preview-item {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		}
	}
	.editor-log,
	.editor-bottom,
	.editor-outro {
		display: none;
	}

	/* Timeline mode: a pinned editor filling the viewport. */
	html.timeline-on .editor-frame {
		height: 100svh;
		padding-top: var(--header-h);
	}
	html.timeline-on .editor-top {
		position: relative;
		flex: 1 1 auto;
		min-height: 0;
		display: grid;
		grid-template-columns: minmax(0, 1fr) 17rem;
		gap: 1.5rem;
		padding-block: 1.5rem 1rem;
	}
	html.timeline-on .editor-preview {
		position: relative;
		display: block;
		padding: 0;
		max-width: none;
		margin: 0;
	}
	html.timeline-on .preview-item {
		position: absolute;
		inset: 0;
		visibility: hidden;
		opacity: 0;
	}
	html.timeline-on .preview-item[data-active] {
		visibility: visible;
		opacity: 1;
	}
	html.timeline-on .preview-media .showcase {
		max-height: calc(100svh - var(--header-h) - 22rem);
	}
	html.timeline-on .preview-media img {
		object-fit: cover;
		object-position: top left;
		max-height: calc(100svh - var(--header-h) - 22rem);
	}
	html.timeline-on .editor-log {
		display: block;
		align-self: start;
		margin-top: 0.5rem;
		border-radius: 0.875rem;
		background: oklch(0.145 0 0 / 88%);
		border: 1px solid oklch(1 0 0 / 10%);
		color: oklch(0.9 0 0);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		line-height: 1.9;
		backdrop-filter: blur(10px);
	}
	html.timeline-on .editor-log li {
		opacity: 0;
		transform: translateY(4px);
		transition:
			opacity 300ms,
			transform 300ms var(--ease-out-expo);
	}
	html.timeline-on .editor-log li[data-on] {
		opacity: 1;
		transform: none;
	}
	html.timeline-on .editor-bottom {
		display: block;
		flex: 0 0 auto;
		height: 15.5rem;
		border-top: 1px solid color-mix(in oklab, var(--fg) 10%, transparent);
		background: color-mix(in oklab, var(--bg) 82%, transparent);
		backdrop-filter: blur(14px);
	}
	.editor-toolbar {
		display: flex;
		align-items: center;
		gap: 1rem;
		height: 2.75rem;
		border-bottom: 1px solid color-mix(in oklab, var(--fg) 8%, transparent);
	}
	.editor-lanes {
		position: relative;
		height: calc(100% - 2.75rem);
		overflow: hidden;
		perspective: 1100px;
		perspective-origin: 30% -40%;
	}
	.editor-lane-3d {
		position: absolute;
		inset: 0;
		transform: rotateX(24deg);
		transform-origin: 50% 0;
	}
	.editor-lane {
		position: absolute;
		top: 0.5rem;
		left: 30vw;
		width: 2600px;
		will-change: transform;
	}
	.ruler {
		display: flex;
		justify-content: space-between;
		height: 1.5rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		color: var(--muted);
		border-bottom: 1px solid color-mix(in oklab, var(--fg) 12%, transparent);
	}
	.track {
		position: relative;
		height: 3.25rem;
		margin-top: 0.5rem;
	}
	.track-audio {
		height: 2.25rem;
	}
	.track-name {
		position: absolute;
		left: -6.5rem;
		top: 50%;
		transform: translateY(-50%);
		font-size: 0.6875rem;
		color: var(--muted);
	}
	.clip {
		position: absolute;
		top: 0;
		bottom: 0;
		display: flex;
		align-items: center;
		padding-inline: 0.75rem;
		border-radius: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		white-space: nowrap;
		overflow: hidden;
		transform-origin: left center;
	}
	.clip-video {
		color: oklch(0.994 0 0);
		background: linear-gradient(135deg in oklab, oklch(0.442 0.222 272.9), oklch(0.55 0.21 278));
		box-shadow: inset 0 0 0 1px oklch(1 0 0 / 14%);
	}
	.clip-video[data-active] {
		background: linear-gradient(135deg in oklab, oklch(0.55 0.21 278), oklch(0.645 0.189 282.5));
		box-shadow:
			inset 0 0 0 2px oklch(0.88 0.08 280),
			0 10px 30px -10px oklch(0.645 0.189 282.5 / 70%);
	}
	.clip-caption {
		color: oklch(0.21 0.09 272);
		background: oklch(0.88 0.08 280);
	}
	.clip-audio {
		color: oklch(0.72 0.17 282);
		background: color-mix(in oklab, oklch(0.645 0.189 282.5) 14%, transparent);
	}
	.editor-playhead {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 30vw;
		z-index: 5;
		width: 2px;
		background: var(--brand-text);
		pointer-events: none;
	}
	.editor-playhead span {
		position: absolute;
		top: 0;
		left: -6px;
		width: 14px;
		height: 10px;
		border-radius: 2px 2px 7px 7px;
		background: var(--brand-text);
	}
	.agent-cursor {
		position: absolute;
		top: 0;
		left: 0;
		z-index: 6;
		display: flex;
		align-items: center;
		gap: 0.375rem;
		padding: 0.25rem 0.5rem 0.25rem 0.25rem;
		border-radius: 999px;
		background: oklch(0.145 0 0 / 90%);
		color: oklch(0.9 0 0);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		box-shadow: 0 8px 24px -8px rgb(0 0 0 / 60%);
		pointer-events: none;
	}
	.agent-cursor img {
		width: 1.5rem;
		height: 1.5rem;
	}
	html.timeline-on .editor-outro {
		position: absolute;
		inset: auto 0 18vh 0;
		display: block;
		text-align: center;
		visibility: hidden;
		opacity: 0;
		pointer-events: none;
	}
</style>

<script>
	import { start } from "../../landing/creative";
	start();
</script>
