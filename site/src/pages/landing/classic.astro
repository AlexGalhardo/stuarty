---
// Candidate landing page B, "Calm long scroll" (brainstorming section 5.2): a conventional page that explains and
// converts, with the 3D kept where it earns its place. The author picks one of the three versions; until then the
// page is out of the search indexes.
import "@/src/landing/landing.css";
import Base from "../../layouts/Base.astro";
import { landing } from "@/lib/landing";
import FontPreload from "../../components/landing/FontPreload.astro";
import DriveTabs from "../../components/landing/DriveTabs.astro";
import LandingFooter from "../../components/landing/LandingFooter.astro";
import LandingActions from "../../components/landing/LandingActions.astro";
import Placeholder from "../../components/landing/Placeholder.astro";
import Shot from "../../components/landing/Shot.astro";
import SplitTitle from "../../components/landing/SplitTitle.astro";
import StageCanvas from "../../components/landing/StageCanvas.astro";
import { cta, features, hero, problem, shots, trust } from "@/lib/landing-pages";

const chapters = [
	{ time: "0:00", name: "The brief" },
	{ time: "0:12", name: "The script" },
	{ time: "0:24", name: "Cut and captions" },
	{ time: "0:41", name: "The thumbnail" },
	{ time: "0:52", name: "Approve and publish" },
];

const trustIcons = [
	"M4 12h16M12 4v16",
	"M4 7h16v10H4zM8 21h8",
	"M3 12a9 9 0 1 0 18 0a9 9 0 1 0-18 0M5.6 5.6l12.8 12.8",
	"M5 12l4 4L19 6",
	"M6 10V7a6 6 0 0 1 12 0v3M5 10h14v10H5z",
	"M14 4h6v6M20 4l-9 9M10 6H4v14h14v-6",
];
---

<Base title={landing.title} description={landing.description} noindex headerVariant="landing">
	<FontPreload slot="head" />
	<script is:inline>
		if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("motion-ok");
	</script>
	<main id="content" data-expressive data-page="classic" class="relative isolate overflow-x-clip">
		<div class="pointer-events-none fixed inset-0 -z-10">
			<StageCanvas id="classic-stage" still="left: 78%; top: 18%; width: min(16vw, 12rem);" />
		</div>

		<!-- 1. Hero -->
		<section aria-labelledby="hero-title" class="site-container relative grid min-h-dvh items-center gap-12 pt-[calc(var(--header-h)+3rem)] pb-16 lg:grid-cols-12">
			<div class="lg:col-span-7">
				<p class="eyebrow" data-hero-item>{hero.eyebrow}</p>
				<SplitTitle text={hero.title} id="hero-title" class="display-hero mt-5 text-fg" />
				<p class="lead mt-6 max-w-xl" data-hero-item>{hero.lead}</p>
				<div class="mt-9" data-hero-item>
					<LandingActions idPrefix="hero" />
				</div>
			</div>
			<div class="lg:col-span-5 [perspective:1600px]" data-hero-frame>
				<div class="showcase origin-center will-change-transform lg:w-[135%] max-lg:w-full" style="transform: rotateY(-14deg) rotateX(6deg)" data-tilt>
					<Shot shot={shots.videoEditor} eager sizes="(min-width: 64rem) 46rem, 100vw" />
				</div>
			</div>
			<a href="#problem-title" class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 items-center gap-2 text-xs font-medium tracking-widest text-muted uppercase hover:text-fg md:inline-flex" data-scroll-cue>
				<span>Scroll to explore</span>
				<svg aria-hidden="true" viewBox="0 0 16 24" class="h-5 w-4" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="1" width="14" height="22" rx="7"></rect><path d="M8 6v4" data-cue-dot></path></svg>
			</a>
		</section>

		<!-- 2. The problem: five tools drift and merge into the mascot (scroll-linked) -->
		<section aria-labelledby="problem-title" class="relative" data-problem>
			<div class="site-container flex min-h-dvh flex-col items-center justify-center py-24 text-center" data-problem-pin>
				<p class="eyebrow">{problem.eyebrow}</p>
				<h2 id="problem-title" class="display-title mt-4 max-w-3xl text-fg">{problem.title}</h2>
				<p class="lead mx-auto mt-5 max-w-2xl">{problem.lead}</p>
				<ul class="relative mt-12 flex flex-wrap justify-center gap-3" aria-label="The tools Stuarty replaces" data-tools>
					{problem.tools.map((tool, i) => (
						<li class="rounded-full border border-fg/15 bg-bg/70 px-5 py-2.5 text-sm font-medium text-fg backdrop-blur" data-tool={i}>{tool}</li>
					))}
				</ul>
				<div aria-hidden="true" class="h-[30vh] w-full max-md:hidden" data-mascot-slot></div>
				<p class="mt-4 text-2xl font-semibold tracking-tight text-fg md:text-3xl" data-answer><span class="text-gradient">{problem.answer}</span></p>
			</div>
		</section>

		<!-- 3. Features -->
		<section aria-labelledby="features-title" class="site-container relative py-20 lg:py-32">
			<div data-reveal>
				<p class="eyebrow" data-reveal-item>What it does</p>
				<h2 id="features-title" class="display-title mt-4 max-w-3xl text-fg" data-reveal-item>Create, edit, manage and publish.</h2>
			</div>
			<div class="mt-14 grid gap-6 md:grid-cols-2" data-reveal>
				{features.map((f) => (
					<article class="group relative overflow-hidden rounded-2xl border border-fg/10 bg-bg/70 p-6 backdrop-blur-sm" data-reveal-item aria-labelledby={`feature-${f.id}`}>
						<div class="flex items-center gap-3">
							<span class="grid size-10 place-items-center rounded-lg bg-brand-subtle text-brand-text" aria-hidden="true">
								<svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={{ create: "M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z", edit: "M4 6h16v12H4zM4 10h16M9 6v4M15 6v4", manage: "M3 7h6l2 2h10v10H3z", publish: "M22 2 11 13M22 2l-7 20-4-9-9-4z" }[f.id]}></path></svg>
							</span>
							<p class="text-sm font-semibold text-brand-text">{f.verb}</p>
						</div>
						<h3 id={`feature-${f.id}`} class="mt-4 text-xl font-semibold tracking-tight text-fg">{f.title}</h3>
						<p class="mt-2 text-[0.9375rem] leading-relaxed text-(--lead)">{f.text}</p>
						<div class="relative mt-6">
							<div class="overflow-hidden rounded-xl border border-fg/10 transition-transform duration-500 ease-(--ease-out-expo) group-hover:-translate-y-1">
								<Shot shot={f.shot} sizes="(min-width: 48rem) 34rem, 100vw" />
							</div>
							<Placeholder label={f.clip} aspect="16 / 9" class="absolute -right-2 -bottom-4 w-[42%] shadow-2xl ring-1 ring-white/10" />
						</div>
					</article>
				))}
			</div>
		</section>

		<!-- 4. In action: the first complete flow -->
		<section aria-labelledby="action-title" class="site-container relative py-20 lg:py-32">
			<div data-reveal>
				<p class="eyebrow" data-reveal-item>In action</p>
				<h2 id="action-title" class="display-title mt-4 max-w-3xl text-fg" data-reveal-item>From the brief to a published short.</h2>
				<p class="lead mt-5 max-w-2xl" data-reveal-item>One production, start to finish: a 22-second vertical video with captions and its thumbnail, approved and scheduled.</p>
			</div>
			<div class="mt-12 grid gap-6 lg:grid-cols-[minmax(0,3fr)_minmax(0,1fr)]" data-reveal>
				<Placeholder label="The first complete flow, 60 s" aspect="16 / 9" class="showcase rounded-3xl" />
				<ol class="flex flex-col gap-1" aria-label="Chapters of the clip" data-reveal-item>
					{chapters.map((c, i) => (
						<li class="flex items-baseline gap-4 rounded-xl px-4 py-3 text-fg odd:bg-fg/[0.03]">
							<span class="font-mono text-xs text-muted">{c.time}</span>
							<span class="text-[0.9375rem] font-medium">{i + 1}. {c.name}</span>
						</li>
					))}
				</ol>
			</div>
		</section>

		<!-- Inside the studio: real screens drifting with the scroll -->
		<section aria-labelledby="inside-title" class="relative py-16 lg:py-24">
			<h2 id="inside-title" class="sr-only">Inside the studio</h2>
			<ul class="flex w-max gap-6 pl-[max(1rem,calc((100vw-90rem)/2+1.5rem))]" data-drift>
				{[shots.imageEditor, shots.agentChat, shots.videoEditorLight, shots.writing].map((s) => (
					<li class="w-[min(80vw,40rem)] shrink-0 overflow-hidden rounded-2xl border border-fg/10 shadow-xl">
						<Shot shot={s} sizes="(min-width: 48rem) 40rem, 80vw" />
					</li>
				))}
			</ul>
		</section>

		<!-- 5. Four ways to drive it -->
		<section aria-labelledby="drive-title" class="site-container relative py-20 lg:py-32">
			<div data-reveal>
				<p class="eyebrow" data-reveal-item>Agents are first-class users</p>
				<h2 id="drive-title" class="display-title mt-4 max-w-3xl text-fg" data-reveal-item>Four ways to drive it.</h2>
				<p class="lead mt-5 max-w-2xl" data-reveal-item>Everything you do in the editor, an agent can do through MCP, the CLI or the HTTP API. One command core, tested for parity.</p>
			</div>
			<DriveTabs idPrefix="classic" class="mt-10" />
		</section>

		<!-- 6. Trust -->
		<section aria-labelledby="trust-title" class="site-container relative py-20 lg:py-32">
			<div data-reveal>
				<p class="eyebrow" data-reveal-item>{trust.eyebrow}</p>
				<h2 id="trust-title" class="display-title mt-4 max-w-3xl text-fg" data-reveal-item>{trust.title}</h2>
			</div>
			<ul class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-fg/10 bg-fg/10 sm:grid-cols-2 lg:grid-cols-3" data-trust>
				{trust.points.map((p, i) => (
					<li class="bg-bg/90 p-6 backdrop-blur">
						<svg aria-hidden="true" viewBox="0 0 24 24" class="size-7 text-brand-text" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={trustIcons[i]} data-draw></path></svg>
						<h3 class="mt-4 text-base font-semibold text-fg">{p.title}</h3>
						<p class="mt-1.5 text-sm leading-relaxed text-muted">{p.text}</p>
					</li>
				))}
			</ul>
		</section>

		<!-- 7. Call to action -->
		<section aria-labelledby="cta-title" class="site-container relative py-24 text-center lg:py-40">
			<h2 id="cta-title" class="display-hero mx-auto max-w-4xl text-fg" data-split-scroll>{cta.title}</h2>
			<p class="lead mx-auto mt-6 max-w-xl">{cta.lead}</p>
		</section>
	</main>
	<LandingFooter />
</Base>

<script>
	import { start } from "../../landing/classic";
	start();
</script>
