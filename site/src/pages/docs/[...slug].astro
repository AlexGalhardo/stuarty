---
import DocPage from "@/src/components/DocPage.astro";
import { getAllDocs, getDoc } from "@/lib/content";

export function getStaticPaths() {
	return getAllDocs("en").map((doc) => ({ params: { slug: doc.slug.join("/") } }));
}

const doc = getDoc("en", Astro.params.slug?.split("/") ?? []);
if (!doc) throw new Error(`missing doc ${Astro.params.slug}`);
---

<DocPage doc={doc} />
