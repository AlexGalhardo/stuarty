---
// The landing page, "The studio in takes" (brainstorming section 5.1, chosen by the author): a full-screen experience
// with no scrollbar on a large screen. Each wheel step, swipe, arrow or Page Down moves to the next take; in the
// timeline take they move the playhead first. On a small screen, with no script, the page is a normal scroll.
import "@/src/landing/landing.css";
import Base from "../layouts/Base.astro";
import { landing } from "@/lib/landing";
import FontPreload from "../components/landing/FontPreload.astro";
import DriveTabs from "../components/landing/DriveTabs.astro";
import LandingFooter from "../components/landing/LandingFooter.astro";
import LandingActions from "../components/landing/LandingActions.astro";
import Shot from "../components/landing/Shot.astro";
import SplitTitle from "../components/landing/SplitTitle.astro";
import StageCanvas from "../components/landing/StageCanvas.astro";
import TimelineEditor from "../components/landing/TimelineEditor.astro";
import { credits, hero, homeTimeline, homeYours, shots } from "@/lib/landing-pages";
import { withBase } from "@/lib/site";

---

<Base title={landing.title} description={landing.description} canonical="/" headerVariant="landing">
	<FontPreload slot="head" />
	<script is:inline>
		(function () {
			var big = matchMedia("(min-width: 64rem) and (min-height: 45rem)").matches;
			if (big) document.documentElement.classList.add("takes-on", "timeline-on");
			if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("motion-ok");
		})();
	</script>
	<main id="content" data-expressive data-page="viewport" class="relative isolate">
		<a href={withBase("/docs/introduction/")} class="sr-only focus:not-sr-only focus:fixed focus:top-[calc(var(--header-h)+0.75rem)] focus:left-4 focus:z-50 focus:rounded-lg focus:bg-bg focus:px-4 focus:py-2 focus:text-sm focus:font-medium">Skip to the docs</a>

		<div class="pointer-events-none fixed inset-0 -z-10">
			<StageCanvas id="viewport-stage" mascot={false} />
		</div>


		<p class="take-hint" aria-hidden="true" data-hint>Scroll, swipe or press <kbd>&darr;</kbd></p>

		<!-- Take 1: one place -->
		<section id="studio" class="take" aria-labelledby="studio-title" data-take>
			<div class="site-container">
				<div class="grid items-center gap-10 lg:grid-cols-5">
					<div class="lg:col-span-2">
						<p class="eyebrow" data-hero-item>{hero.eyebrow}</p>
						<SplitTitle text={hero.homeTitle} id="studio-title" tabindex="-1" class="display-home mt-5 text-fg" />
						<p class="lead mt-6 max-w-xl" data-hero-item>{hero.lead}</p>
					</div>
					<div class="lg:col-span-3" data-hero-frame>
						<figure class="showcase theme-swap m-0" aria-label="The Stuarty home, in the light and the dark theme">
							<Shot shot={shots.dashboardLight} eager sizes="(min-width: 64rem) 52rem, 100vw" class="shot-light" />
							<Shot shot={shots.dashboard} sizes="(min-width: 64rem) 52rem, 100vw" class="shot-dark" />
						</figure>
					</div>
				</div>
				<div class="mt-10 lg:mt-12" data-hero-item>
					<LandingActions idPrefix="hero" align="center" beta={false} />
				</div>
			</div>
		</section>

		<!-- Take 2: the timeline (the scroll, the wheel or the arrows move the playhead) -->
		<section id="timeline" class="take take-timeline" aria-labelledby="timeline-title" data-take data-editor>
			<h2 id="timeline-title" tabindex="-1" class="sr-only">The studio, clip by clip</h2>
			<TimelineEditor headingLevel="h3" clips={homeTimeline} log={null} labels={false} captionClip="edit" trimClip="edit" outro={false} themeSwap />
		</section>

		<!-- Take 3: agents drive it too -->
		<section id="agents" class="take" aria-labelledby="agents-title" data-take>
			<div class="site-container">
				<h2 id="agents-title" tabindex="-1" class="display-title max-w-3xl text-fg" data-in>Agents drive it too.</h2>
				<p class="lead mt-4 max-w-2xl" data-in>The editor, the CLI, the HTTP API and MCP are thin doors to one command core, tested for parity.</p>
				<div data-in>
					<DriveTabs idPrefix="viewport" class="mt-8" />
				</div>
			</div>
		</section>

		<!-- Take 4: open source, on your machine -->
		<section id="yours" class="take" aria-labelledby="yours-title" data-take>
			<div class="site-container text-center">
				<h2 id="yours-title" tabindex="-1" class="yours-lines mx-auto text-fg" data-in>
					{homeYours.lines.map((line) => <span class="block">{line}</span>)}
				</h2>
				<div class="mt-10" data-in>
					<LandingActions idPrefix="take" align="center" beta={false} />
				</div>
				<p class="take-credits mt-8 text-xs text-muted" data-in>{credits}</p>
			</div>
		</section>
	</main>
	<LandingFooter beta={false} />
</Base>

<style is:global>
	/* The five closing lines, one each, sized so the take fits a 720 px high window. */
	main[data-page="viewport"] .yours-lines {
		font-size: clamp(1.75rem, 1.2rem + 2vw, 3rem);
		font-weight: 600;
		line-height: 1.1;
		letter-spacing: -0.03em;
	}
	/* Takes mode: one take fills the viewport, the others wait off stage (no scrollbar). */
	html.takes-on,
	html.takes-on body {
		height: 100%;
		overflow: hidden;
		overscroll-behavior: none;
	}
	html.takes-on .landing-footer {
		display: none;
	}
	html.takes-on .take {
		position: fixed;
		inset: var(--header-h) 0 0 0;
		display: flex;
		align-items: center;
		visibility: hidden;
		opacity: 0;
	}
	html.takes-on .take[data-active] {
		visibility: visible;
		opacity: 1;
	}
	html:not(.takes-on) .take {
		position: relative;
		display: flex;
		align-items: center;
		min-height: 100svh;
		padding-block: calc(var(--header-h) + 3rem) 4rem;
	}
	/* One frame for every screenshot of the home: 16:10, the size of the video editor capture, never stretched. In
	   the takes the hero picture and the timeline pictures share one width, the smaller of 3/5 of the container and
	   what the height of the window leaves above the tracks. */
	main[data-page="viewport"] {
		--shot-w: min(
			calc((min(100vw, var(--site-container)) - 60px - 2.5rem) * 0.6),
			calc((100svh - var(--header-h) - 22rem) * 1.6)
		);
	}
	main[data-page="viewport"] .showcase {
		aspect-ratio: 16 / 10;
		overflow: hidden;
	}
	main[data-page="viewport"] .showcase img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top left;
	}
	html.takes-on main[data-page="viewport"] .showcase {
		width: var(--shot-w);
		max-width: 100%;
		max-height: none;
		margin-inline-start: auto;
	}
	html.timeline-on main[data-page="viewport"] .preview-media img {
		max-height: none;
	}
	html.timeline-on main[data-page="viewport"] .preview-item {
		column-gap: 2.5rem;
	}

	/* The features of each screen of the timeline: a short list under the lead. */
	main[data-page="viewport"] .preview-features {
		display: grid;
		gap: 0.375rem;
		margin: 1.25rem 0 0;
		padding: 0;
		list-style: none;
		font-size: 0.9375rem;
		line-height: 1.45;
		color: var(--lead);
	}
	main[data-page="viewport"] .preview-features li {
		position: relative;
		padding-inline-start: 1.125rem;
	}
	main[data-page="viewport"] .preview-features li::before {
		content: "";
		position: absolute;
		inset-inline-start: 0;
		top: 0.55em;
		width: 0.375rem;
		height: 0.375rem;
		border-radius: 2px;
		background: var(--brand-text);
	}

	/* On short windows the text of a clip tightens so it stays above the tracks. */
	@media (max-height: 52rem) {
		html.timeline-on main[data-page="viewport"] .preview-text .display-title {
			font-size: clamp(1.625rem, 4.6vh, 2.25rem);
		}
		html.timeline-on main[data-page="viewport"] .preview-text .lead {
			margin-top: 0.5rem;
			font-size: 0.9375rem;
			line-height: 1.45;
		}
		html.timeline-on main[data-page="viewport"] .preview-features {
			margin-top: 0.625rem;
			gap: 0.125rem;
			font-size: 0.8125rem;
			line-height: 1.35;
		}
	}

	/* The first take keeps the bottom free for the scroll hint; on short windows the hero tightens so its buttons
	   stay above it. */
	html.takes-on #studio {
		padding-bottom: 4rem;
	}
	@media (max-height: 52rem) {
		html.takes-on #studio .display-home {
			font-size: clamp(2rem, 6.2vh, 3.5rem);
		}
		html.takes-on #studio .lead {
			margin-top: 1rem;
		}
		html.takes-on #studio [data-hero-item]:has(.landing-actions) {
			margin-top: 1.5rem;
		}
	}
	html:not(.takes-on) .take-hint,
	html:not(.takes-on) .take-credits {
		display: none;
	}

	/* The product screenshots of the home keep almost square corners (frame and image together), so the corners of
	   the UI inside them are not cut off. */
	main[data-page="viewport"] .showcase,
	main[data-page="viewport"] .showcase img {
		border-radius: 5px;
	}

	/* The timeline take fills the screen under the header: its title, then the editor. */
	html.takes-on .take-timeline {
		display: flex;
		flex-direction: column;
		align-items: stretch;
	}
	html.takes-on .take-timeline .editor-frame {
		flex: 1 1 auto;
		min-height: 0;
		height: auto;
		padding-top: 0;
	}
	html:not(.takes-on) .take-timeline {
		display: block;
	}

	/* The home of the product in both themes, crossfading every 3 seconds; one still image under reduced motion. */
	.theme-swap {
		position: relative;
	}
	.theme-swap .shot-dark {
		position: absolute;
		inset: 0;
		animation: theme-swap 6s ease-in-out infinite;
	}
	@keyframes theme-swap {
		0%,
		40% {
			opacity: 0;
		}
		50%,
		90% {
			opacity: 1;
		}
		100% {
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.theme-swap .shot-dark {
			animation: none !important;
			opacity: 0;
		}
		.dark .theme-swap .shot-dark {
			opacity: 1;
		}
	}

	/* A take heading takes the focus only to move the reading position; it is not a control, so no ring. */
	html.takes-on .take h1[tabindex="-1"]:focus-visible,
	html.takes-on .take h2[tabindex="-1"]:focus-visible {
		outline: none;
	}

	/* The way on: larger, bold, in the brand text colour (8.4:1 light, 10.1:1 dark), with the arrow key bouncing in
	   a soft brand glow; still under reduced motion. */
	.take-hint {
		position: fixed;
		bottom: 1.25rem;
		left: 50%;
		z-index: 30;
		display: flex;
		align-items: center;
		gap: 0.625rem;
		transform: translateX(-50%);
		font-size: 0.9375rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--brand-text);
		transition: opacity 400ms;
	}
	.take-hint kbd {
		display: inline-grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		font-family: var(--font-mono);
		font-size: 1rem;
		border: 1.5px solid var(--brand-text);
		border-radius: 8px;
		background: var(--bg);
		animation:
			hint-bounce 1.6s var(--ease-out-expo) infinite,
			hint-glow 1.6s ease-in-out infinite;
	}
	@keyframes hint-bounce {
		0%,
		100% {
			transform: translateY(0);
		}
		40% {
			transform: translateY(5px);
		}
	}
	@keyframes hint-glow {
		0%,
		100% {
			box-shadow: 0 0 0 0 color-mix(in oklab, var(--brand-accent) 0%, transparent);
		}
		50% {
			box-shadow: 0 0 0 6px color-mix(in oklab, var(--brand-accent) 28%, transparent);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.take-hint kbd {
			animation: none !important;
			box-shadow: 0 0 0 4px color-mix(in oklab, var(--brand-accent) 24%, transparent);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		/* The global reduced-motion rule gives every element a tiny transition; on a take switching from hidden to
		   visible it would delay the visibility its heading needs to take the focus. */
		html.takes-on .take,
		html.takes-on .take * {
			transition: none !important;
		}
	}
</style>

<script>
	import { start } from "../landing/viewport";
	start();
</script>
