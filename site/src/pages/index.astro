---
// The landing page, "The studio in takes" (brainstorming section 5.1, chosen by the author): a full-screen experience
// with no scrollbar on a large screen. Each wheel step, swipe, arrow or Page Down moves to the next take; in the
// timeline take they move the playhead first. On a small screen, with no script, the page is a normal scroll.
import "@/src/landing/landing.css";
import Base from "../layouts/Base.astro";
import { landing } from "@/lib/landing";
import FontPreload from "../components/landing/FontPreload.astro";
import DriveTabs from "../components/landing/DriveTabs.astro";
import LandingActions from "../components/landing/LandingActions.astro";
import Shot from "../components/landing/Shot.astro";
import HeroTyper from "../components/landing/HeroTyper.astro";
import StageCanvas from "../components/landing/StageCanvas.astro";
import TimelineEditor from "../components/landing/TimelineEditor.astro";
import { credits, hero, homeTimeline, homeYours, shots } from "@/lib/landing-pages";
import { withBase } from "@/lib/site";

---

<Base title={landing.title} description={landing.description} canonical="/" headerVariant="landing">
	<FontPreload slot="head" />
	<script is:inline>
		(function () {
			var big = matchMedia("(min-width: 64rem) and (min-height: 45rem)").matches;
			if (big) document.documentElement.classList.add("takes-on", "timeline-on");
			if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("motion-ok");
		})();
	</script>
	<!-- The second row of the navbar, on the home only: the six actions, fixed with the navbar. -->
	<nav class="nav-actions" aria-label="Get Stuarty">
		<div class="site-container nav-actions-inner">
			<LandingActions idPrefix="nav" beta={false} compact />
		</div>
	</nav>
	<main id="content" data-expressive data-page="viewport" class="relative isolate">
		<a href={withBase("/docs/introduction/")} class="sr-only focus:not-sr-only focus:fixed focus:top-[calc(var(--header-h)+0.75rem)] focus:left-4 focus:z-50 focus:rounded-lg focus:bg-bg focus:px-4 focus:py-2 focus:text-sm focus:font-medium">Skip to the docs</a>

		<div class="pointer-events-none fixed inset-0 -z-10">
			<StageCanvas id="viewport-stage" mascot={false} />
		</div>


		<p class="take-hint" aria-hidden="true" data-hint>Scroll, swipe or press <kbd>&darr;</kbd></p>

		<!-- Take 1: one place -->
		<section id="studio" class="take" aria-labelledby="studio-title" data-take>
			<div class="site-container">
				<div class="grid items-center gap-10 lg:grid-cols-5">
					<div class="lg:col-span-2">
						<p class="eyebrow" data-hero-item>{hero.eyebrow}</p>
						<HeroTyper phrases={hero.homeTitles} id="studio-title" tabindex="-1" class="display-typer mt-5 text-fg" />
						<p class="lead mt-6 max-w-xl" data-hero-item>{hero.homeLead}</p>
					</div>
					<div class="lg:col-span-3" data-hero-frame>
						<figure class="showcase theme-swap m-0" aria-label="The Stuarty home, in the light and the dark theme">
							<Shot shot={shots.dashboardLight} eager sizes="(min-width: 64rem) 52rem, 100vw" class="shot-light" />
							<Shot shot={shots.dashboard} sizes="(min-width: 64rem) 52rem, 100vw" class="shot-dark" />
						</figure>
					</div>
				</div>
			</div>
		</section>

		<!-- Take 2: the timeline (the scroll, the wheel or the arrows move the playhead) -->
		<section id="timeline" class="take take-timeline" aria-labelledby="timeline-title" data-take data-editor>
			<h2 id="timeline-title" tabindex="-1" class="sr-only">The studio, clip by clip</h2>
			<TimelineEditor headingLevel="h3" clips={homeTimeline} log={null} labels={false} captionClip="edit" trimClip="edit" outro={false} themeSwap flat />
		</section>

		<!-- Take 3: agents drive it too -->
		<section id="agents" class="take" aria-labelledby="agents-title" data-take>
			<div class="site-container">
				<div data-in>
					<DriveTabs idPrefix="viewport" split>
						<h2 id="agents-title" tabindex="-1" class="display-title text-fg">Agents drive it too.</h2>
						<p class="lead mt-4">The editor, the CLI, the HTTP API and MCP are thin doors to one command core, tested for parity.</p>
					</DriveTabs>
				</div>
			</div>
		</section>

		<!-- Take 4: open source, on your machine -->
		<section id="yours" class="take" aria-labelledby="yours-title" data-take>
			<div class="site-container text-center">
				<h2 id="yours-title" tabindex="-1" class="yours-lines mx-auto text-fg" data-in>
					{homeYours.lines.map((line, i) => <span class:list={["block", i === homeYours.lines.length - 1 && "yours-free"]} data-split-skip={i === homeYours.lines.length - 1 ? "" : undefined}>{line}</span>)}
				</h2>
				<div class="take-actions" data-in>
					<LandingActions idPrefix="take" align="center" beta={false} />
				</div>
				<p class="take-credits text-xs text-muted" data-in>{credits}</p>
			</div>
		</section>
	</main>
	<dialog class="shot-zoom" aria-label="Enlarged screenshot" data-zoom-dialog>
		<button type="button" class="shot-zoom-close" aria-label="Close the enlarged screenshot" data-zoom-close>
			<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
		</button>
		<div class="shot-zoom-stage" data-zoom-stage></div>
	</dialog>
</Base>

<style is:global>
	/* The five closing lines, one each, sized so the take fits a 720 px high window. */
	/* The closing lines at about twice the size of the earlier version (88 px against 48 px at 1440), held by the
	   width and the height of the window so they never overflow from 320 px up; each group stays on one line from
	   1280 px. */
	main[data-page="viewport"] .yours-lines {
		font-size: clamp(2.25rem, min(0.5rem + 5.6vw, 9vh), 5.5rem);
		font-weight: 650;
		line-height: 1.04;
		letter-spacing: -0.035em;
		text-wrap: balance;
		overflow-wrap: anywhere;
	}
	/* A blank line between the three lines, as a margin so the heading stays one sentence-like run of text. */
	main[data-page="viewport"] .yours-lines > .block + .block {
		margin-top: 0.75em;
	}
	/* The closing take: the lines close to the navbar, the credit at the bottom edge of the window. */
	/* The four buttons sit in the middle of the space between the lines and the bottom of the window; the credit is
	   laid over that bottom edge, so it does not count in the centring. */
	#yours {
		align-items: stretch;
		padding-bottom: 0;
	}
	html.takes-on #yours {
		padding-top: clamp(1.5rem, 5vh, 3.5rem);
	}
	#yours > .site-container {
		display: flex;
		flex-direction: column;
	}
	#yours .take-actions {
		margin-block: auto;
		padding-block: 3rem;
	}
	/* Below 24rem the credit wraps to two lines: more room under the buttons, the same above to stay centred. */
	@media (max-width: 24rem) {
		#yours .take-actions {
			padding-block: 3.75rem;
		}
	}
	#yours .take-credits {
		position: absolute;
		inset-inline: 1rem;
		bottom: 0.75rem;
		margin: 0;
	}
	/* "Free. Forever.": orange to pink text, darker stops on the light page (3.6:1 and 5.1:1 on white), brighter on
	   the dark one (8.5:1 and 5.5:1), with a slow shimmer that stops under reduced motion. */
	main[data-page="viewport"] .yours-free {
		--free-a: #e85600;
		--free-b: #d6006f;
		background: linear-gradient(100deg, var(--free-a) 0%, var(--free-b) 45%, var(--free-a) 90%) 0 0 / 200% 100%;
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		animation: free-shimmer 6s ease-in-out infinite alternate;
	}
	.dark main[data-page="viewport"] .yours-free {
		--free-a: #ff8c1e;
		--free-b: #ff1f8e;
	}
	@keyframes free-shimmer {
		to {
			background-position: 100% 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		main[data-page="viewport"] .yours-free {
			animation: none;
		}
	}
	@media (forced-colors: active) {
		main[data-page="viewport"] .yours-free {
			background: none;
			color: CanvasText;
		}
	}
	/* Takes mode: one take fills the viewport, the others wait off stage (no scrollbar). */
	html.takes-on,
	html.takes-on body {
		height: 100%;
		overflow: hidden;
		overscroll-behavior: none;
	}
	html.takes-on .take {
		position: fixed;
		inset: var(--header-h) 0 0 0;
		display: flex;
		align-items: center;
		visibility: hidden;
		opacity: 0;
	}
	html.takes-on .take[data-active] {
		visibility: visible;
		opacity: 1;
	}
	html:not(.takes-on) .take {
		position: relative;
		display: flex;
		align-items: center;
		min-height: 100svh;
		padding-block: calc(var(--header-h) + 3rem) 4rem;
	}
	/* One frame for every screenshot of the home: 16:10, the size of the video editor capture, never stretched. In
	   the takes the hero picture and the timeline pictures share one width, the smaller of 3/5 of the container and
	   what the height of the window leaves above the tracks. */
	main[data-page="viewport"] {
		--shot-w: min(
			calc((min(100vw, var(--site-container)) - 60px - 2.5rem) * 0.6),
			calc((100svh - var(--header-h) - 22rem) * 1.6)
		);
	}
	main[data-page="viewport"] .showcase {
		aspect-ratio: 16 / 10;
		overflow: hidden;
	}
	main[data-page="viewport"] .showcase img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top left;
	}
	html.takes-on main[data-page="viewport"] .showcase {
		width: var(--shot-w);
		max-width: 100%;
		max-height: none;
		margin-inline-start: auto;
	}
	html.timeline-on main[data-page="viewport"] .preview-media img {
		max-height: none;
	}
	html.timeline-on main[data-page="viewport"] .preview-item {
		column-gap: 2.5rem;
	}

	/* A product picture opens enlarged (src/landing/zoom.ts): it shows that it can be clicked. */
	main[data-page="viewport"] .showcase[data-zoomable] {
		cursor: zoom-in;
	}
	main[data-page="viewport"] .showcase[data-zoomable]:focus-visible {
		outline: 2px solid var(--brand-text);
		outline-offset: 4px;
	}
	html:has(.shot-zoom[open]) {
		overflow: hidden;
	}
	.shot-zoom {
		position: fixed;
		inset: 0;
		width: fit-content;
		height: fit-content;
		margin: auto;
		max-width: none;
		max-height: none;
		padding: 0;
		border: 0;
		background: transparent;
		overflow: visible;
	}
	.shot-zoom::backdrop {
		background: oklch(0.12 0.02 272 / 82%);
	}
	.shot-zoom-stage img {
		display: block;
		width: min(94vw, 1600px, calc((100dvh - 4rem) * 1.6));
		height: auto;
		aspect-ratio: 16 / 10;
		border-radius: 6px;
		box-shadow: 0 30px 80px -20px oklch(0 0 0 / 60%);
	}
	.shot-zoom-close {
		position: absolute;
		top: 0.75rem;
		right: 0.75rem;
		z-index: 1;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 1px solid oklch(1 0 0 / 25%);
		border-radius: 999px;
		background: oklch(0.2 0 0 / 70%);
		color: oklch(1 0 0);
		cursor: pointer;
	}
	.shot-zoom-close:hover {
		background: oklch(0.3 0 0 / 85%);
	}
	.shot-zoom-close:focus-visible {
		outline: 2px solid oklch(1 0 0);
		outline-offset: 3px;
	}
	.shot-zoom[open] {
		animation: shot-zoom-in 0.32s var(--ease-out-expo) both;
	}
	.shot-zoom[open]::backdrop {
		animation: shot-zoom-fade 0.32s ease-out both;
	}
	@keyframes shot-zoom-in {
		from {
			opacity: 0;
			transform: scale(0.9);
		}
	}
	@keyframes shot-zoom-fade {
		from {
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.shot-zoom[open],
		.shot-zoom[open]::backdrop {
			animation: none;
		}
	}

	/* The features of each screen of the timeline: a short list under the lead. */
	main[data-page="viewport"] .preview-features {
		display: grid;
		gap: 0.375rem;
		margin: 1.25rem 0 0;
		padding: 0;
		list-style: none;
		font-size: 0.9375rem;
		line-height: 1.45;
		color: var(--lead);
	}
	main[data-page="viewport"] .preview-features li {
		position: relative;
		padding-inline-start: 1.125rem;
	}
	main[data-page="viewport"] .preview-features li::before {
		content: "";
		position: absolute;
		inset-inline-start: 0;
		top: 0.55em;
		width: 0.375rem;
		height: 0.375rem;
		border-radius: 2px;
		background: var(--brand-text);
	}

	/* On short windows the text of a clip tightens so it stays above the tracks. */
	/* Short and narrow windows hold the buttons in two rows: the hero title gives up a little size. */
	@media (max-height: 52rem) and (max-width: 79.99rem) {
		html main[data-page="viewport"] .display-typer {
			font-size: clamp(1.75rem, 4.6vh, 3rem);
		}
	}
	@media (max-height: 52rem) {
		html.timeline-on main[data-page="viewport"] .preview-text .display-title {
			font-size: clamp(1.625rem, 4.6vh, 2.25rem);
		}
		html.timeline-on main[data-page="viewport"] .preview-text .lead {
			margin-top: 0.5rem;
			font-size: 0.9375rem;
			line-height: 1.45;
		}
		html.timeline-on main[data-page="viewport"] .preview-features {
			margin-top: 0.625rem;
			gap: 0.125rem;
			font-size: 0.8125rem;
			line-height: 1.35;
		}
	}

	/* The hero sits close to the navbar. */
	html.takes-on #studio {
		align-items: stretch;
		padding-top: clamp(1.5rem, 4vh, 3rem);
	}
	/* The typed hero title: its height is the longest of the three phrases, so it is sized a step below the earlier
	   title, and held by the window height on short screens. */
	main[data-page="viewport"] .display-typer {
		font-size: clamp(1.75rem, min(0.9rem + 2.3vw, 5.6vh), 3rem);
		line-height: 1.08;
		font-weight: 600;
		letter-spacing: -0.03em;
		text-wrap: pretty;
	}
	/* The home navbar has a second row with the six actions: the header offset of every take counts both rows. */
	html:has(main[data-page="viewport"][data-expressive]) {
		--nav1-h: 70px;
		--nav2-h: 3.5rem;
		--header-h: calc(var(--nav1-h) + var(--nav2-h));
	}
	@media (max-width: 767px) {
		html:has(main[data-page="viewport"][data-expressive]) {
			--nav1-h: 52.5px;
		}
	}
	.nav-actions {
		position: fixed;
		top: var(--nav1-h);
		inset-inline: 0;
		z-index: 39;
		height: var(--nav2-h);
		border-bottom: 1px solid color-mix(in oklab, var(--fg) 10%, transparent);
		background: color-mix(in oklab, var(--bg) 70%, transparent);
		backdrop-filter: blur(24px);
	}
	.nav-actions-inner {
		height: 100%;
	}

	/* The first take keeps the bottom free for the scroll hint; on short windows the hero tightens so its buttons
	   stay above it. */
	html.takes-on #studio {
		padding-bottom: 3.5rem;
	}
	@media (max-height: 52rem) {
		html.takes-on #studio .lead {
			margin-top: 1rem;
		}
	}
	html:not(.takes-on) .take-hint {
		display: none;
	}

	/* The product screenshots of the home keep almost square corners (frame and image together), so the corners of
	   the UI inside them are not cut off. */
	main[data-page="viewport"] .showcase,
	main[data-page="viewport"] .showcase img {
		border-radius: 5px;
	}

	/* The timeline take fills the screen under the header: its title, then the editor. */
	html.takes-on .take-timeline {
		display: flex;
		flex-direction: column;
		align-items: stretch;
	}
	html.takes-on .take-timeline .editor-frame {
		flex: 1 1 auto;
		min-height: 0;
		height: auto;
		padding-top: 0;
	}
	html:not(.takes-on) .take-timeline {
		display: block;
	}

	/* The home of the product in both themes, crossfading every 3 seconds; one still image under reduced motion. */
	.theme-swap {
		position: relative;
	}
	.theme-swap .shot-dark {
		position: absolute;
		inset: 0;
		animation: theme-swap 6s ease-in-out infinite;
	}
	@keyframes theme-swap {
		0%,
		40% {
			opacity: 0;
		}
		50%,
		90% {
			opacity: 1;
		}
		100% {
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.theme-swap .shot-dark {
			animation: none !important;
			opacity: 0;
		}
		.dark .theme-swap .shot-dark {
			opacity: 1;
		}
	}

	/* A take heading takes the focus only to move the reading position; it is not a control, so no ring. */
	html.takes-on .take h1[tabindex="-1"]:focus-visible,
	html.takes-on .take h2[tabindex="-1"]:focus-visible {
		outline: none;
	}

	/* The way on: larger, bold, in the brand text colour (8.4:1 light, 10.1:1 dark), with the arrow key bouncing in
	   a soft brand glow; still under reduced motion. */
	.take-hint {
		position: fixed;
		bottom: 1.25rem;
		left: 50%;
		z-index: 30;
		display: flex;
		align-items: center;
		gap: 0.625rem;
		transform: translateX(-50%);
		font-size: 0.9375rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--brand-text);
		transition: opacity 400ms;
	}
	.take-hint kbd {
		display: inline-grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		font-family: var(--font-mono);
		font-size: 1rem;
		border: 1.5px solid var(--brand-text);
		border-radius: 8px;
		background: var(--bg);
		animation:
			hint-bounce 1.6s var(--ease-out-expo) infinite,
			hint-glow 1.6s ease-in-out infinite;
	}
	@keyframes hint-bounce {
		0%,
		100% {
			transform: translateY(0);
		}
		40% {
			transform: translateY(5px);
		}
	}
	@keyframes hint-glow {
		0%,
		100% {
			box-shadow: 0 0 0 0 color-mix(in oklab, var(--brand-accent) 0%, transparent);
		}
		50% {
			box-shadow: 0 0 0 6px color-mix(in oklab, var(--brand-accent) 28%, transparent);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.take-hint kbd {
			animation: none !important;
			box-shadow: 0 0 0 4px color-mix(in oklab, var(--brand-accent) 24%, transparent);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		/* The global reduced-motion rule gives every element a tiny transition; on a take switching from hidden to
		   visible it would delay the visibility its heading needs to take the focus. */
		html.takes-on .take,
		html.takes-on .take * {
			transition: none !important;
		}
	}
</style>

<script>
	import { start } from "../landing/viewport";
	import { mountTyper } from "../landing/typer";
	import { mountZoom } from "../landing/zoom";
	start();
	mountZoom();
	mountTyper();
</script>
