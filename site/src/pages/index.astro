---
// The landing page (epic 88): a calm page that tells a creator, in a few seconds, what Stuarty is and what it is not
// yet. Sections: hero, one path, agent transparency, a text is a project, areas, agents, privacy, downloads and "On
// the roadmap". The copy and its claims are in src/landing/content.ts and checked against the roadmap by its test.
// The screens of epic 79 (home, projects, briefing) are slots until that epic is merged.
import "@/src/landing/landing.css";
import "@/src/landing/home.css";
import Base from "../layouts/Base.astro";
import { landing } from "@/lib/landing";
import { shots } from "@/lib/landing-pages";
import { agents, areas, capturedNote, credits, downloads, hero, path, privacy, roadmap, textProject, transparency } from "@/src/landing/content";
import DriveTabs from "../components/landing/DriveTabs.astro";
import LandingActions from "../components/landing/LandingActions.astro";
import ScreenSlot from "../components/landing/ScreenSlot.astro";
import ThemedShot from "../components/landing/ThemedShot.astro";
import { withBase } from "@/lib/site";

const stepShots = { writing: shots.writing, videoEditor: shots.videoEditor, imageEditor: shots.imageEditor, approvals: shots.approvals, calendar: shots.calendar };
---

<Base title={landing.title} description={landing.description} canonical="/" headerVariant="landing">
	<main id="content" data-expressive data-page="home" class="home relative isolate overflow-x-clip">
		<!-- 1. Hero -->
		<section aria-labelledby="hero-title" class="home-section home-hero">
			<div class="site-container grid items-center gap-12 lg:grid-cols-12">
				<div class="lg:col-span-5">
					<p class="eyebrow">{hero.eyebrow}</p>
					<h1 id="hero-title" class="display-home mt-5 text-fg">{hero.title}</h1>
					<p class="lead mt-6 max-w-xl">{hero.lead}</p>
					<ul class="home-facts mt-6" aria-label="What Stuarty is">
						{hero.facts.map((f) => <li>{f}</li>)}
					</ul>
					<div class="mt-8 flex flex-wrap gap-3">
						<a class="btn btn-brand" href={withBase("/docs/guide/first-short-video/")}>Make your first short</a>
						<a class="btn btn-outline" href="#download">Download</a>
					</div>
				</div>
				<div class="lg:col-span-7">
					<figure class="showcase home-frame m-0">
						<ThemedShot shot={shots.videoEditor} eager sizes="(min-width: 64rem) 52rem, 100vw" />
					</figure>
				</div>
			</div>
		</section>

		<!-- 2. One path -->
		<section id="path" aria-labelledby="path-title" class="home-section">
			<div class="site-container">
				<div class="home-head">
					<p class="eyebrow">{path.eyebrow}</p>
					<h2 id="path-title" class="display-title mt-4 text-fg">{path.title}</h2>
					<p class="lead mt-5 max-w-2xl">{path.lead}</p>
				</div>
				<ol class="home-steps">
					{path.steps.map((s, i) => (
						<li class="home-step" aria-labelledby={`step-${s.id}`}>
							<div class="home-step-text">
								<p class="home-step-n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</p>
								<h3 id={`step-${s.id}`} class="home-h3">{s.title}</h3>
								<p class="home-p">{s.text}</p>
							</div>
							<figure class="showcase home-frame m-0">
								{s.screen.kind === "shot" ? (
									<ThemedShot shot={stepShots[s.screen.shot]} sizes="(min-width: 64rem) 36rem, 100vw" />
								) : (
									<ScreenSlot slot={s.screen.slot} />
								)}
							</figure>
						</li>
					))}
				</ol>
			</div>
		</section>

		<!-- 3. Agent transparency -->
		<section id="transparency" aria-labelledby="transparency-title" class="home-section home-band">
			<div class="site-container grid items-center gap-12 lg:grid-cols-12">
				<div class="lg:col-span-5">
					<p class="eyebrow">{transparency.eyebrow}</p>
					<h2 id="transparency-title" class="display-title mt-4 text-fg">{transparency.title}</h2>
					<p class="lead mt-5">{transparency.lead}</p>
					<dl class="home-defs mt-8">
						{transparency.points.map((p) => (
							<div>
								<dt class="home-h3">{p.title}</dt>
								<dd class="home-p">{p.text}</dd>
							</div>
						))}
					</dl>
				</div>
				<div class="grid gap-6 lg:col-span-7">
					<figure class="showcase home-frame m-0"><ThemedShot shot={shots.agentChat} sizes="(min-width: 64rem) 46rem, 100vw" /></figure>
					<figure class="showcase home-frame m-0"><ThemedShot shot={shots.approvals} sizes="(min-width: 64rem) 46rem, 100vw" /></figure>
				</div>
			</div>
		</section>

		<!-- 4. A text is a complete project -->
		<section id="text" aria-labelledby="text-title" class="home-section">
			<div class="site-container grid items-center gap-12 lg:grid-cols-12">
				<div class="lg:order-2 lg:col-span-5">
					<p class="eyebrow">{textProject.eyebrow}</p>
					<h2 id="text-title" class="display-title mt-4 text-fg">{textProject.title}</h2>
					<p class="lead mt-5">{textProject.lead}</p>
					<ul class="home-checks mt-6">
						{textProject.points.map((p) => <li>{p}</li>)}
					</ul>
				</div>
				<div class="lg:order-1 lg:col-span-7">
					<figure class="showcase home-frame m-0"><ThemedShot shot={shots.writing} sizes="(min-width: 64rem) 46rem, 100vw" /></figure>
				</div>
			</div>
		</section>

		<!-- 5. Areas -->
		<section id="areas" aria-labelledby="areas-title" class="home-section home-band">
			<div class="site-container">
				<div class="home-head">
					<p class="eyebrow">{areas.eyebrow}</p>
					<h2 id="areas-title" class="display-title mt-4 text-fg">{areas.title}</h2>
				</div>
				<figure class="showcase home-frame home-wide m-0">
					<ScreenSlot slot="home" />
				</figure>
				<ul class="home-cards">
					{areas.items.map((a) => (
						<li class="home-card">
							<h3 class="home-h3">{a.title}</h3>
							<p class="home-p">{a.text}</p>
						</li>
					))}
				</ul>
			</div>
		</section>

		<!-- 6. Agents -->
		<section id="agents" aria-labelledby="agents-title" class="home-section">
			<div class="site-container">
				<div class="home-head">
					<p class="eyebrow">{agents.eyebrow}</p>
					<h2 id="agents-title" class="display-title mt-4 text-fg">{agents.title}</h2>
					<p class="lead mt-5 max-w-2xl">{agents.lead}</p>
				</div>
				<DriveTabs idPrefix="home" class="mt-10" />
			</div>
		</section>

		<!-- 7. Privacy -->
		<section id="privacy" aria-labelledby="privacy-title" class="home-section home-band">
			<div class="site-container">
				<div class="home-head">
					<p class="eyebrow">{privacy.eyebrow}</p>
					<h2 id="privacy-title" class="display-title mt-4 text-fg">{privacy.title}</h2>
				</div>
				<ul class="home-cards home-cards-3">
					{privacy.points.map((p) => (
						<li class="home-card">
							<h3 class="home-h3">{p.title}</h3>
							<p class="home-p">{p.text}</p>
						</li>
					))}
				</ul>
			</div>
		</section>

		<!-- 8. Downloads -->
		<section id="download" aria-labelledby="download-title" class="home-section">
			<div class="site-container text-center">
				<p class="eyebrow">{downloads.eyebrow}</p>
				<h2 id="download-title" class="display-title mx-auto mt-4 text-fg">{downloads.title}</h2>
				<p class="lead mx-auto mt-5 max-w-xl">{downloads.lead}</p>
				<div class="mt-10">
					<LandingActions idPrefix="home" align="center" />
				</div>
			</div>
		</section>

		<!-- 9. On the roadmap: the only place for what is not released -->
		<section id="roadmap" aria-labelledby="roadmap-title" class="home-section home-band">
			<div class="site-container">
				<div class="home-head">
					<p class="eyebrow">{roadmap.eyebrow}</p>
					<h2 id="roadmap-title" class="display-title mt-4 text-fg">{roadmap.title}</h2>
					<p class="lead mt-5 max-w-2xl">{roadmap.lead}</p>
				</div>
				<ul class="home-cards home-cards-3">
					{roadmap.items.map((r) => (
						<li class="home-card" data-state={r.state}>
							<p class="home-state">{roadmap.stateLabel[r.state]}</p>
							<h3 class="home-h3">{r.title}</h3>
							<p class="home-p">{r.text}</p>
						</li>
					))}
				</ul>
			</div>
		</section>
	</main>
	<footer class="home-footer">
		<div class="site-container">
			<p>{capturedNote}</p>
			<p>{credits}</p>
			<p><a href={withBase("/docs/introduction/")}>Documentation</a> · <a href={withBase("/changelog/")}>Changelog</a></p>
		</div>
	</footer>
</Base>

<script>
	import { enhanceTabs } from "../landing/tabs";
	enhanceTabs(document);
</script>
