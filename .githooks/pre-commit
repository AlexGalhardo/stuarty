#!/usr/bin/env bash
# Mirrors the jobs of vukem's lefthook pre-commit (SDD-009 section 15.1):
# format and lint the staged Go files, tidy check on go.mod or go.sum changes,
# markdownlint on staged Markdown, Biome on staged web files.
# Activate with `task hooks` (git config core.hooksPath .githooks).
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Checks only: nothing is rewritten, so unstaged edits are never touched.
staged() {
	git diff --cached --name-only --diff-filter=ACMR -- "$@"
}

mapfile -t go_files < <(staged '*.go')
mapfile -t md_files < <(staged '*.md')
mapfile -t web_files < <(staged 'web/resources/js' 'web/e2e')

if [ "${#go_files[@]}" -gt 0 ]; then
	golangci-lint fmt --diff "${go_files[@]}"
	golangci-lint run --allow-parallel-runners --new-from-rev=HEAD ./...
fi

if [ -n "$(staged go.mod go.sum)" ]; then
	go mod tidy -diff
fi

if [ "${#md_files[@]}" -gt 0 ]; then
	bunx markdownlint-cli2@0.24.1 "${md_files[@]}"
fi

if [ "${#web_files[@]}" -gt 0 ]; then
	(cd web && bun run lint)
fi
