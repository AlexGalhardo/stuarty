#!/usr/bin/env bash
# Regenerates site/content/last-updated.json so the pushed tree never fails the
# "Last updated" check. Git fixed the pushed refs before this hook ran, so a
# refresh commit cannot join this push: it is committed, the push stops, and
# the next `git push` carries it.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
go vet ./...

# The documentation site is copied by SITE-COPY (SDD-010); until then there is nothing to refresh.
[ -d site ] || exit 0
cd site
if [ ! -d node_modules ]; then
	echo "pre-push: run bun install in site/ so the doc dates can be refreshed" >&2
	exit 1
fi

bun run --silent last-updated >/dev/null
if git diff --quiet -- content/last-updated.json; then
	exit 0
fi

git commit -q -m "chore(site): refresh last-updated" -- content/last-updated.json
echo "pre-push: committed the refreshed doc dates (site/content/last-updated.json); run git push again" >&2
exit 1
