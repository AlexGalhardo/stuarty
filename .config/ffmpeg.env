# The one pin of the FFmpeg that Vukem Video distributes (ADR-0011).
# Sourced by .config/docker/vukem-video.Dockerfile and scripts/install-ffmpeg.sh.
# Values are recorded by task REL-FFMPEG-PIN from the release of
# https://github.com/BtbN/FFmpeg-Builds named by FFMPEG_RELEASE_TAG:
# the asset names from the release page, each SHA-256 computed locally with
# sha256sum after downloading the asset, the source commits from the release
# notes and from `ffmpeg -version`.
# Bump only through a pull request that re-runs the image smoke test.
FFMPEG_RELEASE_TAG="autobuild-2026-10-31-12-59"
FFMPEG_VERSION="n9.0.2-39-g7adfbe40dc-20261031"
FFMPEG_BUILDS_COMMIT="5031c6f1082414e53688d39e521849905071070d"
FFMPEG_SOURCE_URL="https://github.com/FFmpeg/FFmpeg/archive/7adfbe40dcde598f93a6963d2f7b22cd75202ccc.tar.gz"
FFMPEG_ASSET_LINUX_AMD64="ffmpeg-n9.0.2-39-g7adfbe40dc-linux64-lgpl-9.0.tar.xz"
FFMPEG_ASSET_LINUX_ARM64="ffmpeg-n9.0.2-39-g7adfbe40dc-linuxarm64-lgpl-9.0.tar.xz"
FFMPEG_ASSET_WINDOWS_AMD64="ffmpeg-n9.0.2-39-g7adfbe40dc-win64-lgpl-9.0.zip"
FFMPEG_SHA256_LINUX_AMD64="6046d6731b26f58887e953561551d254a6eec9fbca4100dfeab56e19af8328d5"
FFMPEG_SHA256_LINUX_ARM64="3d1f66827a73ce5a446312bc4924234dc1515726d3743e2df35c0177e1f82128"
FFMPEG_SHA256_WINDOWS_AMD64="9d37c564e0d01c18cde184a079fa6ef04d7d2783ada41da81d04165cc8f1a650"
# SHA-256 of the extracted binaries, which `doctor --verify` compares with the files on disk
# (SDD-011 section 9). Computed locally from the archives above after their digests matched.
# internal/ffmpegpins/pins_gen.go is generated from these lines: `go generate ./internal/ffmpegpins`.
FFMPEG_BIN_SHA256_LINUX_AMD64="d372f20463a8ffb9eef1675242cdbf9aae19b647503b073fc9b5b1f42b91c94a"
FFPROBE_BIN_SHA256_LINUX_AMD64="9a7f735d3df4f56dd8406cd7a03a227686bec55b1edc496c25bd8b1867e44498"
FFMPEG_BIN_SHA256_LINUX_ARM64="a2b319d2e30d72b462501695af55cab9a81f108b23b4ca1108471702846dfed9"
FFPROBE_BIN_SHA256_LINUX_ARM64="0d48cb4c582e1ab34b2a24800522a18c24ecfaab3b071709b5beb83c6f00db33"
FFMPEG_BIN_SHA256_WINDOWS_AMD64="d03c858a130cae1382902925d9f46eb15d7de42e025d34cc29b7ddca6cfb4c62"
FFPROBE_BIN_SHA256_WINDOWS_AMD64="61d1eef897bfa42306ac4ab36afc6adce23cccce577bda88b84c06d44e1b9183"

# The own LGPL build of D-017 (ADR-0011), built by .github/workflows/ffmpeg-build.yml from
# .config/ffmpeg-build/. While FFMPEG_OWN_TAG is empty no build has been released and the
# BtbN pin above is the one in use. After a release, fill every value below from the
# release assets (the asset names and the SHA-256 of the release notes, the binary digests
# from `sha256sum` of the unpacked files), and set FFMPEG_SOURCE="own". Dockerfile build arg
# FFMPEG_SOURCE and scripts/install-ffmpeg.sh (FFMPEG_SOURCE in the environment) read this
# variable; the default is the value here.
FFMPEG_SOURCE="btbn"
FFMPEG_OWN_TAG=""
FFMPEG_OWN_VERSION=""
FFMPEG_OWN_SOURCE_URL=""
FFMPEG_OWN_SOURCE_SHA256=""
FFMPEG_OWN_ASSET_LINUX_AMD64=""
FFMPEG_OWN_ASSET_LINUX_ARM64=""
FFMPEG_OWN_ASSET_WINDOWS_AMD64=""
FFMPEG_OWN_ASSET_DARWIN_ARM64=""
FFMPEG_OWN_ASSET_DARWIN_AMD64=""
FFMPEG_OWN_SHA256_LINUX_AMD64=""
FFMPEG_OWN_SHA256_LINUX_ARM64=""
FFMPEG_OWN_SHA256_WINDOWS_AMD64=""
FFMPEG_OWN_SHA256_DARWIN_ARM64=""
FFMPEG_OWN_SHA256_DARWIN_AMD64=""
FFMPEG_OWN_BIN_SHA256_LINUX_AMD64=""
FFPROBE_OWN_BIN_SHA256_LINUX_AMD64=""
FFMPEG_OWN_BIN_SHA256_LINUX_ARM64=""
FFPROBE_OWN_BIN_SHA256_LINUX_ARM64=""
FFMPEG_OWN_BIN_SHA256_WINDOWS_AMD64=""
FFPROBE_OWN_BIN_SHA256_WINDOWS_AMD64=""
FFMPEG_OWN_BIN_SHA256_DARWIN_ARM64=""
FFPROBE_OWN_BIN_SHA256_DARWIN_AMD64=""
FFMPEG_OWN_BIN_SHA256_DARWIN_AMD64=""
FFPROBE_OWN_BIN_SHA256_DARWIN_ARM64=""
