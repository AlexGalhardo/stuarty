# The tools that build the installers (SDD-009 section 10.4, P1-REL-010), each at one exact stable
# version, downloaded by exact URL and verified by SHA-256, like .config/ffmpeg.env.
# Sourced by scripts/fetch-installer-tool.sh. Bump only through a pull request that re-runs the
# installers workflow; compute the digest with sha256sum after downloading the asset.
#
# Not listed here, because they are not downloaded:
#   nfpm        the library inside GoReleaser (version in .github/workflows/release.yml), used by
#               the nfpms section of .config/goreleaser.yaml to make the .deb files.
#   pkgbuild    part of macOS (Xcode command line tools), used on the macos runner.
INNO_SETUP_VERSION="7.1.1"
INNO_SETUP_URL="https://github.com/jrsoftware/issrc/releases/download/is-7_1_1/innosetup-7.1.1-x64.exe"
INNO_SETUP_SHA256="8a5a6711c3766a6e5fb74f280ba0e3551e719ce94538d901fdbd1f8f9920b3f0"
APPIMAGETOOL_VERSION="1.9.1"
APPIMAGETOOL_URL="https://github.com/AppImage/appimagetool/releases/download/1.9.1/appimagetool-x86_64.AppImage"
