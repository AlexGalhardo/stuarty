# The inputs of the own LGPL FFmpeg build (D-017, ADR-0011, SDD-009 section 11.2).
# Sourced by scripts/ffmpeg-build.sh and .github/workflows/ffmpeg-build.yml.
# Every source is a pinned tarball with its SHA-256; the script refuses a download
# whose digest differs. Bump only through a pull request that re-runs ffmpeg-build.yml,
# and publish a new release tag (FFMPEG_BUILD_TAG) with it.

# The tag of the release asset set the workflow publishes. Changes with any pin below,
# with the flags of configure-flags.txt or with a patch of patches/.
FFMPEG_BUILD_TAG="ffmpeg-9.0.2-1"
FFMPEG_BUILD_VERSION="9.0.2"

FFMPEG_SRC_URL="https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz"
FFMPEG_SRC_SHA256="8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e"

# The one patch applied to FFmpeg, pinned like a source: the libopenh264 encoder opens Cisco's
# library at run time (dlopen, LoadLibrary) from VUKEM_VIDEO_OPENH264_DIR instead of linking it.
# The build refuses a patch file whose digest differs, and applies no other patch.
FFMPEG_PATCH_FILE="0001-libopenh264-dlopen.patch"
FFMPEG_PATCH_SHA256="9efd6325313c4dbc61fdc386b8b7d0b10ea85813bed80dadc157d9a40c006af4"

# Cisco OpenH264 source (BSD-2-Clause), used only for its four API headers (codec/api/wels/*.h),
# which give the patch the types. The library itself is the Cisco binary of
# engine/ffmpeg/manifest.json, installed at run time; none of its code is built. The version
# is the one of that manifest, and the patch refuses a library of another version.
OPENH264_SRC_URL="https://github.com/cisco/openh264/archive/refs/tags/v2.6.0.tar.gz"
OPENH264_SRC_SHA256="a6aa06044528d12ea34fa9fa28d7ea56008c96813633861781fffacb88784a09"

# VP8 and VP9 (BSD-3-Clause), the libvpx-vp9 encoder the capability tests require (SDD-011 section 8.3).
LIBVPX_SRC_URL="https://github.com/webmproject/libvpx/archive/refs/tags/v1.16.0.tar.gz"
LIBVPX_SRC_SHA256="7a479a3c66b9f5d5542a4c6a1b7d3768a983b1e5c14c60a9396edc9b649e015c"

# Opus (BSD-3-Clause).
OPUS_SRC_URL="https://downloads.xiph.org/releases/opus/opus-1.6.1.tar.gz"
OPUS_SRC_SHA256="6ffcb593207be92584df15b32466ed64bbec99109f007c82205f0194572411a1"

# zlib (zlib licence), static, for PNG and the MOV and Matroska readers.
ZLIB_SRC_URL="https://github.com/madler/zlib/releases/download/v1.3.2/zlib-1.3.2.tar.gz"
ZLIB_SRC_SHA256="bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16"

# NVENC headers (MIT); the encoder loads the NVIDIA driver at run time, nothing is linked.
NVCODEC_SRC_URL="https://github.com/FFmpeg/nv-codec-headers/archive/refs/tags/n13.0.19.0.tar.gz"
NVCODEC_SRC_SHA256="86d15d1a7c0ac73a0eafdfc57bebfeba7da8264595bf531cf4d8db1c22940116"

# zimg (WTFPL), the zscale filter of the HDR to SDR chain (SDD-004 section 4.3.1, SDD-011 section 8.3).
ZIMG_SRC_URL="https://github.com/sekrit-twc/zimg/archive/refs/tags/release-3.0.6.tar.gz"
ZIMG_SRC_SHA256="be89390f13a5c9b2388ce0f44a5e89364a20c1c57ce46d382b1fcc3967057577"

# Intel oneVPL dispatcher (MIT), built static: the h264_qsv, hevc_qsv and av1_qsv encoders open
# the Intel runtime of the GPU driver at run time through it (D-034). Windows and Linux only; needs cmake.
LIBVPL_SRC_URL="https://github.com/intel/libvpl/archive/refs/tags/v2.17.0.tar.gz"
LIBVPL_SRC_SHA256="4de3e2faf1e8307fb282e4a43f443191810f6a6b0a484fffa7995ba1c814c6ec"

# AMD AMF headers (MIT), the headers-only release asset; the encoder loads amfrt64.dll or
# libamfrt64.so of the AMD driver at run time, nothing is linked (D-034). Windows and Linux only.
AMF_SRC_URL="https://github.com/GPUOpen-LibrariesAndSDKs/AMF/releases/download/v1.5.3/AMF-headers-v1.5.3.tar.gz"
AMF_SRC_SHA256="0f521ad98041f8001147cded4a660127f18b1c27a801a5cd691bda1fa48381be"
