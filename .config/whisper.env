# The one pin of the whisper.cpp helper that Stuarty installs (ADR-0021).
# Sourced by scripts/whisper-build.sh and .github/workflows/helpers.yml.
# The upstream release v1.9.2 ships prebuilt helpers for linux-amd64,
# linux-arm64 and windows-amd64 only (SDD-011 section 10.2); the others are built
# by helpers.yml from this exact source and published as the release
# helpers-<WHISPER_TAG>. Bump only through a pull request that re-runs helpers.yml.
WHISPER_TAG="v1.9.2"
WHISPER_COMMIT="306c88f4d1286aec1bf96e544632897886af5501"
WHISPER_SOURCE_URL="https://github.com/ggml-org/whisper.cpp/archive/306c88f4d1286aec1bf96e544632897886af5501.tar.gz"
WHISPER_SOURCE_SHA256="f3585ebf64df3e41b26c45d93bdb38b423ca1de0bf40cc4b6d320254867a75df"
# The model of the helper test (the smallest one, SDD-011 section 10.2), pinned to a Hugging Face revision.
WHISPER_TEST_MODEL_URL="https://huggingface.co/ggerganov/whisper.cpp/resolve/5359861c739e955e79d9a303bcbc70fb988958b1/ggml-tiny.bin"
WHISPER_TEST_MODEL_SHA256="be07e048e1e599ad46341c8d2a135645097a538221678b7acdd1b1919c6e1b21"
# The speech of the helper test: the LibriVox reading of Alice in Wonderland, chapter 1 (public domain).
WHISPER_TEST_AUDIO_URL="https://www.archive.org/download/alice_in_wonderland_librivox/wonderland_ch_01_64kb.mp3"
