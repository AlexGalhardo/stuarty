{
 "exchanges": [
  {
   "name": "videos.insert resumable session",
   "request": {
    "method": "POST",
    "path": "/upload/youtube/v3/videos",
    "query": {
     "uploadType": "resumable",
     "part": "snippet,status"
    },
    "headers": {
     "Authorization": "Bearer at-1",
     "X-Upload-Content-Type": "video/mp4",
     "X-Upload-Content-Length": "2000"
    },
    "json": {
     "snippet.title": "My video",
     "snippet.categoryId": "22",
     "status.privacyStatus": "private",
     "status.selfDeclaredMadeForKids": false,
     "status.containsSyntheticMedia": true
    }
   },
   "response": {
    "status": 200,
    "headers": {
     "Location": "{{base}}/upload/session/abc123"
    },
    "body": ""
   }
  },
  {
   "name": "upload the file",
   "request": {
    "method": "PUT",
    "path": "/upload/session/abc123",
    "headers": {
     "Authorization": "Bearer at-1",
     "Content-Range": "bytes 0-1999/2000",
     "Content-Type": "video/mp4"
    }
   },
   "response": {
    "status": 201,
    "headers": {
     "Content-Type": "application/json"
    },
    "body": {
     "kind": "youtube#video",
     "id": "vid123",
     "status": {
      "uploadStatus": "uploaded",
      "privacyStatus": "private"
     }
    }
   }
  },
  {
   "name": "thumbnails.set",
   "request": {
    "method": "POST",
    "path": "/upload/youtube/v3/thumbnails/set",
    "query": {
     "videoId": "vid123",
     "uploadType": "media"
    },
    "headers": {
     "Authorization": "Bearer at-1",
     "Content-Type": "image/png"
    }
   },
   "response": {
    "status": 200,
    "headers": {
     "Content-Type": "application/json"
    },
    "body": {
     "kind": "youtube#thumbnailSetResponse",
     "items": [
      {
       "default": {
        "url": "https://i.ytimg.com/vi/vid123/default.jpg"
       }
      }
     ]
    }
   }
  },
  {
   "name": "videos.list processed",
   "request": {
    "method": "GET",
    "path": "/youtube/v3/videos",
    "query": {
     "part": "status,processingDetails",
     "id": "vid123"
    },
    "headers": {
     "Authorization": "Bearer at-1"
    }
   },
   "response": {
    "status": 200,
    "headers": {
     "Content-Type": "application/json"
    },
    "body": {
     "kind": "youtube#videoListResponse",
     "items": [
      {
       "id": "vid123",
       "status": {
        "uploadStatus": "processed",
        "privacyStatus": "private"
       },
       "processingDetails": {
        "processingStatus": "succeeded"
       }
      }
     ]
    }
   },
   "times": 99
  }
 ]
}
