{
 "exchanges": [
  {
   "name": "token refresh",
   "request": {
    "method": "POST",
    "path": "/token",
    "form": {
     "grant_type": "refresh_token",
     "refresh_token": "rt-1",
     "client_id": "cid",
     "client_secret": "csecret"
    }
   },
   "response": {
    "status": 200,
    "headers": {
     "Content-Type": "application/json"
    },
    "body": {
     "access_token": "at-1",
     "expires_in": 3599,
     "scope": "https://www.googleapis.com/auth/youtube.upload https://www.googleapis.com/auth/youtube.readonly",
     "token_type": "Bearer"
    }
   },
   "times": 99
  },
  {
   "name": "channels.list mine",
   "request": {
    "method": "GET",
    "path": "/youtube/v3/channels",
    "query": {
     "part": "id,snippet",
     "mine": "true"
    },
    "headers": {
     "Authorization": "Bearer at-1"
    }
   },
   "response": {
    "status": 200,
    "headers": {
     "Content-Type": "application/json"
    },
    "body": {
     "kind": "youtube#channelListResponse",
     "items": [
      {
       "kind": "youtube#channel",
       "id": "UC123",
       "snippet": {
        "title": "My channel"
       }
      }
     ]
    }
   },
   "times": 99
  }
 ]
}
