{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"required": ["project_id", "revision", "base_revision", "kind", "actor", "at", "description"],
	"properties": {
		"project_id": {"type": "string", "pattern": "^prj_[0-9a-hjkmnp-tv-z]{10}$"},
		"revision": {"type": "integer", "minimum": 1},
		"base_revision": {"type": "integer", "minimum": 0},
		"kind": {"enum": ["edit", "undo", "redo", "migrate", "import"]},
		"actor": {"type": "string", "pattern": "^(user|key|local):.+"},
		"at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$"},
		"description": {"type": "string", "maxLength": 500},
		"target_revision": {"type": "integer", "minimum": 0},
		"skipped_count": {"type": "integer", "minimum": 0},
		"diff": {"type": "array", "items": {"type": "object", "required": ["kind", "id"]}},
		"diff_truncated": {"const": true},
		"changed": {
			"type": "array", "maxItems": 500,
			"items": {
				"type": "object", "additionalProperties": false, "required": ["kind", "id"],
				"properties": {"kind": {"type": "string"}, "id": {"type": "string"}}
			}
		},
		"changed_more": {"type": "integer", "minimum": 1}
	},
	"if": {"required": ["diff_truncated"]},
	"then": {"required": ["changed"], "not": {"required": ["diff"]}},
	"else": {"required": ["diff"], "not": {"anyOf": [{"required": ["changed"]}, {"required": ["changed_more"]}]}}
}
