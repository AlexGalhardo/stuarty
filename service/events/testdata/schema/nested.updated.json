{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"required": ["project_id", "timeline_id", "revision", "at"],
	"properties": {
		"project_id": {"type": "string", "pattern": "^prj_[0-9a-hjkmnp-tv-z]{10}$"},
		"timeline_id": {"type": "string", "pattern": "^prj_[0-9a-hjkmnp-tv-z]{10}$"},
		"revision": {"type": "integer", "minimum": 0},
		"at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$"}
	}
}
