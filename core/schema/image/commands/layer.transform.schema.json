{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "h": {
      "maximum": 16384,
      "minimum": 1,
      "type": "integer"
    },
    "layer_id": {
      "pattern": "^lyr_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    },
    "rotation": {
      "maximum": 360,
      "minimum": -360,
      "type": "integer"
    },
    "w": {
      "maximum": 16384,
      "minimum": 1,
      "type": "integer"
    },
    "x": {
      "maximum": 16384,
      "minimum": -16384,
      "type": "integer"
    },
    "y": {
      "maximum": 16384,
      "minimum": -16384,
      "type": "integer"
    }
  },
  "required": [
    "layer_id"
  ],
  "type": "object"
}
