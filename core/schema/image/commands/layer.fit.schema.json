{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "layer_id": {
      "pattern": "^lyr_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    },
    "mode": {
      "enum": [
        "cover",
        "contain"
      ],
      "type": "string"
    },
    "to": {
      "description": "canvas (default), or a layer id.",
      "type": "string"
    }
  },
  "required": [
    "layer_id",
    "mode"
  ],
  "type": "object"
}
