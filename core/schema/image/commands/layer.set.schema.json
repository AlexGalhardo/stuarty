{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "layer_id": {
      "pattern": "^lyr_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    },
    "locked": {
      "type": "boolean"
    },
    "name": {
      "maxLength": 120,
      "type": "string"
    },
    "opacity": {
      "description": "A whole percent, 0 to 100.",
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
    },
    "slot": {
      "description": "A template slot name; an empty string removes it.",
      "type": "string"
    },
    "visible": {
      "type": "boolean"
    }
  },
  "required": [
    "layer_id"
  ],
  "type": "object"
}
