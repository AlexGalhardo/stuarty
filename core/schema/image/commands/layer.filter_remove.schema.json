{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "grayscale",
        "sepia",
        "invert",
        "warm",
        "cool",
        "blur",
        "sharpen",
        "vignette",
        "grain",
        "shadow",
        "glow",
        "stroke"
      ],
      "type": "string"
    },
    "layer_id": {
      "pattern": "^lyr_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    }
  },
  "required": [
    "layer_id",
    "kind"
  ],
  "type": "object"
}
