{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dx": {
      "maximum": 16384,
      "minimum": -16384,
      "type": "integer"
    },
    "dy": {
      "maximum": 16384,
      "minimum": -16384,
      "type": "integer"
    },
    "id": {
      "pattern": "^lyr_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    },
    "layer_id": {
      "pattern": "^lyr_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    },
    "name": {
      "maxLength": 120,
      "type": "string"
    }
  },
  "required": [
    "layer_id"
  ],
  "type": "object"
}
