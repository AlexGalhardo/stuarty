{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asset": {
      "description": "The sha256 content hash of the new image in the workspace.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "layer_id": {
      "description": "The image layer.",
      "pattern": "^lyr_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    }
  },
  "required": [
    "layer_id",
    "asset"
  ],
  "type": "object"
}
