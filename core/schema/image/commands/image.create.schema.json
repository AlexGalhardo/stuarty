{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "background": {
      "description": "A colour (#RRGGBB or #RRGGBBAA) or transparent; default #FFFFFF.",
      "type": "string"
    },
    "height": {
      "description": "Pixels, 1 to 4096.",
      "maximum": 4096,
      "minimum": 1,
      "type": "integer"
    },
    "name": {
      "description": "At most 120 characters; default Untitled.",
      "maxLength": 120,
      "type": "string"
    },
    "preset": {
      "description": "A named size; give it or width and height.",
      "enum": [
        "video_thumbnail",
        "square_post",
        "vertical_cover"
      ],
      "type": "string"
    },
    "template": {
      "description": "Make a template: its text and image layers may be slots.",
      "type": "boolean"
    },
    "width": {
      "description": "Pixels, 1 to 4096.",
      "maximum": 4096,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [],
  "type": "object"
}
