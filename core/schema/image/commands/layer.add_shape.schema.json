{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "fill": {
      "description": "A colour; default #FFFFFF.",
      "type": "string"
    },
    "h": {
      "description": "Pixels, 1 to 16384.",
      "maximum": 16384,
      "minimum": 1,
      "type": "integer"
    },
    "id": {
      "pattern": "^lyr_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    },
    "index": {
      "description": "Position among the siblings, 0 is the bottom; absent means on top.",
      "maximum": 500,
      "minimum": 0,
      "type": "integer"
    },
    "name": {
      "maxLength": 120,
      "type": "string"
    },
    "parent": {
      "description": "A group; absent means the top level.",
      "pattern": "^lyr_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    },
    "radius": {
      "description": "Pixels; rounded_rect only.",
      "maximum": 16384,
      "minimum": 0,
      "type": "integer"
    },
    "shape": {
      "enum": [
        "rect",
        "rounded_rect",
        "ellipse"
      ],
      "type": "string"
    },
    "stroke_color": {
      "description": "A colour; default none.",
      "type": "string"
    },
    "stroke_width": {
      "description": "Pixels, 0 or more.",
      "maximum": 1000,
      "minimum": 0,
      "type": "integer"
    },
    "w": {
      "description": "Pixels, 1 to 16384.",
      "maximum": 16384,
      "minimum": 1,
      "type": "integer"
    },
    "x": {
      "maximum": 16384,
      "minimum": -16384,
      "type": "integer"
    },
    "y": {
      "maximum": 16384,
      "minimum": -16384,
      "type": "integer"
    }
  },
  "required": [
    "shape",
    "w",
    "h"
  ],
  "type": "object"
}
