{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "color": {
      "type": "string"
    },
    "id": {
      "pattern": "^lyr_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    },
    "index": {
      "description": "Position among the siblings, 0 is the bottom; absent means on top.",
      "maximum": 500,
      "minimum": 0,
      "type": "integer"
    },
    "name": {
      "maxLength": 120,
      "type": "string"
    },
    "parent": {
      "description": "A group; absent means the top level.",
      "pattern": "^lyr_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    }
  },
  "required": [
    "color"
  ],
  "type": "object"
}
