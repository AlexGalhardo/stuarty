{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "height": {
      "description": "Pixels, 1 to 4096.",
      "maximum": 4096,
      "minimum": 1,
      "type": "integer"
    },
    "mode": {
      "description": "keep (default) or scale.",
      "enum": [
        "keep",
        "scale"
      ],
      "type": "string"
    },
    "width": {
      "description": "Pixels, 1 to 4096.",
      "maximum": 4096,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "width",
    "height"
  ],
  "type": "object"
}
