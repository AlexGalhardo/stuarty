{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "layer_id": {
      "pattern": "^lyr_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    },
    "mode": {
      "enum": [
        "normal",
        "multiply",
        "screen",
        "overlay",
        "soft_light",
        "hard_light",
        "darken",
        "lighten",
        "color_dodge",
        "color_burn",
        "difference"
      ],
      "type": "string"
    }
  },
  "required": [
    "layer_id",
    "mode"
  ],
  "type": "object"
}
