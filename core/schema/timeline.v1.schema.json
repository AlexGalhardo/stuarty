{
  "$defs": {
    "Asset": {
      "properties": {
        "frame_count": {
          "minimum": 1,
          "type": "integer"
        },
        "frame_delays": {
          "items": {
            "type": "integer"
          },
          "maxItems": 1000,
          "minItems": 2,
          "type": "array"
        },
        "frame_rate": {
          "$ref": "#/$defs/Rational"
        },
        "has_alpha": {
          "type": "boolean"
        },
        "has_audio": {
          "type": "boolean"
        },
        "hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "height": {
          "minimum": 1,
          "type": "integer"
        },
        "id": {
          "pattern": "^ast_[0-9a-hjkmnp-tv-z]{10}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "video",
            "audio",
            "image",
            "lut"
          ],
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sample_count": {
          "minimum": 1,
          "type": "integer"
        },
        "width": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "hash",
        "id",
        "kind",
        "name"
      ],
      "type": "object"
    },
    "CaptionStyle": {
      "properties": {
        "align": {
          "enum": [
            "left",
            "center",
            "right"
          ],
          "type": "string"
        },
        "background_color": {
          "pattern": "^(#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?|\\$[a-z][a-z0-9_]{0,39})$",
          "type": "string"
        },
        "background_padding": {
          "minimum": 0,
          "type": "number"
        },
        "background_radius": {
          "minimum": 0,
          "type": "number"
        },
        "color": {
          "pattern": "^(#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?|\\$[a-z][a-z0-9_]{0,39})$",
          "type": "string"
        },
        "font_family": {
          "type": "string"
        },
        "font_weight": {
          "maximum": 900,
          "minimum": 100,
          "multipleOf": 100,
          "type": "integer"
        },
        "highlight": {
          "enum": [
            "none",
            "word"
          ],
          "type": "string"
        },
        "highlight_background": {
          "pattern": "^(#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?|\\$[a-z][a-z0-9_]{0,39})$",
          "type": "string"
        },
        "highlight_color": {
          "pattern": "^(#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?|\\$[a-z][a-z0-9_]{0,39})$",
          "type": "string"
        },
        "line_height": {
          "maximum": 3,
          "minimum": 0.8,
          "type": "number"
        },
        "max_width": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "position": {
          "enum": [
            "bottom",
            "middle",
            "top",
            "custom"
          ],
          "type": "string"
        },
        "shadow_blur": {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        "shadow_color": {
          "pattern": "^(#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?|\\$[a-z][a-z0-9_]{0,39})$",
          "type": "string"
        },
        "shadow_dx": {
          "type": "number"
        },
        "shadow_dy": {
          "type": "number"
        },
        "size": {
          "maximum": 1000,
          "minimum": 8,
          "type": "number"
        },
        "stroke_color": {
          "pattern": "^(#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?|\\$[a-z][a-z0-9_]{0,39})$",
          "type": "string"
        },
        "stroke_width": {
          "maximum": 40,
          "minimum": 0,
          "type": "number"
        },
        "uppercase": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "ChromaKey": {
      "properties": {
        "color": {
          "pattern": "^(#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?|\\$[a-z][a-z0-9_]{0,39})$",
          "type": "string"
        },
        "similarity": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "smoothness": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "spill": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "color",
        "similarity",
        "smoothness",
        "spill"
      ],
      "type": "object"
    },
    "Crop": {
      "properties": {
        "bottom": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "left": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "right": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "top": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "type": "object"
    },
    "CurvePoint": {
      "properties": {
        "x": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "Curves": {
      "properties": {
        "blue": {
          "items": {
            "$ref": "#/$defs/CurvePoint"
          },
          "maxItems": 8,
          "minItems": 2,
          "type": "array"
        },
        "green": {
          "items": {
            "$ref": "#/$defs/CurvePoint"
          },
          "maxItems": 8,
          "minItems": 2,
          "type": "array"
        },
        "master": {
          "items": {
            "$ref": "#/$defs/CurvePoint"
          },
          "maxItems": 8,
          "minItems": 2,
          "type": "array"
        },
        "red": {
          "items": {
            "$ref": "#/$defs/CurvePoint"
          },
          "maxItems": 8,
          "minItems": 2,
          "type": "array"
        }
      },
      "type": "object"
    },
    "Effect": {
      "properties": {
        "amount": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "angle": {
          "maximum": 180,
          "minimum": -180,
          "type": "number"
        },
        "kind": {
          "enum": [
            "motion_blur",
            "glow",
            "vignette",
            "grain",
            "rgb_split",
            "shake"
          ],
          "type": "string"
        },
        "radius": {
          "maximum": 100,
          "minimum": 1,
          "type": "number"
        },
        "seed": {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "size": {
          "maximum": 8,
          "minimum": 1,
          "type": "integer"
        },
        "softness": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "speed": {
          "maximum": 30,
          "minimum": 1,
          "type": "integer"
        },
        "threshold": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "FontFile": {
      "properties": {
        "hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "weight": {
          "maximum": 900,
          "minimum": 100,
          "multipleOf": 100,
          "type": "integer"
        }
      },
      "required": [
        "hash",
        "weight"
      ],
      "type": "object"
    },
    "HslBand": {
      "properties": {
        "hue": {
          "maximum": 1,
          "minimum": -1,
          "type": "number"
        },
        "lightness": {
          "maximum": 1,
          "minimum": -1,
          "type": "number"
        },
        "range": {
          "enum": [
            "red",
            "orange",
            "yellow",
            "green",
            "cyan",
            "blue",
            "purple",
            "magenta"
          ],
          "type": "string"
        },
        "saturation": {
          "maximum": 1,
          "minimum": -1,
          "type": "number"
        }
      },
      "required": [
        "range"
      ],
      "type": "object"
    },
    "Item": {
      "properties": {
        "asset": {
          "pattern": "^ast_([0-9a-hjkmnp-tv-z]{10}|placeholder)$",
          "type": "string"
        },
        "audio_muted": {
          "type": "boolean"
        },
        "blend": {
          "enum": [
            "normal",
            "multiply",
            "screen",
            "overlay",
            "add"
          ],
          "type": "string"
        },
        "blur": {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        "breaks": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "brightness": {
          "maximum": 1,
          "minimum": -1,
          "type": "number"
        },
        "chroma_key": {
          "$ref": "#/$defs/ChromaKey"
        },
        "contrast": {
          "default": 1,
          "maximum": 2,
          "minimum": 0,
          "type": "number"
        },
        "crop": {
          "$ref": "#/$defs/Crop"
        },
        "curves": {
          "$ref": "#/$defs/Curves"
        },
        "denoise": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "disabled": {
          "type": "boolean"
        },
        "duration": {
          "minimum": 1,
          "type": "integer"
        },
        "effects": {
          "items": {
            "$ref": "#/$defs/Effect"
          },
          "maxItems": 6,
          "minItems": 1,
          "type": "array"
        },
        "fade_in": {
          "minimum": 0,
          "type": "integer"
        },
        "fade_out": {
          "minimum": 0,
          "type": "integer"
        },
        "fill": {
          "default": "#FFFFFF",
          "pattern": "^(#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?|\\$[a-z][a-z0-9_]{0,39})$",
          "type": "string"
        },
        "filter": {
          "default": "none",
          "enum": [
            "none",
            "grayscale",
            "sepia",
            "invert",
            "warm",
            "cool"
          ],
          "type": "string"
        },
        "filter_amount": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "fit": {
          "default": "cover",
          "enum": [
            "cover",
            "contain",
            "none"
          ],
          "type": "string"
        },
        "flip_x": {
          "type": "boolean"
        },
        "flip_y": {
          "type": "boolean"
        },
        "freeze": {
          "type": "boolean"
        },
        "height": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "hsl": {
          "items": {
            "$ref": "#/$defs/HslBand"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array"
        },
        "hue": {
          "maximum": 180,
          "minimum": -180,
          "type": "number"
        },
        "id": {
          "pattern": "^itm_[0-9a-hjkmnp-tv-z]{10}$",
          "type": "string"
        },
        "keyframes": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/Keyframe"
            },
            "maxItems": 100,
            "type": "array"
          },
          "propertyNames": {
            "enum": [
              "x",
              "y",
              "scale",
              "rotation",
              "opacity",
              "volume",
              "brightness",
              "contrast",
              "saturation",
              "temperature",
              "tint",
              "hue",
              "mask_x",
              "mask_y",
              "mask_width",
              "mask_height",
              "mask_feather",
              "crop_left",
              "crop_top",
              "crop_right",
              "crop_bottom"
            ]
          },
          "type": "object"
        },
        "link": {
          "pattern": "^lnk_[0-9a-hjkmnp-tv-z]{10}$",
          "type": "string"
        },
        "linked_item": {
          "pattern": "^itm_[0-9a-hjkmnp-tv-z]{10}$",
          "type": "string"
        },
        "lut": {
          "$ref": "#/$defs/Lut"
        },
        "markers": {
          "items": {
            "$ref": "#/$defs/Marker"
          },
          "maxItems": 200,
          "type": "array"
        },
        "mask": {
          "$ref": "#/$defs/Mask"
        },
        "name": {
          "maxLength": 120,
          "type": "string"
        },
        "opacity": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "outline": {
          "$ref": "#/$defs/Outline"
        },
        "radius": {
          "minimum": 0,
          "type": "number"
        },
        "reverse": {
          "type": "boolean"
        },
        "rotation": {
          "type": "number"
        },
        "saturation": {
          "default": 1,
          "maximum": 2,
          "minimum": 0,
          "type": "number"
        },
        "scale": {
          "default": 1,
          "exclusiveMinimum": 0,
          "maximum": 20,
          "type": "number"
        },
        "shadow": {
          "$ref": "#/$defs/Shadow"
        },
        "shape": {
          "enum": [
            "rect",
            "rounded_rect",
            "ellipse"
          ],
          "type": "string"
        },
        "slot": {
          "$ref": "#/$defs/Slot"
        },
        "source_in": {
          "minimum": 0,
          "type": "integer"
        },
        "speed": {
          "$ref": "#/$defs/Rational",
          "default": {
            "den": 1,
            "num": 1
          }
        },
        "speed_curve": {
          "items": {
            "$ref": "#/$defs/SpeedPoint"
          },
          "maxItems": 8,
          "minItems": 2,
          "type": "array"
        },
        "start": {
          "minimum": 0,
          "type": "integer"
        },
        "stroke_color": {
          "default": "#000000",
          "pattern": "^(#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?|\\$[a-z][a-z0-9_]{0,39})$",
          "type": "string"
        },
        "stroke_width": {
          "minimum": 0,
          "type": "number"
        },
        "style": {
          "$ref": "#/$defs/CaptionStyle"
        },
        "temperature": {
          "maximum": 1,
          "minimum": -1,
          "type": "number"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "tint": {
          "maximum": 1,
          "minimum": -1,
          "type": "number"
        },
        "track": {
          "pattern": "^trk_[0-9a-hjkmnp-tv-z]{10}$",
          "type": "string"
        },
        "transition_in": {
          "$ref": "#/$defs/Transition"
        },
        "transition_out": {
          "$ref": "#/$defs/Transition"
        },
        "type": {
          "enum": [
            "clip",
            "audio",
            "text",
            "caption",
            "shape"
          ],
          "type": "string"
        },
        "voice": {
          "enum": [
            "clear",
            "warm",
            "deep",
            "bright",
            "radio"
          ],
          "type": "string"
        },
        "volume": {
          "default": 1,
          "maximum": 4,
          "minimum": 0,
          "type": "number"
        },
        "wheels": {
          "$ref": "#/$defs/Wheels"
        },
        "width": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "words": {
          "items": {
            "$ref": "#/$defs/Word"
          },
          "maxItems": 60,
          "minItems": 1,
          "type": "array"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "duration",
        "id",
        "start",
        "track",
        "type"
      ],
      "type": "object"
    },
    "Keyframe": {
      "properties": {
        "bezier": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "easing": {
          "default": "linear",
          "enum": [
            "linear",
            "ease_in",
            "ease_out",
            "ease_in_out",
            "hold",
            "bezier"
          ],
          "type": "string"
        },
        "t": {
          "minimum": 0,
          "type": "integer"
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "t",
        "value"
      ],
      "type": "object"
    },
    "Lut": {
      "properties": {
        "asset": {
          "pattern": "^ast_[0-9a-hjkmnp-tv-z]{10}$",
          "type": "string"
        },
        "intensity": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "asset",
        "intensity"
      ],
      "type": "object"
    },
    "Marker": {
      "properties": {
        "frame": {
          "minimum": 0,
          "type": "integer"
        },
        "label": {
          "maxLength": 60,
          "type": "string"
        }
      },
      "required": [
        "frame"
      ],
      "type": "object"
    },
    "Mask": {
      "properties": {
        "feather": {
          "maximum": 200,
          "minimum": 0,
          "type": "integer"
        },
        "height": {
          "maximum": 1,
          "minimum": 0.001,
          "type": "number"
        },
        "invert": {
          "type": "boolean"
        },
        "shape": {
          "enum": [
            "rect",
            "ellipse"
          ],
          "type": "string"
        },
        "width": {
          "maximum": 1,
          "minimum": 0.001,
          "type": "number"
        },
        "x": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "feather",
        "height",
        "shape",
        "width",
        "x",
        "y"
      ],
      "type": "object"
    },
    "Outline": {
      "properties": {
        "color": {
          "pattern": "^(#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?|\\$[a-z][a-z0-9_]{0,39})$",
          "type": "string"
        },
        "width": {
          "maximum": 100,
          "minimum": 0.5,
          "type": "number"
        }
      },
      "required": [
        "color",
        "width"
      ],
      "type": "object"
    },
    "ProjectFont": {
      "properties": {
        "files": {
          "items": {
            "$ref": "#/$defs/FontFile"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "files"
      ],
      "type": "object"
    },
    "Rational": {
      "properties": {
        "den": {
          "minimum": 1,
          "type": "integer"
        },
        "num": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "den",
        "num"
      ],
      "type": "object"
    },
    "Settings": {
      "properties": {
        "background": {
          "default": "#000000",
          "pattern": "^(#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?|\\$[a-z][a-z0-9_]{0,39}|transparent)$",
          "type": "string"
        },
        "fps": {
          "allOf": [
            {
              "$ref": "#/$defs/Rational"
            },
            {
              "properties": {
                "den": {
                  "enum": [
                    1,
                    1001
                  ]
                },
                "num": {
                  "maximum": 120120
                }
              }
            }
          ],
          "default": {
            "den": 1,
            "num": 30
          },
          "description": "den is 1 or 1001; num/den between 1 and 120."
        },
        "height": {
          "default": 1920,
          "maximum": 4096,
          "minimum": 16,
          "multipleOf": 2,
          "type": "integer"
        },
        "loudness_target": {
          "default": -14,
          "maximum": -5,
          "minimum": -30,
          "type": "number"
        },
        "width": {
          "default": 1080,
          "maximum": 4096,
          "minimum": 16,
          "multipleOf": 2,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "Shadow": {
      "properties": {
        "blur": {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        "color": {
          "pattern": "^(#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?|\\$[a-z][a-z0-9_]{0,39})$",
          "type": "string"
        },
        "dx": {
          "maximum": 500,
          "minimum": -500,
          "type": "number"
        },
        "dy": {
          "maximum": 500,
          "minimum": -500,
          "type": "number"
        },
        "opacity": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "blur",
        "color",
        "dx",
        "dy",
        "opacity"
      ],
      "type": "object"
    },
    "Slot": {
      "properties": {
        "description": {
          "maxLength": 200,
          "type": "string"
        },
        "duration_policy": {
          "default": "fit",
          "enum": [
            "fit",
            "stretch_timeline"
          ],
          "type": "string"
        },
        "filled": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "media",
            "text",
            "caption"
          ],
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,39}$",
          "type": "string"
        },
        "required": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "type": "object"
    },
    "SpeedPoint": {
      "properties": {
        "speed": {
          "$ref": "#/$defs/Rational"
        },
        "t": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "speed",
        "t"
      ],
      "type": "object"
    },
    "TemplateInfo": {
      "properties": {
        "colors": {
          "additionalProperties": {
            "pattern": "^(#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?|\\$[a-z][a-z0-9_]{0,39})$",
            "type": "string"
          },
          "type": "object"
        },
        "description": {
          "type": "string"
        },
        "instance": {
          "description": "True in a project made from a template: its open slots are lint errors.",
          "type": "boolean"
        }
      },
      "required": [
        "description"
      ],
      "type": "object"
    },
    "Track": {
      "properties": {
        "caption_style": {
          "$ref": "#/$defs/CaptionStyle"
        },
        "hidden": {
          "type": "boolean"
        },
        "id": {
          "pattern": "^trk_[0-9a-hjkmnp-tv-z]{10}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "visual",
            "audio"
          ],
          "type": "string"
        },
        "locked": {
          "type": "boolean"
        },
        "magnet": {
          "type": "boolean"
        },
        "muted": {
          "type": "boolean"
        },
        "name": {
          "maxLength": 60,
          "type": "string"
        },
        "order": {
          "pattern": "^[0-9a-z]+$",
          "type": "string"
        },
        "solo": {
          "type": "boolean"
        },
        "volume": {
          "maximum": 4,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "id",
        "kind",
        "order"
      ],
      "type": "object"
    },
    "Transition": {
      "properties": {
        "color": {
          "pattern": "^(#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?|\\$[a-z][a-z0-9_]{0,39})$",
          "type": "string"
        },
        "direction": {
          "enum": [
            "left",
            "right",
            "up",
            "down"
          ],
          "type": "string"
        },
        "duration": {
          "minimum": 1,
          "type": "integer"
        },
        "kind": {
          "enum": [
            "fade",
            "slide_left",
            "slide_right",
            "slide_up",
            "slide_down",
            "zoom",
            "whip",
            "dip",
            "wipe",
            "spin",
            "shrink",
            "grow"
          ],
          "type": "string"
        }
      },
      "required": [
        "duration",
        "kind"
      ],
      "type": "object"
    },
    "Wheel": {
      "properties": {
        "amount": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "hue": {
          "maximum": 360,
          "minimum": 0,
          "type": "number"
        },
        "luma": {
          "maximum": 1,
          "minimum": -1,
          "type": "number"
        }
      },
      "required": [
        "amount",
        "hue",
        "luma"
      ],
      "type": "object"
    },
    "Wheels": {
      "properties": {
        "highlights": {
          "$ref": "#/$defs/Wheel"
        },
        "midtones": {
          "$ref": "#/$defs/Wheel"
        },
        "shadows": {
          "$ref": "#/$defs/Wheel"
        }
      },
      "type": "object"
    },
    "Word": {
      "properties": {
        "duration": {
          "minimum": 1,
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "type": "integer"
        },
        "text": {
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "duration",
        "start",
        "text"
      ],
      "type": "object"
    }
  },
  "$id": "https://vukem-video.dev/schema/timeline.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "assets": {
      "additionalProperties": {
        "$ref": "#/$defs/Asset"
      },
      "maxProperties": 200,
      "propertyNames": {
        "pattern": "^ast_[0-9a-hjkmnp-tv-z]{10}$"
      },
      "type": "object"
    },
    "fonts": {
      "additionalProperties": {
        "$ref": "#/$defs/ProjectFont"
      },
      "type": "object"
    },
    "id": {
      "pattern": "^prj_[0-9a-hjkmnp-tv-z]{10}$",
      "type": "string"
    },
    "items": {
      "additionalProperties": {
        "$ref": "#/$defs/Item"
      },
      "maxProperties": 500,
      "propertyNames": {
        "pattern": "^itm_[0-9a-hjkmnp-tv-z]{10}$"
      },
      "type": "object"
    },
    "markers": {
      "items": {
        "$ref": "#/$defs/Marker"
      },
      "maxItems": 200,
      "type": "array"
    },
    "name": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "description": "Version of this schema.",
      "enum": [
        1
      ],
      "type": "integer"
    },
    "settings": {
      "$ref": "#/$defs/Settings"
    },
    "template": {
      "$ref": "#/$defs/TemplateInfo"
    },
    "tracks": {
      "additionalProperties": {
        "$ref": "#/$defs/Track"
      },
      "maxProperties": 50,
      "propertyNames": {
        "pattern": "^trk_[0-9a-hjkmnp-tv-z]{10}$"
      },
      "type": "object"
    }
  },
  "required": [
    "assets",
    "id",
    "items",
    "name",
    "schema_version",
    "settings",
    "tracks"
  ],
  "title": "Timeline document",
  "type": "object",
  "x-status": "frozen"
}
