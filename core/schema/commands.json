              "enum": [
                "video",
                "audio",
                "image"
              ],
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "sample_count": {
              "minimum": 1,
              "type": "integer"
            },
            "width": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "id",
            "hash",
            "kind",
            "name"
          ],
          "type": "object"
        }
      },
      "required": [
        "asset"
      ],
      "type": "object"
    },
    "description": "Adds the asset with the facts measured on the normalized media. An asset whose hash is already in the project is not added again: its identifier is returned in effective.asset_id. Only the import flow issues it.",
    "errors": [
      "E_VALIDATION",
      "E_ID_EXISTS",
      "E_LIMIT"
    ],
    "example": {
      "asset": {
        "frame_count": 900,
        "frame_rate": {
          "den": 1,
          "num": 30
        },
        "has_audio": true,
        "hash": "sha256:9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08",
        "height": 1920,
        "id": "ast_3c5v8n2w6d",
        "kind": "video",
        "name": "IMG_0421.MOV",
        "sample_count": 1440000,
        "width": 1080
      }
    },
    "internal": true,
    "name": "asset.add",
    "phase": "prototype",
    "scope": "media",
    "summary": "Adds an asset that the import flow has already ingested."
  },
  {
    "args_schema": {
