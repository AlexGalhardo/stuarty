{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "color": {
      "description": "dip only: #RRGGBB, default #000000.",
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "type": "string"
    },
    "direction": {
      "description": "whip and wipe only: left (default), right, up or down.",
      "enum": [
        "left",
        "right",
        "up",
        "down"
      ],
      "type": "string"
    },
    "duration": {
      "description": "Length of the transition, at least 1 frame; default 0.5s.",
      "type": "string",
      "x-vv-kind": "time"
    },
    "edge": {
      "description": "The edge: in or out.",
      "enum": [
        "in",
        "out"
      ],
      "type": "string"
    },
    "item_id": {
      "description": "A clip, text, caption or shape item.",
      "pattern": "^itm_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    },
    "kind": {
      "description": "fade, slide_left, slide_right, slide_up, slide_down, zoom, whip, dip, wipe, spin, shrink, grow, or null to remove.",
      "enum": [
        "fade",
        "slide_left",
        "slide_right",
        "slide_up",
        "slide_down",
        "zoom",
        "whip",
        "dip",
        "wipe",
        "spin",
        "shrink",
        "grow",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "item_id",
    "edge",
    "kind"
  ],
  "type": "object"
}
