{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "at": {
      "description": "Position of the keyframe on the project timeline, from the item start to its end inclusive.",
      "type": "string",
      "x-vv-kind": "time"
    },
    "item_id": {
      "type": "string"
    },
    "property": {
      "enum": [
        "x",
        "y",
        "scale",
        "rotation",
        "opacity",
        "volume",
        "brightness",
        "contrast",
        "saturation",
        "temperature",
        "tint",
        "hue"
      ],
      "type": "string"
    }
  },
  "required": [
    "item_id",
    "property",
    "at"
  ],
  "type": "object"
}
