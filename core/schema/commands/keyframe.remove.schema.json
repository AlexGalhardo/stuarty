{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "at": {
      "description": "Absolute position of the keyframe.",
      "type": "string"
    },
    "item_id": {
      "type": "string"
    },
    "property": {
      "enum": [
        "x",
        "y",
        "scale",
        "rotation",
        "opacity",
        "volume"
      ],
      "type": "string"
    }
  },
  "required": [
    "item_id",
    "property",
    "at"
  ],
  "type": "object"
}
