{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "index": {
      "description": "0-based index of the word.",
      "minimum": 0,
      "type": "integer"
    },
    "item_id": {
      "description": "A caption.",
      "type": "string"
    },
    "text": {
      "description": "The new text, 0 to 80 characters, no whitespace; empty removes.",
      "maxLength": 80,
      "minLength": 0,
      "type": "string"
    }
  },
  "required": [
    "item_id",
    "index",
    "text"
  ],
  "type": "object"
}
