{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "audio_muted": {
      "description": "Drop the audio of a clip.",
      "type": "boolean"
    },
    "fade_in": {
      "description": "Fade-in length; 0s removes it.",
      "type": "string"
    },
    "fade_out": {
      "description": "Fade-out length; 0s removes it.",
      "type": "string"
    },
    "item_id": {
      "description": "A clip or audio item.",
      "type": "string"
    },
    "volume": {
      "description": "Linear gain, 0 to 4.",
      "maximum": 4,
      "minimum": 0,
      "type": "number"
    }
  },
  "required": [
    "item_id"
  ],
  "type": "object"
}
