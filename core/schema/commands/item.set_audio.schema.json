{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "audio_muted": {
      "description": "Drop the audio of a clip.",
      "type": "boolean"
    },
    "denoise": {
      "description": "Noise reduction strength, 0 (off) to 1.",
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "fade_in": {
      "description": "Fade-in length; 0s removes it.",
      "type": "string",
      "x-vv-kind": "time"
    },
    "fade_out": {
      "description": "Fade-out length; 0s removes it.",
      "type": "string",
      "x-vv-kind": "time"
    },
    "item_id": {
      "description": "A clip or audio item.",
      "pattern": "^itm_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    },
    "voice": {
      "description": "Voice preset: none (default), clear, warm, deep, bright or radio.",
      "enum": [
        "none",
        "clear",
        "warm",
        "deep",
        "bright",
        "radio"
      ],
      "type": "string"
    },
    "volume": {
      "description": "Linear gain, 0 to 4.",
      "maximum": 4,
      "minimum": 0,
      "type": "number"
    }
  },
  "required": [
    "item_id"
  ],
  "type": "object"
}
