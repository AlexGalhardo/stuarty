{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "item_id": {
      "description": "The item to copy.",
      "pattern": "^itm_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    },
    "new_id": {
      "description": "The id of the copy.",
      "pattern": "^itm_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    },
    "start": {
      "description": "Absolute start of the copy; default the first free position after the source.",
      "type": "string",
      "x-vv-kind": "time"
    },
    "track_id": {
      "description": "The track of the copy; default the source's track.",
      "pattern": "^trk_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    }
  },
  "required": [
    "item_id"
  ],
  "type": "object"
}
