{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "item_id": {
      "description": "A clip or audio item; give this or track_id.",
      "pattern": "^itm_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    },
    "preset": {
      "description": "voice, voice_with_music, podcast or clean_noisy_room.",
      "enum": [
        "voice",
        "voice_with_music",
        "podcast",
        "clean_noisy_room"
      ],
      "type": "string"
    },
    "track_id": {
      "description": "A track; give this or item_id.",
      "pattern": "^trk_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    }
  },
  "required": [
    "preset"
  ],
  "type": "object"
}
