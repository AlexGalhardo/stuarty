{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "item_id": {
      "description": "A visual item.",
      "type": "string"
    },
    "mask": {
      "additionalProperties": false,
      "description": "The mask, or null to remove it.",
      "properties": {
        "feather": {
          "description": "Soft edge in pixels; default 0.",
          "maximum": 200,
          "minimum": 0,
          "type": "integer"
        },
        "height": {
          "description": "A fraction of the item height.",
          "maximum": 1,
          "minimum": 0.001,
          "type": "number"
        },
        "invert": {
          "description": "Keep the outside of the shape instead; default false.",
          "type": "boolean"
        },
        "shape": {
          "description": "rect or ellipse.",
          "enum": [
            "rect",
            "ellipse"
          ],
          "type": "string"
        },
        "width": {
          "description": "A fraction of the item width.",
          "maximum": 1,
          "minimum": 0.001,
          "type": "number"
        },
        "x": {
          "description": "Left edge, a fraction of the item width.",
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "y": {
          "description": "Top edge, a fraction of the item height.",
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "shape",
        "x",
        "y",
        "width",
        "height"
      ],
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "item_id",
    "mask"
  ],
  "type": "object"
}
