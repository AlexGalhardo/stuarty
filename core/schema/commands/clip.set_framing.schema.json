{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "crop": {
      "additionalProperties": false,
      "description": "Sides to crop, fractions 0 to 1; sides not given keep their value.",
      "properties": {
        "bottom": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "left": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "right": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "top": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [],
      "type": "object"
    },
    "fit": {
      "description": "cover (default), contain or none.",
      "enum": [
        "cover",
        "contain",
        "none"
      ],
      "type": "string"
    },
    "item_id": {
      "description": "A clip.",
      "pattern": "^itm_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    }
  },
  "required": [
    "item_id"
  ],
  "type": "object"
}
