{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "item_id": {
      "description": "A clip of a video asset with audio, or an audio item.",
      "pattern": "^itm_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    },
    "min_silence": {
      "description": "A length; shorter silences are ignored. Default \"0.4s\".",
      "type": "string",
      "x-vv-kind": "time"
    },
    "new_ids": {
      "description": "Ids for the second, third, ... pieces, in order.",
      "items": {
        "pattern": "^itm_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
        "type": "string"
      },
      "type": "array"
    },
    "padding": {
      "description": "A length, may be 0; speech kept around each cut. Default \"0.1s\".",
      "type": "string",
      "x-vv-kind": "time"
    },
    "resolved": {
      "additionalProperties": false,
      "description": "Filled by the service from the silence analysis of the asset; never sent by a caller.",
      "properties": {
        "silences": {
          "description": "Sorted, non-overlapping ranges in asset frames, half-open.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "end": {
                "type": "integer"
              },
              "start": {
                "type": "integer"
              }
            },
            "required": [
              "start",
              "end"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "silences"
      ],
      "type": "object"
    },
    "ripple": {
      "description": "track (default) or none.",
      "enum": [
        "track",
        "none"
      ],
      "type": "string"
    },
    "threshold_db": {
      "description": "Noise level of silence: -30, -35 (default), -40 or -45.",
      "type": "integer"
    }
  },
  "required": [
    "item_id"
  ],
  "type": "object"
}
