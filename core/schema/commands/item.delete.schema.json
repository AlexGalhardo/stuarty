{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "item_ids": {
      "items": {
        "pattern": "^itm_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
        "type": "string"
      },
      "maxItems": 200,
      "minItems": 1,
      "type": "array"
    },
    "ripple": {
      "description": "none (default), track or all.",
      "enum": [
        "none",
        "track",
        "all"
      ],
      "type": "string"
    }
  },
  "required": [
    "item_ids"
  ],
  "type": "object"
}
