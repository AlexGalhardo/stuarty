{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "item_id": {
      "description": "A clip.",
      "type": "string"
    },
    "radius": {
      "description": "Blur radius in pixels, 0 to 100; 0 removes the blur.",
      "maximum": 100,
      "minimum": 0,
      "type": "number"
    }
  },
  "required": [
    "item_id",
    "radius"
  ],
  "type": "object"
}
