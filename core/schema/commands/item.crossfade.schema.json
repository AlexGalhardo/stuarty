{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "duration": {
      "description": "Length of the crossfade, at least 1 frame.",
      "type": "string",
      "x-vv-kind": "time"
    },
    "from_item_id": {
      "description": "The item that leaves.",
      "type": "string"
    },
    "to_item_id": {
      "description": "The item that arrives.",
      "type": "string"
    },
    "track_id": {
      "description": "Only for two neighbours that touch on one track: another visual track the arriving item moves to.",
      "type": "string"
    }
  },
  "required": [
    "from_item_id",
    "to_item_id",
    "duration"
  ],
  "type": "object"
}
