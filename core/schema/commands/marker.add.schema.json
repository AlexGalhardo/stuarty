{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "at": {
      "description": "The position on the timeline.",
      "type": "string",
      "x-vv-kind": "time"
    },
    "item_id": {
      "description": "An item to mark instead of the timeline; at must then fall inside it.",
      "type": "string"
    },
    "label": {
      "description": "Up to 60 characters; default none.",
      "maxLength": 60,
      "type": "string"
    }
  },
  "required": [
    "at"
  ],
  "type": "object"
}
