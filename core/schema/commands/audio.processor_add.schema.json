              "max": 20,
              "min": 1,
              "name": "ratio",
              "unit": "ratio"
            }
          ]
        },
        {
          "kind": "noise_reduction",
          "params": [
            {
              "default": 0.5,
              "max": 1,
              "min": 0,
              "name": "strength",
              "unit": "fraction"
            },
            {
              "default": 0,
              "max": 3600000,
              "min": 0,
              "name": "profile_start_ms",
              "unit": "ms"
            },
            {
              "default": 0,
              "max": 3600000,
              "min": 0,
              "name": "profile_end_ms",
              "unit": "ms"
            }
          ]
        }
      ]
    },
    "track_id": {
      "description": "A track; give this or item_id.",
      "pattern": "^trk_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    }
  },
  "required": [
    "kind"
  ],
  "type": "object"
}
