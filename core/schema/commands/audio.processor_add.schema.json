            {
              "default": 6,
              "max": 24,
              "min": 0,
              "name": "knee_db",
              "unit": "dB"
            },
            {
              "default": 0,
              "max": 24,
              "min": -12,
              "name": "makeup_db",
              "unit": "dB"
            }
          ]
        },
        {
          "kind": "limiter",
          "params": [
            {
              "default": -1,
              "max": 0,
              "min": -20,
              "name": "ceiling_db",
              "unit": "dBFS"
            },
            {
              "default": 50,
              "max": 1000,
              "min": 1,
              "name": "release_ms",
              "unit": "ms"
            }
          ]
        },
        {
          "kind": "gate",
          "params": [
            {
              "default": -50,
              "max": 0,
              "min": -80,
              "name": "threshold_db",
              "unit": "dBFS"
            },
            {
              "default": -40,
              "max": 0,
              "min": -80,
              "name": "range_db",
              "unit": "dB"
            },
            {
              "default": 2,
              "max": 100,
              "min": 0.1,
              "name": "attack_ms",
              "unit": "ms"
            },
            {
              "default": 50,
              "max": 1000,
              "min": 0,
              "name": "hold_ms",
              "unit": "ms"
            },
            {
              "default": 150,
              "max": 2000,
              "min": 5,
              "name": "release_ms",
              "unit": "ms"
            }
          ]
        },
        {
          "kind": "deesser",
          "params": [
            {
              "default": 6500,
              "max": 12000,
              "min": 2000,
              "name": "frequency_hz",
              "unit": "Hz"
            },
            {
              "default": -30,
              "max": 0,
              "min": -60,
              "name": "threshold_db",
              "unit": "dBFS"
            },
            {
