{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "description": "false adds it switched off; default true.",
      "type": "boolean"
    },
    "index": {
      "description": "Where to insert, 0 to the length of the chain; default the end.",
      "minimum": 0,
      "type": "integer"
    },
    "item_id": {
      "description": "A clip or audio item; give this or track_id.",
      "pattern": "^itm_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    },
    "kind": {
      "description": "eq, compressor, limiter, gate, deesser or noise_reduction.",
      "enum": [
        "eq",
        "compressor",
        "limiter",
        "gate",
        "deesser",
        "noise_reduction"
      ],
      "type": "string"
    },
    "params": {
      "additionalProperties": {
        "type": "number"
      },
      "description": "Parameter values by name; the rest keep their default.",
      "type": "object",
      "x-vv-max-processors": 12,
      "x-vv-processors": [
        {
          "kind": "eq",
          "params": [
            {
              "default": 0,
              "max": 1000,
              "min": 0,
              "min_on": 20,
              "name": "hp_hz",
              "off_zero": true,
              "unit": "Hz"
            },
            {
              "default": 0,
              "max": 20000,
              "min": 0,
              "min_on": 1000,
              "name": "lp_hz",
              "off_zero": true,
              "unit": "Hz"
            },
            {
              "default": 100,
              "max": 20000,
              "min": 20,
              "name": "b1_hz",
              "unit": "Hz"
            },
            {
              "default": 0,
              "max": 24,
              "min": -24,
              "name": "b1_gain_db",
              "unit": "dB"
            },
            {
              "default": 1,
              "max": 18,
              "min": 0.1,
              "name": "b1_q",
              "unit": "Q"
            },
            {
              "default": 250,
              "max": 20000,
              "min": 20,
              "name": "b2_hz",
              "unit": "Hz"
            },
            {
              "default": 0,
              "max": 24,
              "min": -24,
              "name": "b2_gain_db",
              "unit": "dB"
            },
            {
              "default": 1,
              "max": 18,
              "min": 0.1,
              "name": "b2_q",
              "unit": "Q"
            },
            {
              "default": 1000,
              "max": 20000,
              "min": 20,
              "name": "b3_hz",
              "unit": "Hz"
            },
            {
              "default": 0,
              "max": 24,
              "min": -24,
              "name": "b3_gain_db",
              "unit": "dB"
            },
            {
              "default": 1,
              "max": 18,
              "min": 0.1,
              "name": "b3_q",
              "unit": "Q"
            },
            {
              "default": 3000,
              "max": 20000,
              "min": 20,
              "name": "b4_hz",
              "unit": "Hz"
            },
            {
              "default": 0,
              "max": 24,
              "min": -24,
              "name": "b4_gain_db",
              "unit": "dB"
            },
            {
              "default": 1,
              "max": 18,
              "min": 0.1,
              "name": "b4_q",
              "unit": "Q"
            },
            {
              "default": 6000,
              "max": 20000,
              "min": 20,
              "name": "b5_hz",
              "unit": "Hz"
            },
            {
              "default": 0,
              "max": 24,
              "min": -24,
              "name": "b5_gain_db",
              "unit": "dB"
            },
            {
              "default": 1,
              "max": 18,
              "min": 0.1,
              "name": "b5_q",
              "unit": "Q"
            },
            {
              "default": 10000,
              "max": 20000,
              "min": 20,
              "name": "b6_hz",
              "unit": "Hz"
            },
            {
              "default": 0,
              "max": 24,
              "min": -24,
              "name": "b6_gain_db",
              "unit": "dB"
            },
            {
              "default": 1,
              "max": 18,
              "min": 0.1,
              "name": "b6_q",
              "unit": "Q"
            }
          ]
        },
        {
          "kind": "compressor",
          "params": [
            {
              "default": -18,
              "max": 0,
              "min": -60,
              "name": "threshold_db",
              "unit": "dBFS"
            },
            {
              "default": 3,
              "max": 20,
              "min": 1,
              "name": "ratio",
              "unit": "ratio"
            },
            {
              "default": 10,
              "max": 200,
