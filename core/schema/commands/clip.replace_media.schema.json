{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "description": "A video or image asset of the document, of the same kind as the clip's asset.",
      "pattern": "^ast_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    },
    "item_id": {
      "description": "A clip.",
      "pattern": "^itm_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    }
  },
  "required": [
    "item_id",
    "asset_id"
  ],
  "type": "object"
}
