{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "camera_item_id": {
      "description": "The clip of the webcam take; required by every layout but screen_only, which refuses it.",
      "pattern": "^itm_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    },
    "camera_shape": {
      "description": "For pip. circle (default) or rect.",
      "enum": [
        "circle",
        "rect"
      ],
      "type": "string"
    },
    "corner": {
      "description": "For pip and camera_focus. Default bottom_right.",
      "enum": [
        "top_left",
        "top_right",
        "bottom_left",
        "bottom_right"
      ],
      "type": "string"
    },
    "layout": {
      "description": "screen_only, pip, split or camera_focus.",
      "enum": [
        "screen_only",
        "pip",
        "split",
        "camera_focus"
      ],
      "type": "string"
    },
    "padding": {
      "description": "Fraction of the shorter side of the frame left empty around everything, 0 to 0.25. Default 0.",
      "maximum": 0.25,
      "minimum": 0,
      "type": "number"
    },
    "screen_item_id": {
      "description": "The clip of the screen take.",
      "pattern": "^itm_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    }
  },
  "required": [
    "layout",
    "screen_item_id"
  ],
  "type": "object"
}
