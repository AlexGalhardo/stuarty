{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "description": "An audio asset, a video asset with audio, or ast_placeholder in a template.",
      "pattern": "^ast_([0123456789abcdefghjkmnpqrstvwxyz]{10}|placeholder)$",
      "type": "string"
    },
    "duration": {
      "description": "A length; default the rest of the asset.",
      "type": "string",
      "x-vv-kind": "time"
    },
    "id": {
      "pattern": "^itm_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    },
    "source_in": {
      "description": "Offset into the asset; default 0s.",
      "type": "string",
      "x-vv-kind": "time"
    },
    "start": {
      "description": "Absolute position; omitted, the end of the last item of the track (0s on an empty track).",
      "type": "string",
      "x-vv-kind": "time"
    },
    "track_id": {
      "description": "An audio track.",
      "pattern": "^trk_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    }
  },
  "required": [
    "track_id",
    "asset_id"
  ],
  "type": "object"
}
