{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "format": {
      "description": "srt or vtt; default: vtt when the text starts with WEBVTT.",
      "enum": [
        "srt",
        "vtt"
      ],
      "type": "string"
    },
    "new_ids": {
      "description": "Ids for the created captions, in cue order.",
      "items": {
        "pattern": "^itm_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
        "type": "string"
      },
      "type": "array"
    },
    "start": {
      "description": "A length added to every cue; default 0.",
      "type": "string",
      "x-vv-kind": "time"
    },
    "text": {
      "description": "The SRT or WebVTT text.",
      "type": "string"
    },
    "track_id": {
      "description": "A visual track that receives the captions.",
      "pattern": "^trk_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    }
  },
  "required": [
    "track_id",
    "text"
  ],
  "type": "object"
}
