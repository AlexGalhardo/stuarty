{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asset": {
      "additionalProperties": false,
      "description": "An Asset object of SDD-001 section 3.2.",
      "properties": {
        "frame_count": {
          "minimum": 1,
          "type": "integer"
        },
        "frame_delays": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "frame_rate": {
          "additionalProperties": false,
          "properties": {
            "den": {
              "minimum": 1,
              "type": "integer"
            },
            "num": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "num",
            "den"
          ],
          "type": "object"
        },
        "has_alpha": {
          "type": "boolean"
        },
        "has_audio": {
          "type": "boolean"
        },
        "hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "height": {
          "minimum": 1,
          "type": "integer"
        },
        "id": {
          "pattern": "^ast_[0-9a-hjkmnp-tv-z]{10}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "video",
            "audio",
            "image",
            "lut"
          ],
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sample_count": {
          "minimum": 1,
          "type": "integer"
        },
        "width": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "hash",
        "kind",
        "name"
      ],
      "type": "object"
    }
  },
  "required": [
    "asset"
  ],
  "type": "object"
}
