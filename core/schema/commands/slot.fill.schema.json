{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "description": "For a media slot.",
      "pattern": "^ast_([0123456789abcdefghjkmnpqrstvwxyz]{10}|placeholder)$",
      "type": "string"
    },
    "name": {
      "description": "The slot name.",
      "type": "string"
    },
    "source_in": {
      "description": "With asset_id only. Default \"0s\".",
      "type": "string",
      "x-vv-kind": "time"
    },
    "text": {
      "description": "For a text slot.",
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
    },
    "words": {
      "description": "For a caption slot: words with times relative to the caption, as lengths.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "duration": {
            "description": "a time with a unit: \"12.5s\", \"375f\" or \"00:00:12.500\"",
            "type": "string",
            "x-vv-kind": "time"
          },
          "start": {
            "description": "a time with a unit: \"12.5s\", \"375f\" or \"00:00:12.500\"",
            "type": "string",
            "x-vv-kind": "time"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text",
          "start",
          "duration"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "name"
  ],
  "type": "object"
}
