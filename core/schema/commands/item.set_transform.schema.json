{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "item_id": {
      "description": "A clip, text, caption or shape item.",
      "pattern": "^itm_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    },
    "opacity": {
      "description": "0 to 1.",
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "rotation": {
      "description": "Degrees clockwise.",
      "type": "number"
    },
    "scale": {
      "description": "Uniform scale, greater than 0 and at most 20.",
      "maximum": 20,
      "type": "number"
    },
    "x": {
      "description": "Centre of the item in pixels.",
      "type": "number"
    },
    "y": {
      "description": "Centre of the item in pixels.",
      "type": "number"
    }
  },
  "required": [
    "item_id"
  ],
  "type": "object"
}
