{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "item_id": {
      "pattern": "^itm_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    },
    "property": {
      "description": "One property; default every animated property.",
      "enum": [
        "x",
        "y",
        "scale",
        "rotation",
        "opacity",
        "volume",
        "brightness",
        "contrast",
        "saturation",
        "temperature",
        "tint",
        "hue",
        "mask_x",
        "mask_y",
        "mask_width",
        "mask_height",
        "mask_feather",
        "crop_left",
        "crop_top",
        "crop_right",
        "crop_bottom"
      ],
      "type": "string"
    }
  },
  "required": [
    "item_id"
  ],
  "type": "object"
}
