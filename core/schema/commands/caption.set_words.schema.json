{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "duration": {
      "description": "A length, at least the end of the last word. Default: that end.",
      "type": "string"
    },
    "item_id": {
      "description": "A caption.",
      "type": "string"
    },
    "words": {
      "description": "1 to 60 words with times relative to the caption, as lengths.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "duration": {
            "description": "a time with a unit: \"12.5s\", \"375f\" or \"00:00:12.500\"",
            "type": "string"
          },
          "start": {
            "description": "a time with a unit: \"12.5s\", \"375f\" or \"00:00:12.500\"",
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text",
          "start",
          "duration"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "item_id",
    "words"
  ],
  "type": "object"
}
