{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "curve": {
      "description": "Speed ramp: 2 to 8 points, linear between them, first t 0 and last t 1. Not with speed.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "speed": {
            "description": "Text like \"0.5x\" (up to 3 decimals, 1/4 to 4), never a bare number.",
            "oneOf": [
              {
                "examples": [
                  "1.5x"
                ],
                "pattern": "^([0-9]+\\.?[0-9]{0,3}|\\.[0-9]{1,3})x$",
                "type": "string"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "den": {
                    "minimum": 1,
                    "type": "integer"
                  },
                  "num": {
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "num",
                  "den"
                ],
                "type": "object"
              }
            ]
          },
          "t": {
            "description": "Position in the item, 0 to 1, up to 3 decimals.",
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "t",
          "speed"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "item_id": {
      "description": "A clip of a video asset, or an audio item.",
      "pattern": "^itm_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    },
    "reverse": {
      "description": "true plays the source range backwards; false plays it forwards.",
      "type": "boolean"
    },
    "ripple": {
      "description": "none (default) or track: shift the later items of the track.",
      "enum": [
        "none",
        "track"
      ],
      "type": "string"
    },
    "speed": {
      "description": "\"1.5x\" (up to 3 decimals) or {\"num\": 3, \"den\": 2}; 1/4 to 4. Not with curve.",
      "oneOf": [
        {
          "examples": [
            "1.5x"
          ],
          "pattern": "^([0-9]+\\.?[0-9]{0,3}|\\.[0-9]{1,3})x$",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "den": {
              "minimum": 1,
              "type": "integer"
            },
            "num": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "num",
            "den"
          ],
          "type": "object"
        }
      ]
    }
  },
  "required": [
    "item_id"
  ],
  "type": "object"
}
