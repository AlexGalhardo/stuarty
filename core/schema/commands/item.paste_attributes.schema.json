{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attributes": {
      "description": "Groups to copy: color, filter, blur, framing, transform, blend, mask, flip, chroma_key, effects, audio. At least one, each once.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "from_item_id": {
      "description": "The item to copy from.",
      "pattern": "^itm_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    },
    "item_ids": {
      "description": "The items to copy to, 1 to 20.",
      "items": {
        "pattern": "^itm_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "from_item_id",
    "item_ids",
    "attributes"
  ],
  "type": "object"
}
