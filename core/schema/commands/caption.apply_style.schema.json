{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "reset_overrides": {
      "description": "true clears the style override of the captions of the track.",
      "type": "boolean"
    },
    "style": {
      "description": "The style id; caption.list_styles describes them.",
      "enum": [
        "clean_white",
        "bold_pop",
        "marker_yellow",
        "soft_box",
        "neon_night",
        "editorial",
        "mono_code",
        "karaoke_pill",
        "thick_outline",
        "warm_glow",
        "lower_bar",
        "big_center",
        "top_headline",
        "ink_paper"
      ],
      "type": "string",
      "x-vv-caption-styles": [
        {
          "caption_style": {
            "align": "center",
            "color": "#FFFFFF",
            "font_family": "Inter",
            "font_weight": 700,
            "highlight": "word",
            "highlight_color": "#FFD23F",
            "position": "bottom",
            "shadow_blur": 8,
            "shadow_color": "#000000B3",
            "shadow_dx": 0,
            "shadow_dy": 3,
            "size": 72,
            "stroke_color": "#000000",
            "stroke_width": 3
          },
          "font_family": "Inter",
          "id": "clean_white",
          "name": "Clean white",
          "summary": "White bold text with a thin edge and a soft shadow."
        },
        {
          "caption_style": {
            "align": "center",
            "color": "#FFFFFF",
            "font_family": "Anton",
            "font_weight": 400,
            "highlight": "word",
            "highlight_color": "#3DFF7A",
            "position": "bottom",
            "shadow_blur": 0,
            "shadow_color": "#00000099",
            "shadow_dx": 0,
            "shadow_dy": 4,
            "size": 92,
            "stroke_color": "#000000",
            "stroke_width": 8,
            "uppercase": true
          },
          "font_family": "Anton",
          "id": "bold_pop",
          "name": "Bold pop",
          "summary": "Tall condensed capitals with a heavy edge and a green spoken word."
        },
        {
          "caption_style": {
            "align": "center",
            "color": "#FFE600",
            "font_family": "Montserrat",
            "font_weight": 800,
            "highlight": "word",
            "highlight_color": "#FFFFFF",
            "line_height": 1.1,
            "position": "bottom",
            "size": 76,
            "stroke_color": "#000000",
            "stroke_width": 6
          },
          "font_family": "Montserrat",
          "id": "marker_yellow",
          "name": "Marker yellow",
          "summary": "Yellow text with a black edge, the spoken word turns white."
        },
        {
          "caption_style": {
            "align": "center",
            "background_color": "#111827CC",
            "background_padding": 22,
            "background_radius": 18,
            "color": "#FFFFFF",
            "font_family": "Inter",
            "font_weight": 600,
            "highlight": "word",
            "highlight_background": "#2563EB",
            "highlight_color": "#FFFFFF",
            "position": "bottom",
            "size": 64
          },
          "font_family": "Inter",
          "id": "soft_box",
          "name": "Soft box",
          "summary": "White text on a rounded dark box, the spoken word on blue."
        },
        {
          "caption_style": {
            "align": "center",
            "color": "#E8FFFF",
            "font_family": "Bebas Neue",
            "font_weight": 400,
            "highlight": "word",
            "highlight_color": "#FF4FD8",
            "position": "middle",
            "shadow_blur": 24,
            "shadow_color": "#00E5FF",
            "shadow_dx": 0,
            "shadow_dy": 0,
            "size": 96,
            "stroke_color": "#00131A",
            "stroke_width": 3,
            "uppercase": true
          },
          "font_family": "Bebas Neue",
          "id": "neon_night",
          "name": "Neon night",
          "summary": "Light capitals with a cyan glow, in the middle of the frame."
        },
        {
          "caption_style": {
            "align": "center",
            "color": "#FFF8E7",
            "font_family": "Playfair Display",
            "font_weight": 700,
            "highlight": "word",
            "highlight_color": "#F4B860",
            "line_height": 1.2,
            "position": "bottom",
            "shadow_blur": 10,
            "shadow_color": "#000000AA",
            "shadow_dx": 0,
            "shadow_dy": 2,
            "size": 70,
            "stroke_color": "#1A1206",
            "stroke_width": 2
          },
          "font_family": "Playfair Display",
          "id": "editorial",
          "name": "Editorial",
          "summary": "A serif face in warm white, like a magazine pull quote."
        },
        {
          "caption_style": {
            "align": "center",
            "background_color": "#0B0F14E6",
            "background_padding": 20,
            "background_radius": 8,
            "color": "#7CFFB2",
            "font_family": "JetBrains Mono",
            "font_weight": 700,
            "highlight": "word",
            "highlight_background": "#1F6F4A",
            "highlight_color": "#FFFFFF",
            "position": "bottom",
            "size": 56
          },
          "font_family": "JetBrains Mono",
          "id": "mono_code",
          "name": "Mono code",
          "summary": "Green monospaced text on a near-black box."
        },
        {
          "caption_style": {
            "align": "center",
            "color": "#FFFFFF",
            "font_family": "Montserrat",
            "font_weight": 700,
            "highlight": "word",
            "highlight_background": "#FFFFFF",
            "highlight_color": "#101010",
            "position": "bottom",
            "size": 66,
            "stroke_color": "#000000",
            "stroke_width": 4
          },
          "font_family": "Montserrat",
          "id": "karaoke_pill",
          "name": "Karaoke pill",
          "summary": "White text; the spoken word sits on a white pill."
        },
        {
          "caption_style": {
            "align": "center",
            "color": "#FFFFFF",
            "font_family": "Montserrat",
            "font_weight": 900,
            "highlight": "word",
            "highlight_color": "#FF5A36",
            "line_height": 1.05,
            "position": "bottom",
            "size": 80,
            "stroke_color": "#000000",
            "stroke_width": 14,
            "uppercase": true
          },
          "font_family": "Montserrat",
          "id": "thick_outline",
          "name": "Thick outline",
          "summary": "Very heavy capitals with a thick black outline."
        },
        {
          "caption_style": {
            "align": "center",
            "color": "#FFB347",
            "font_family": "Montserrat",
            "font_weight": 800,
            "highlight": "word",
            "highlight_color": "#FFFFFF",
            "position": "bottom",
            "shadow_blur": 22,
            "shadow_color": "#FF6A00B3",
            "shadow_dx": 0,
            "shadow_dy": 0,
            "size": 74,
            "stroke_color": "#3A1500",
            "stroke_width": 3
          },
          "font_family": "Montserrat",
          "id": "warm_glow",
          "name": "Warm glow",
          "summary": "Amber text with an orange glow."
        },
        {
          "caption_style": {
            "align": "left",
            "background_color": "#000000A6",
            "background_padding": 18,
            "background_radius": 0,
            "color": "#FFFFFF",
            "font_family": "Inter",
            "font_weight": 500,
            "highlight": "word",
            "highlight_color": "#7DD3FC",
            "max_width": 929,
            "position": "bottom",
            "size": 52
          },
          "font_family": "Inter",
          "id": "lower_bar",
          "name": "Lower bar",
          "summary": "Left-aligned text on a dark bar, calm and easy to read."
        },
        {
          "caption_style": {
            "align": "center",
            "color": "#FFFFFF",
            "font_family": "Anton",
            "font_weight": 400,
            "highlight": "word",
            "highlight_color": "#FFE600",
            "line_height": 0.95,
            "position": "middle",
            "size": 140,
            "stroke_color": "#000000",
            "stroke_width": 10,
            "uppercase": true
          },
          "font_family": "Anton",
          "id": "big_center",
          "name": "Big centre",
          "summary": "One huge capital line in the middle, for short punchy words."
        },
        {
          "caption_style": {
            "align": "center",
            "color": "#FFFFFF",
            "font_family": "Bebas Neue",
            "font_weight": 400,
            "highlight": "word",
            "highlight_color": "#FF3B30",
            "position": "top",
            "shadow_blur": 6,
            "shadow_color": "#000000CC",
            "shadow_dx": 0,
            "shadow_dy": 4,
            "size": 88,
            "stroke_color": "#000000",
            "stroke_width": 3,
            "uppercase": true
          },
          "font_family": "Bebas Neue",
          "id": "top_headline",
          "name": "Top headline",
          "summary": "Capitals at the top of the frame, like a headline."
        },
        {
          "caption_style": {
            "align": "center",
            "background_color": "#F6EFE0F2",
            "background_padding": 24,
            "background_radius": 12,
            "color": "#1B1B1B",
            "font_family": "Playfair Display",
            "font_weight": 700,
            "highlight": "word",
            "highlight_color": "#B3261E",
            "position": "bottom",
            "size": 64
          },
          "font_family": "Playfair Display",
          "id": "ink_paper",
          "name": "Ink on paper",
          "summary": "Dark serif text on a cream box."
        }
      ]
    },
    "track_id": {
      "description": "A visual track.",
      "pattern": "^trk_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    }
  },
  "required": [
    "track_id",
    "style"
  ],
  "type": "object"
}
