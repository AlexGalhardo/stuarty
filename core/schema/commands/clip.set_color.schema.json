{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "brightness": {
      "description": "-1 to 1; default 0.",
      "maximum": 1,
      "minimum": -1,
      "type": "number"
    },
    "contrast": {
      "description": "0 to 2; default 1.",
      "maximum": 2,
      "minimum": 0,
      "type": "number"
    },
    "curves": {
      "additionalProperties": false,
      "description": "Tone curves: master, red, green, blue.",
      "properties": {
        "blue": {
          "description": "As master, for the blue channel.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "x": {
                "description": "Input, 0 to 1.",
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "y": {
                "description": "Output, 0 to 1.",
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "green": {
          "description": "As master, for the green channel.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "x": {
                "description": "Input, 0 to 1.",
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "y": {
                "description": "Output, 0 to 1.",
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "master": {
          "description": "2 to 8 points, x strictly increasing; [] or the line (0,0)-(1,1) removes the curve.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "x": {
                "description": "Input, 0 to 1.",
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "y": {
                "description": "Output, 0 to 1.",
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "red": {
          "description": "As master, for the red channel.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "x": {
                "description": "Input, 0 to 1.",
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "y": {
                "description": "Output, 0 to 1.",
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    },
    "hsl": {
      "description": "Bands of colour ranges, up to 8; a given range replaces its band, a neutral band removes it.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "hue": {
            "description": "Shift of the hue, -1 to 1 (30 degrees each way); default 0.",
            "maximum": 1,
            "minimum": -1,
            "type": "number"
          },
          "lightness": {
            "description": "-1 to 1; default 0.",
            "maximum": 1,
            "minimum": -1,
            "type": "number"
          },
          "range": {
            "description": "The colour range.",
            "enum": [
              "red",
              "orange",
              "yellow",
              "green",
              "cyan",
              "blue",
              "purple",
              "magenta"
            ],
            "type": "string"
          },
          "saturation": {
            "description": "-1 to 1; default 0.",
            "maximum": 1,
            "minimum": -1,
            "type": "number"
          }
        },
        "required": [
          "range"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "hue": {
      "description": "-180 to 180 degrees; default 0.",
      "maximum": 180,
      "minimum": -180,
      "type": "number"
    },
    "item_id": {
      "description": "A clip.",
      "pattern": "^itm_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    },
    "lut_asset": {
      "description": "Id of a lut asset to grade the clip with.",
      "pattern": "^ast_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    },
    "lut_intensity": {
      "description": "0 to 1; default 1; 0 removes the lookup table.",
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "saturation": {
      "description": "0 to 2; default 1.",
      "maximum": 2,
      "minimum": 0,
      "type": "number"
    },
    "temperature": {
      "description": "-1 (cooler) to 1 (warmer); default 0.",
      "maximum": 1,
      "minimum": -1,
      "type": "number"
    },
    "tint": {
      "description": "-1 (greener) to 1 (more magenta); default 0.",
      "maximum": 1,
      "minimum": -1,
      "type": "number"
    },
    "wheels": {
      "additionalProperties": false,
      "description": "Colour wheels of shadows, midtones and highlights.",
      "properties": {
        "highlights": {
          "additionalProperties": false,
          "description": "As shadows.",
          "properties": {
            "amount": {
              "description": "Strength of the tint, 0 to 1; default 0.",
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "hue": {
              "description": "Direction of the tint in degrees, 0 red, 120 green, 240 blue; default 0.",
              "maximum": 360,
              "minimum": 0,
              "type": "number"
            },
            "luma": {
              "description": "Lifts or lowers the range, -1 to 1; default 0.",
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            }
          },
          "required": [],
          "type": "object"
        },
        "midtones": {
          "additionalProperties": false,
          "description": "As shadows.",
          "properties": {
            "amount": {
              "description": "Strength of the tint, 0 to 1; default 0.",
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "hue": {
              "description": "Direction of the tint in degrees, 0 red, 120 green, 240 blue; default 0.",
              "maximum": 360,
              "minimum": 0,
              "type": "number"
            },
            "luma": {
              "description": "Lifts or lowers the range, -1 to 1; default 0.",
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            }
          },
          "required": [],
          "type": "object"
        },
        "shadows": {
          "additionalProperties": false,
          "description": "Replaces the wheel; a neutral wheel (amount 0, luma 0) removes it.",
          "properties": {
            "amount": {
              "description": "Strength of the tint, 0 to 1; default 0.",
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "hue": {
              "description": "Direction of the tint in degrees, 0 red, 120 green, 240 blue; default 0.",
              "maximum": 360,
              "minimum": 0,
              "type": "number"
            },
            "luma": {
              "description": "Lifts or lowers the range, -1 to 1; default 0.",
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    }
  },
  "required": [
    "item_id"
  ],
  "type": "object"
}
