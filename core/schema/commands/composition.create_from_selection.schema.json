{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "The id of the composition item.",
      "pattern": "^itm_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    },
    "item_ids": {
      "description": "The items to move, each once.",
      "items": {
        "pattern": "^itm_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "name": {
      "description": "The name of the new timeline; default Composition.",
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
    },
    "timeline_id": {
      "description": "The id of the new timeline.",
      "pattern": "^prj_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    }
  },
  "required": [
    "item_ids"
  ],
  "type": "object"
}
