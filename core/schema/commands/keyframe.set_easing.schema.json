{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "at": {
      "description": "Position of an existing keyframe on the project timeline.",
      "type": "string",
      "x-vv-kind": "time"
    },
    "bezier": {
      "description": "x1, y1, x2, y2 of a cubic Bezier curve: x1 and x2 from 0 to 1, y1 and y2 from -2 to 3.",
      "items": {
        "type": "number"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "easing": {
      "description": "A named easing. Exactly one of easing, bezier and preset.",
      "enum": [
        "linear",
        "ease_in",
        "ease_out",
        "ease_in_out",
        "hold"
      ],
      "type": "string"
    },
    "item_id": {
      "pattern": "^itm_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    },
    "preset": {
      "description": "A named Bezier curve, stored as its four numbers.",
      "enum": [
        "in",
        "out",
        "in_out",
        "back",
        "overshoot"
      ],
      "type": "string"
    },
    "property": {
      "enum": [
        "x",
        "y",
        "scale",
        "rotation",
        "opacity",
        "volume",
        "brightness",
        "contrast",
        "saturation",
        "temperature",
        "tint",
        "hue",
        "mask_x",
        "mask_y",
        "mask_width",
        "mask_height",
        "mask_feather",
        "crop_left",
        "crop_top",
        "crop_right",
        "crop_bottom"
      ],
      "type": "string"
    }
  },
  "required": [
    "item_id",
    "property",
    "at"
  ],
  "type": "object"
}
