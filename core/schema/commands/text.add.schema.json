{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "duration": {
      "description": "A length of at least 1 frame.",
      "type": "string",
      "x-vv-kind": "time"
    },
    "id": {
      "pattern": "^itm_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    },
    "start": {
      "description": "a time with a unit: \"12.5s\", \"375f\" or \"00:00:12.500\"",
      "type": "string",
      "x-vv-kind": "time"
    },
    "style": {
      "additionalProperties": false,
      "description": "A partial TextStyle.",
      "properties": {
        "align": {
          "enum": [
            "left",
            "center",
            "right"
          ],
          "type": "string"
        },
        "background_color": {
          "description": "\"#RRGGBB\", \"#RRGGBBAA\" or \"$name\" of a template colour",
          "pattern": "(^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$)|(^\\$[a-z][a-z0-9_]{0,39}$)",
          "type": "string"
        },
        "background_padding": {
          "minimum": 0,
          "type": "number"
        },
        "background_radius": {
          "minimum": 0,
          "type": "number"
        },
        "color": {
          "description": "\"#RRGGBB\", \"#RRGGBBAA\" or \"$name\" of a template colour",
          "pattern": "(^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$)|(^\\$[a-z][a-z0-9_]{0,39}$)",
          "type": "string"
        },
        "font_family": {
          "minLength": 1,
          "type": "string"
        },
        "font_weight": {
          "maximum": 900,
          "minimum": 100,
          "multipleOf": 100,
          "type": "integer"
        },
        "line_height": {
          "maximum": 3,
          "minimum": 0.8,
          "type": "number"
        },
        "max_width": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "shadow_blur": {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        "shadow_color": {
          "description": "\"#RRGGBB\", \"#RRGGBBAA\" or \"$name\" of a template colour",
          "pattern": "(^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$)|(^\\$[a-z][a-z0-9_]{0,39}$)",
          "type": "string"
        },
        "shadow_dx": {
          "type": "number"
        },
        "shadow_dy": {
          "type": "number"
        },
        "size": {
          "maximum": 1000,
          "minimum": 8,
          "type": "number"
        },
        "stroke_color": {
          "description": "\"#RRGGBB\", \"#RRGGBBAA\" or \"$name\" of a template colour",
          "pattern": "(^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$)|(^\\$[a-z][a-z0-9_]{0,39}$)",
          "type": "string"
        },
        "stroke_width": {
          "maximum": 40,
          "minimum": 0,
          "type": "number"
        },
        "uppercase": {
          "type": "boolean"
        }
      },
      "required": [],
      "type": "object"
    },
    "text": {
      "description": "The text; line breaks are allowed.",
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
    },
    "track_id": {
      "description": "A visual track; omitted, the highest visual track free over the item (an empty track you made for video counts; pass track_id to keep it clear), or a new one on top. effective.track_id names it.",
      "pattern": "^trk_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    },
    "x": {
      "type": "number"
    },
    "y": {
      "type": "number"
    }
  },
  "required": [
    "start",
    "duration",
    "text"
  ],
  "type": "object"
}
