{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "horizontal": {
      "description": "Mirror left to right.",
      "type": "boolean"
    },
    "item_id": {
      "description": "A visual item.",
      "pattern": "^itm_[0123456789abcdefghjkmnpqrstvwxyz]{10}$",
      "type": "string"
    },
    "vertical": {
      "description": "Mirror top to bottom.",
      "type": "boolean"
    }
  },
  "required": [
    "item_id"
  ],
  "type": "object"
}
