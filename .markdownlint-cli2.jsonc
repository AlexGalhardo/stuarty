{
	"$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
	"config": {
		"default": true,
		// Headings and lists
		"MD003": { "style": "atx" },
		"MD004": { "style": "dash" },
		"MD007": { "indent": 2 },
		// Fences may hold hard tabs (.editorconfig uses tabs for Go, TOML, JSON, Dockerfile)
		"MD010": { "code_blocks": false },
		// Long lines are fine in prose and tables
		"MD013": false,
		// Examples keep the $ prompt
		"MD014": false,
		// Keep a Changelog repeats "### Added" under each release
		"MD024": { "siblings_only": true },
		// A numbered list continues its numbers after a code block or a table, and the text refers to items by number
		"MD029": false,
		// Bold labels such as Arguments are deliberate and not headings
		"MD036": false,
		// Significant spaces inside code spans (for example the prefix `### `)
		"MD038": false,
		"MD033": { "allowed_elements": ["details", "summary", "br", "img", "picture", "source", "a", "p", "kbd", "sup", "div", "h3", "span", "strong"] },
		// GitHub templates start with "##"
		"MD041": false,
		"MD046": { "style": "fenced" },
		// Table column alignment is not enforced
		"MD060": false
	},
	"globs": ["**/*.md"],
	"ignores": ["**/node_modules/**", "**/testdata/**", "site/out/**", "web/resources/public/**", "CREATE.md", ".claude/skills/**", "licenses/go-modules/**", "licenses/npm/**", "licenses/crates/**", "development/**", "qa-build/**", "web/test-results/**", "prompt-workers.md", "prompts-create-stuarty-icon.md", "TODO.md"]
}
